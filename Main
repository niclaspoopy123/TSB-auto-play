--// ================= SERVICES ================= //
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LogService = game:GetService("LogService")

--// ================= LOCAL PLAYER ================= //
local player = Players.LocalPlayer

--// ================= TRAINING MODE STATE ================= //
local TrainingMode = {
    enabled = false,
    trainingAgainstClone = false,
    cloneCharacter = nil,
}

--// ================= GUI CREATION ================= //
local function CreateTrainingGUI(char, rp)
    -- Create ScreenGui
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "TSB_AI_TrainingGUI"
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    -- Main Frame
    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 250, 0, 180)
    mainFrame.Position = UDim2.new(0.85, 0, 0.1, 0)
    mainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    mainFrame.BorderSizePixel = 2
    mainFrame.BorderColor3 = Color3.fromRGB(100, 100, 255)
    mainFrame.Parent = screenGui
    
    -- Title Label
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "TitleLabel"
    titleLabel.Size = UDim2.new(1, 0, 0, 35)
    titleLabel.Position = UDim2.new(0, 0, 0, 0)
    titleLabel.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
    titleLabel.BorderSizePixel = 0
    titleLabel.Text = "AI Training Mode"
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextSize = 18
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.Parent = mainFrame
    
    -- Training vs Clone Button
    local trainVsCloneButton = Instance.new("TextButton")
    trainVsCloneButton.Name = "TrainVsCloneButton"
    trainVsCloneButton.Size = UDim2.new(0.9, 0, 0, 40)
    trainVsCloneButton.Position = UDim2.new(0.05, 0, 0, 45)
    trainVsCloneButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    trainVsCloneButton.BorderSizePixel = 1
    trainVsCloneButton.BorderColor3 = Color3.fromRGB(100, 255, 100)
    trainVsCloneButton.Text = "Train vs AI Clone"
    trainVsCloneButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    trainVsCloneButton.TextSize = 16
    trainVsCloneButton.Font = Enum.Font.GothamBold
    trainVsCloneButton.Parent = mainFrame
    
    -- Train vs Players Button
    local trainVsPlayersButton = Instance.new("TextButton")
    trainVsPlayersButton.Name = "TrainVsPlayersButton"
    trainVsPlayersButton.Size = UDim2.new(0.9, 0, 0, 40)
    trainVsPlayersButton.Position = UDim2.new(0.05, 0, 0, 95)
    trainVsPlayersButton.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
    trainVsPlayersButton.BorderSizePixel = 1
    trainVsPlayersButton.BorderColor3 = Color3.fromRGB(100, 150, 255)
    trainVsPlayersButton.Text = "Train vs Players"
    trainVsPlayersButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    trainVsPlayersButton.TextSize = 16
    trainVsPlayersButton.Font = Enum.Font.GothamBold
    trainVsPlayersButton.Parent = mainFrame
    
    -- Stop Training Button
    local stopTrainingButton = Instance.new("TextButton")
    stopTrainingButton.Name = "StopTrainingButton"
    stopTrainingButton.Size = UDim2.new(0.9, 0, 0, 35)
    stopTrainingButton.Position = UDim2.new(0.05, 0, 0, 145)
    stopTrainingButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    stopTrainingButton.BorderSizePixel = 1
    stopTrainingButton.BorderColor3 = Color3.fromRGB(255, 100, 100)
    stopTrainingButton.Text = "Stop Training"
    stopTrainingButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    stopTrainingButton.TextSize = 16
    stopTrainingButton.Font = Enum.Font.GothamBold
    stopTrainingButton.Parent = mainFrame
    
    -- Add rounded corners
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = mainFrame
    
    for _, button in pairs({trainVsCloneButton, trainVsPlayersButton, stopTrainingButton}) do
        local buttonCorner = Instance.new("UICorner")
        buttonCorner.CornerRadius = UDim.new(0, 6)
        buttonCorner.Parent = button
    end
    
    -- Helper function to create clone (local to GUI)
    local function createCloneLocal()
        if TrainingMode.cloneCharacter then
            TrainingMode.cloneCharacter:Destroy()
        end
        
        local clone = Instance.new("Model")
        clone.Name = "AI_Clone_Dummy"
        
        local hrp = Instance.new("Part")
        hrp.Name = "HumanoidRootPart"
        hrp.Size = Vector3.new(2, 2, 1)
        hrp.Position = rp.Position + Vector3.new(10, 0, 10)
        hrp.Anchored = false
        hrp.CanCollide = true
        hrp.Parent = clone
        
        local head = Instance.new("Part")
        head.Name = "Head"
        head.Size = Vector3.new(2, 1, 1)
        head.Position = hrp.Position + Vector3.new(0, 1.5, 0)
        head.Anchored = false
        head.CanCollide = true
        head.Parent = clone
        
        local humanoid = Instance.new("Humanoid")
        humanoid.MaxHealth = 100
        humanoid.Health = 100
        humanoid.Parent = clone
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = hrp
        weld.Part1 = head
        weld.Parent = hrp
        
        clone.Parent = Workspace
        TrainingMode.cloneCharacter = clone
        
        print("AI Clone created for training")
        return clone
    end
    
    -- Button click handlers
    trainVsCloneButton.MouseButton1Click:Connect(function()
        TrainingMode.enabled = true
        TrainingMode.trainingAgainstClone = true
        createCloneLocal()
        print("Training mode enabled: AI vs AI Clone")
        trainVsCloneButton.Text = "Training vs Clone..."
        trainVsCloneButton.BackgroundColor3 = Color3.fromRGB(100, 200, 100)
    end)
    
    trainVsPlayersButton.MouseButton1Click:Connect(function()
        TrainingMode.enabled = true
        TrainingMode.trainingAgainstClone = false
        if TrainingMode.cloneCharacter then
            TrainingMode.cloneCharacter:Destroy()
            TrainingMode.cloneCharacter = nil
        end
        print("Training mode enabled: AI vs Players")
        trainVsPlayersButton.Text = "Training vs Players..."
        trainVsPlayersButton.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    end)
    
    stopTrainingButton.MouseButton1Click:Connect(function()
        TrainingMode.enabled = false
        TrainingMode.trainingAgainstClone = false
        if TrainingMode.cloneCharacter then
            TrainingMode.cloneCharacter:Destroy()
            TrainingMode.cloneCharacter = nil
        end
        print("Training mode stopped")
        trainVsCloneButton.Text = "Train vs AI Clone"
        trainVsCloneButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        trainVsPlayersButton.Text = "Train vs Players"
        trainVsPlayersButton.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
    end)
    
    screenGui.Parent = player:WaitForChild("PlayerGui")
    return screenGui
end

