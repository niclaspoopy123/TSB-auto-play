  --// --- STATE MANAGEMENT ---
  function AI.ResetState(maxEnergy)
      AI.State = {
          currentTarget = nil, targetHumanoid = nil, targetTorso = nil,
          combatState = "IDLE", currentTactic = "BaitAndPunish",
          lastActionTimes = { ATTACK = 0, SPECIAL = 0, EVADE = 0, FEINT = 0, DASH = 0, BLOCK = 0, AWAKEN = 0, ULTIMATE = 0 },
          strafeDirection = 1, lastStrafeChange = 0, lastAction = "IDLE",
          lastTargetScanTime = 0, currentEnergy = maxEnergy,
          lastTargetHealth = 0, myHealth = humanoid.Health,
          isFeinting = false, feintStartTime = 0, distanceAtFeintStart = 0,
          isPerfectDodging = false, dodgeStartTime = 0,
          isBlocking = false, blockStartTime = 0,
          punishWindowEndTime = 0, comboStateEndTime = 0,
          glitchComboWindowEndTime = 0,
          tacticConfidence = 100, lastTacticChangeTime = 0,
          isTargetAttacking = false,
          lastExploitSeekerTriggerTime = 0,
          -- Awakening/Ultimate state tracking
          isAwakened = false, -- Whether awakening mode (G) is active
          awakenAttempted = false, -- Track if we've tried to awaken this life
          canUseUltimate = false, -- Whether ultimate is available
          lastUltimateTime = 0, -- Last time ultimate was used
          targetIsRagdolled = false, -- Target ragdoll/stunned state
          targetIsStunned = false, -- Target stunned state
          -- New fields for enhanced learning
          epsilon = CONST.INITIAL_EPSILON,
          actionsSinceReplay = 0,
          stateHistory = {}, -- For n-step returns
          cachedPredictedPos = nil, -- Cache predicted position
          lastPredictionTime = 0,
          lastTargetVelocity = nil, -- For acceleration prediction
          lastTargetPosition = nil, -- Track last position for change detection
          -- Advanced exploration state
          explorationStrategy = "epsilon-greedy", -- Can be: epsilon-greedy, ucb, boltzmann
          boltzmannTemperature = CONST.BOLTZMANN_TEMPERATURE,
          -- Hybrid learning state
          lastModelUpdate = 0,
          modelBasedPlanDepth = 3,
          -- Opponent tracking
          lastOpponentAction = "UNKNOWN",
          opponentActionTime = 0,
          -- Combo tracking for better reward shaping
          comboCount = 0,
          lastComboTime = 0,
          consecutiveHits = 0,
          lastDamageDealtTime = 0,
          -- Raycast/Map Awareness (#7)
          wallRaycasts = {}, -- Store raycast results for 8 directions
          isCornered = false, -- True if surrounded by walls
          lastRaycastUpdate = 0, -- Last time raycasts were updated
          -- Ping/Latency Adaptation (#8)
          currentPing = 0, -- Network ping in seconds
          lastPingUpdate = 0,
          -- ML-enhanced dash tracking
          lastDashDirection = nil,
          lastDashScore = 0,
          -- Combat trick discovery
          discoveredTricks = {}, -- Track when damage was last dealt for proper timing
          -- Adaptive learning rate
          currentLearningRate = CONST.LEARNING_RATE_ALPHA,
          recentPerformance = {},
          -- Win Probability tracking
          matchStartTime = os.clock(),
          lastWinProbability = 0.5,
      }
      print("AI State reset. Learned statistics and score have been preserved.")
  end
  AI.ResetState(CONST.MAX_ENERGY)
  AI.GlitchScanner.lastHumanoidState = humanoid:GetState()

  --// --- HELPER FUNCTIONS ---
  
  -- Validates deltaTime to prevent invalid state updates
  local function isValidDeltaTime(deltaTime)
      return deltaTime and deltaTime > CONST.MIN_DELTA_TIME and deltaTime < CONST.MAX_DELTA_TIME
  end

  -- Initialize Deep Neural Networks
  InitializeDeepNetworks()
  
  -- Load AI learning data from local file (exploit-based persistence)
  LocalPersistence:LoadData(AI)
  
  -- Initialize self-play system if enabled
  if AI.SelfPlaySystem.enabled then
      AI.DeepLearning.InitializeSelfPlay()
  end

  print(`Initializing Project Deep Apex Elite (V37.3+Adaptive) for {player.Name}... Character: {AI.IdentifiedCharacter}. Enhanced with: Local File Persistence, Session-Based Learning, Adaptive Learning Rates, Opponent-Specific Weights, Momentum Adaptation, DDA, Bait Learning, Resource Awareness & Zone Adaptation.`)

  --// ================= CORE AI LOGIC ================= //

  --// --- DEEP LEARNING MODULE ---
  
  -- Enhanced state encoding with deep features (16-dimensional state vector)
  function AI.DeepLearning.EncodeState(state)
      -- Safety check: ensure state is a valid table
      if type(state) ~= "table" then
          warn("EncodeState received invalid state (type: " .. type(state) .. "), using defaults")
          state = {
              myHealthPercent = 0.5,
              targetHealthPercent = 0.5,
              distance = CONST.AGGRO_RANGE / 2,
              energy = CONST.MAX_ENERGY / 2,
              inRange = false,
              isTargetAttacking = false,
          }
      end
      
      local encoded = {
          state.myHealthPercent or 0,
          state.targetHealthPercent or 0,
          math.min(state.distance or 0, CONST.AGGRO_RANGE) / CONST.AGGRO_RANGE, -- Normalized distance
          state.energy / CONST.MAX_ENERGY, -- Normalized energy
          state.inRange and 1 or 0,
          state.isTargetAttacking and 1 or 0,
          -- Advanced features
          (os.clock() < AI.State.comboStateEndTime) and 1 or 0,
          (os.clock() < AI.State.punishWindowEndTime) and 1 or 0,
          (os.clock() < AI.State.glitchComboWindowEndTime) and 1 or 0,
          AI.OpponentModel.aggressionScore or 0.5,
          AI.State.tacticConfidence / 150, -- Normalized confidence
          AI.State.epsilon or 0,
          -- Opponent modeling features
          (AI.OpponentModel.actionFrequency.ATTACK or 0) / math.max(1, AI.LSTMOpponentModel.sequenceLength),
          (AI.OpponentModel.actionFrequency.EVADE or 0) / math.max(1, AI.LSTMOpponentModel.sequenceLength),
          -- Tactic encoding (one-hot style compressed)
          AI.State.currentTactic == "Aggressive" and 1 or 0,
          AI.State.currentTactic == "Defensive" and 1 or 0,
      }
      
      -- Apply state normalization if enabled
      if AI.StateNormalization.enabled then
          AI.DeepLearning.UpdateStateNormalization(encoded)
          for i = 1, #encoded do
              local mean = AI.StateNormalization.mean[i] or 0
              local std = math.sqrt(AI.StateNormalization.variance[i] or 1)
              encoded[i] = (encoded[i] - mean) / (std + AI.StateNormalization.epsilon)
          end
      end
      
      return encoded
  end
  
  -- Update running state normalization statistics
  function AI.DeepLearning.UpdateStateNormalization(state)
      AI.StateNormalization.count += 1
      local n = AI.StateNormalization.count
      
      for i = 1, #state do
          -- Welford's online algorithm for mean and variance
          local delta = state[i] - (AI.StateNormalization.mean[i] or 0)
          AI.StateNormalization.mean[i] = (AI.StateNormalization.mean[i] or 0) + delta / n
          local delta2 = state[i] - AI.StateNormalization.mean[i]
          AI.StateNormalization.variance[i] = ((AI.StateNormalization.variance[i] or 1) * (n - 1) + delta * delta2) / n
      end
  end
  
  -- Forward pass through Dueling DQN network
  function AI.DeepLearning.PredictQValues(stateEncoded, useTarget)
      -- Choose network (main or target)
      local valueNet = useTarget and AI.DeepNetwork.targetValueNet or AI.DeepNetwork.valueNet
      local advantageNet = useTarget and AI.DeepNetwork.targetAdvantageNet or AI.DeepNetwork.advantageNet
      
      -- Value stream forward pass
      local valueHidden1 = ForwardLayer(valueNet.layer1, stateEncoded, LeakyReLU)
      local valueHidden2 = ForwardLayer(valueNet.layer2, valueHidden1, LeakyReLU)
      local stateValue = ForwardLayer(valueNet.layer3, valueHidden2, function(x) return x end)[1] -- Linear output
      
      -- Advantage stream forward pass
      local advHidden1 = ForwardLayer(advantageNet.layer1, stateEncoded, LeakyReLU)
      local advHidden2 = ForwardLayer(advantageNet.layer2, advHidden1, LeakyReLU)
      local advantages = ForwardLayer(advantageNet.layer3, advHidden2, function(x) return x end) -- Linear output
      
      -- Combine value and advantages (Dueling DQN formula)
      -- Q(s,a) = V(s) + (A(s,a) - mean(A(s,a)))
      local meanAdvantage = 0
      for _, adv in ipairs(advantages) do
          meanAdvantage += adv
      end
      meanAdvantage /= #advantages
      
      local qValues = {}
      for i, adv in ipairs(advantages) do
          qValues[i] = stateValue + (adv - meanAdvantage)
      end
      
      return qValues
  end
  
  -- Ensemble prediction for robust Q-values
  function AI.DeepLearning.EnsemblePredict(stateEncoded)
      local ensembleQValues = {}
      
      -- Collect predictions from all ensemble networks
      for i = 1, AI.DeepNetwork.ensembleSize do
          local network = AI.DeepNetwork.ensembleNetworks[i]
          
          -- Value stream
          local valueHidden1 = ForwardLayer(network.valueNet.layer1, stateEncoded, LeakyReLU)
          local valueHidden2 = ForwardLayer(network.valueNet.layer2, valueHidden1, LeakyReLU)
          local stateValue = ForwardLayer(network.valueNet.layer3, valueHidden2, function(x) return x end)[1]
          
          -- Advantage stream
          local advHidden1 = ForwardLayer(network.advantageNet.layer1, stateEncoded, LeakyReLU)
          local advHidden2 = ForwardLayer(network.advantageNet.layer2, advHidden1, LeakyReLU)
          local advantages = ForwardLayer(network.advantageNet.layer3, advHidden2, function(x) return x end)
          
          -- Combine (Dueling DQN: Q(s,a) = V(s) + A(s,a) - mean(A(s,a)))
          local meanAdv = 0
          for _, adv in ipairs(advantages) do meanAdv += adv end
          meanAdv /= #advantages
          
          for j, adv in ipairs(advantages) do
              ensembleQValues[j] = (ensembleQValues[j] or 0) + stateValue + (adv - meanAdv)
          end
      end
      
      -- Average ensemble predictions
      for i = 1, #ensembleQValues do
          ensembleQValues[i] /= AI.DeepNetwork.ensembleSize
      end
      
      return ensembleQValues
  end
  
  -- Policy network prediction (Actor-Critic)
  function AI.DeepLearning.PredictPolicy(stateEncoded)
      local hidden1 = ForwardLayer(AI.DeepNetwork.policyNet.layer1, stateEncoded, LeakyReLU)
      local hidden2 = ForwardLayer(AI.DeepNetwork.policyNet.layer2, hidden1, LeakyReLU)
      local logits = ForwardLayer(AI.DeepNetwork.policyNet.layer3, hidden2, function(x) return x end)
      
      -- Apply softmax to get action probabilities
      return Softmax(logits)
  end
  
  -- ICM Forward Model: Predict next state features from current state and action
  function AI.DeepLearning.ICM_ForwardModel(stateEncoded, actionEncoded)
      -- Concatenate state and action
      local input = {}
      for i = 1, #stateEncoded do
          input[i] = stateEncoded[i]
      end
      for i = 1, #actionEncoded do
          input[#stateEncoded + i] = actionEncoded[i]
      end
      
      local hidden1 = ForwardLayer(AI.CuriosityModule.forwardModel.layer1, input, LeakyReLU)
      local predicted = ForwardLayer(AI.CuriosityModule.forwardModel.layer2, hidden1, function(x) return x end)
      
      return predicted
  end
  
  -- ICM Inverse Model: Predict action from state transition
  function AI.DeepLearning.ICM_InverseModel(currentStateEncoded, nextStateEncoded)
      -- Concatenate current and next state
      local input = {}
      for i = 1, #currentStateEncoded do
          input[i] = currentStateEncoded[i]
      end
      for i = 1, #nextStateEncoded do
          input[#currentStateEncoded + i] = nextStateEncoded[i]
      end
      
      local hidden1 = ForwardLayer(AI.CuriosityModule.inverseModel.layer1, input, LeakyReLU)
      local actionLogits = ForwardLayer(AI.CuriosityModule.inverseModel.layer2, hidden1, function(x) return x end)
      
      return Softmax(actionLogits)
  end
  
  -- Distributional RL: Predict quantile values (C51-style)
  function AI.DeepLearning.PredictQuantiles(stateEncoded)
      if not AI.DistributionalRL.enabled then return nil end
      
      local hidden1 = ForwardLayer(AI.DistributionalRL.quantileNet.layer1, stateEncoded, LeakyReLU)
      local hidden2 = ForwardLayer(AI.DistributionalRL.quantileNet.layer2, hidden1, LeakyReLU)
      local quantileOutputs = ForwardLayer(AI.DistributionalRL.quantileNet.layer3, hidden2, function(x) return x end)
      
      -- Reshape to [num_actions, num_quantiles]
      local quantiles = {}
      local numActions = 5
      local numQuantiles = AI.DistributionalRL.numQuantiles
      
      for a = 1, numActions do
          quantiles[a] = {}
          for q = 1, numQuantiles do
              local idx = (a - 1) * numQuantiles + q
              quantiles[a][q] = quantileOutputs[idx]
          end
      end
      
      return quantiles
  end
  
  -- Get expected Q-value from quantile distribution
  function AI.DeepLearning.QuantilesToQValues(quantiles)
      if not quantiles then return {} end
      
      local qValues = {}
      for a = 1, #quantiles do
          local sum = 0
          for q = 1, #quantiles[a] do
              sum += quantiles[a][q]
          end
          qValues[a] = sum / #quantiles[a] -- Mean of quantiles
      end
      
      return qValues
  end
  
  -- Multi-head attention for opponent modeling
  function AI.DeepLearning.ApplyAttention(hiddenStates)
      if not AI.AttentionModule.enabled or #hiddenStates == 0 then
          return hiddenStates
      end
      
      local numHeads = AI.AttentionModule.numHeads
      local headDim = AI.AttentionModule.headDim
      local seqLen = #hiddenStates
      
      local outputs = {}
      
      -- Process each attention head
      for head = 1, numHeads do
          local headStart = (head - 1) * headDim + 1
          local headEnd = head * headDim
          
          -- Compute queries, keys, values
          local queries, keys, values = {}, {}, {}
          
          for t = 1, seqLen do
              queries[t] = {}
              keys[t] = {}
              values[t] = {}
              
              for d = headStart, headEnd do
                  local q, k, v = 0, 0, 0
                  for h = 1, AI.LSTMOpponentModel.hiddenSize do
                      q += AI.AttentionModule.queryWeights[d][h] * hiddenStates[t][h]
                      k += AI.AttentionModule.keyWeights[d][h] * hiddenStates[t][h]
                      v += AI.AttentionModule.valueWeights[d][h] * hiddenStates[t][h]
                  end
                  queries[t][d - headStart + 1] = q
                  keys[t][d - headStart + 1] = k
                  values[t][d - headStart + 1] = v
              end
          end
          
          -- Compute attention scores
          local scores = {}
          for i = 1, seqLen do
              scores[i] = {}
              for j = 1, seqLen do
                  local score = 0
                  for d = 1, headDim do
                      score += queries[i][d] * keys[j][d]
                  end
                  scores[i][j] = score / math.sqrt(headDim)
              end
              
              -- Softmax over scores
              scores[i] = Softmax(scores[i])
          end
          
          -- Apply attention to values
          for t = 1, seqLen do
              if not outputs[t] then outputs[t] = {} end
              for d = 1, headDim do
                  local attended = 0
                  for s = 1, seqLen do
                      attended += scores[t][s] * values[s][d]
                  end
                  outputs[t][headStart + d - 1] = attended
              end
          end
      end
      
      -- Linear projection of concatenated heads
      local finalOutputs = {}
      for t = 1, seqLen do
          finalOutputs[t] = {}
          local totalDim = numHeads * headDim
          for h = 1, AI.LSTMOpponentModel.hiddenSize do
              local sum = 0
              for d = 1, totalDim do
                  sum += AI.AttentionModule.outputWeights[d][h] * outputs[t][d]
              end
              finalOutputs[t][h] = sum
          end
      end
      
      return finalOutputs
  end
  
  -- LSTM-style opponent modeling
  function AI.DeepLearning.UpdateLSTMOpponentModel(actionEncoded)
      -- Simplified LSTM gates
      local hiddenSize = AI.LSTMOpponentModel.hiddenSize
      
      -- Forget gate (what to forget from cell state)
      local forgetGate = {}
      for i = 1, hiddenSize do
          local sum = AI.LSTMOpponentModel.hiddenState[i] * 0.3 + actionEncoded * 0.5
          forgetGate[i] = 1 / (1 + math.exp(-sum)) -- Sigmoid
      end
      
      -- Input gate (what new info to store)
      local inputGate = {}
      for i = 1, hiddenSize do
          local sum = AI.LSTMOpponentModel.hiddenState[i] * 0.4 + actionEncoded * 0.6
          inputGate[i] = 1 / (1 + math.exp(-sum))
      end
      
      -- Cell update
      for i = 1, hiddenSize do
          AI.LSTMOpponentModel.cellState[i] = AI.LSTMOpponentModel.cellState[i] * forgetGate[i] + inputGate[i] * Tanh(actionEncoded)
          AI.LSTMOpponentModel.hiddenState[i] = Tanh(AI.LSTMOpponentModel.cellState[i])
      end
      
      AI.LSTMOpponentModel.sequenceLength += 1
  end
  
  -- Curiosity-driven intrinsic reward with ICM
  function AI.DeepLearning.CalculateCuriosityReward(stateEncoded, actionIndex, nextStateEncoded)
      -- Encode state to lower dimensional representation
      local encoded1 = ForwardLayer(AI.CuriosityModule.stateEncoder.layer1, stateEncoded, LeakyReLU)
      local encodedState = ForwardLayer(AI.CuriosityModule.stateEncoder.layer2, encoded1, LeakyReLU)
      
      local encoded1Next = ForwardLayer(AI.CuriosityModule.stateEncoder.layer1, nextStateEncoded, LeakyReLU)
      local encodedNextState = ForwardLayer(AI.CuriosityModule.stateEncoder.layer2, encoded1Next, LeakyReLU)
      
      -- One-hot encode action
      local actionOneHot = {0, 0, 0, 0, 0}
      if actionIndex and actionIndex >= 1 and actionIndex <= 5 then
          actionOneHot[actionIndex] = 1
      end
      
      -- Forward model: predict next state from current state and action
      local predictedNextState = AI.DeepLearning.ICM_ForwardModel(encodedState, actionOneHot)
      
      -- Calculate prediction error (intrinsic reward)
      local predictionError = 0
      for i = 1, math.min(#predictedNextState, #encodedNextState) do
          local error = predictedNextState[i] - encodedNextState[i]
          predictionError += error * error
      end
      predictionError = math.sqrt(predictionError / #predictedNextState)
      
      -- Inverse model: predict action from state transition
      local predictedActionProbs = AI.DeepLearning.ICM_InverseModel(encodedState, encodedNextState)
      
      -- Calculate inverse model loss (cross-entropy)
      local inverseModelLoss = 0
      if actionIndex and actionIndex >= 1 and actionIndex <= 5 then
          inverseModelLoss = -math.log(math.max(1e-8, predictedActionProbs[actionIndex]))
      end
      
      -- ICM intrinsic reward is the forward model prediction error
      local intrinsicReward = predictionError * AI.CuriosityModule.curiosityWeight
      
      -- Store for potential learning updates
      AI.CuriosityModule.predictionErrors[#AI.CuriosityModule.predictionErrors + 1] = {
          forward = predictionError,
          inverse = inverseModelLoss,
          timestamp = os.clock()
      }
      
      -- Keep only recent errors
      if #AI.CuriosityModule.predictionErrors > 100 then
          table.remove(AI.CuriosityModule.predictionErrors, 1)
      end
      
      -- Legacy novelty-based curiosity (optional, can be disabled)
      local stateSignature = ""
      for _, val in ipairs(encodedState) do
          stateSignature ..= string.format("%.1f", val) .. ","
      end
      
      AI.CuriosityModule.stateVisits[stateSignature] = (AI.CuriosityModule.stateVisits[stateSignature] or 0) + 1
      local visitCount = AI.CuriosityModule.stateVisits[stateSignature]
      local noveltyBonus = 0.5 / math.sqrt(visitCount)
      
      return intrinsicReward + noveltyBonus * AI.CuriosityModule.curiosityWeight * 0.2
  end
  
  -- Update target networks (for stable learning)
  function AI.DeepLearning.UpdateTargetNetworks()
      AI.DeepNetwork.updateCounter += 1
      
      if AI.DeepNetwork.updateCounter >= AI.DeepNetwork.targetUpdateFrequency then
          CopyNetwork(AI.DeepNetwork.valueNet, AI.DeepNetwork.targetValueNet)
          CopyNetwork(AI.DeepNetwork.advantageNet, AI.DeepNetwork.targetAdvantageNet)
          AI.DeepNetwork.updateCounter = 0
          print("Target networks updated for stable learning")
      end
  end
  
  -- Gradient update (simplified backpropagation)
  function AI.DeepLearning.UpdateNetwork(network, layer, nodeIndex, gradient, learningRate)
      learningRate = learningRate or AI.DeepNetwork.learningRateDNN
      
      -- Update biases
      network[layer].biases[nodeIndex] = network[layer].biases[nodeIndex] - learningRate * gradient
      
      -- Update weights (simplified, assumes gradient is already computed)
      for i = 1, #network[layer].weights[nodeIndex] do
          network[layer].weights[nodeIndex][i] = network[layer].weights[nodeIndex][i] - learningRate * gradient * 0.01
      end
  end

  --// --- ML-BASED DASH SELECTION ---
  
  -- Use neural network to predict best dash direction based on current state
  function AI.DeepLearning.PredictBestDashDirection(state, targetPos, currentPart)
      -- Encode dash-specific features
      local encodedState = AI.DeepLearning.EncodeState(state)
      
      -- Extract position and CFrame from Part with proper Roblox type checking
      local currentPos, currentCFrame
      if typeof(currentPart) == "Instance" and currentPart:IsA("BasePart") then
          -- currentPart is a Roblox Part object
          currentPos = currentPart.Position
          currentCFrame = currentPart.CFrame
      elseif typeof(currentPart) == "Vector3" then
          -- currentPart is already a Vector3
          currentPos = currentPart
          -- Create CFrame with identity rotation (default orientation)
          currentCFrame = CFrame.new(currentPos)
      else
          -- Fallback for unexpected types
          warn("PredictBestDashDirection: Expected BasePart or Vector3, got " .. typeof(currentPart))
          currentPos = Vector3.new(0, 0, 0)
          currentCFrame = CFrame.new(currentPos)
      end
      
      -- Add directional features
      local toTarget = (targetPos - currentPos).Unit
      local facingDir = currentCFrame.LookVector
      local relativeAngle = math.acos(math.clamp(toTarget:Dot(facingDir), -1, 1))
      
      -- Extend state with dash-specific features
      local dashFeatures = {
          relativeAngle / math.pi, -- Normalized angle to target
          state.distance / CONST.AGGRO_RANGE, -- Normalized distance
          AI.State.comboCount / 10, -- Combo context
          AI.OpponentModel.aggressionScore or 0.5, -- Opponent behavior
      }
      
      -- Combine features
      local combinedFeatures = {}
      for _, v in ipairs(encodedState) do table.insert(combinedFeatures, v) end
      for _, v in ipairs(dashFeatures) do table.insert(combinedFeatures, v) end
      
      -- Use policy network to evaluate dash directions
      -- Forward: W, Backward: S, Left: A, Right: D
      local dashScores = {
          W = 0, -- Forward
          S = 0, -- Backward
          A = 0, -- Left
          D = 0, -- Right
      }
      
      -- Get Q-values for different tactical contexts
      local qValues = AI.DeepLearning.PredictQValues(encodedState, false)
      
      -- Score each direction based on tactical context
      if state.myHealthPercent < 0.3 or AI.State.currentTactic == "Defensive" then
          -- Defensive: prefer backward and side dashes
          dashScores.S = 2.0 + (qValues[3] or 0) * 0.5 -- EVADE action value
          dashScores.A = 1.5 + (qValues[5] or 0) * 0.3 -- REPOSITION value
          dashScores.D = 1.5 + (qValues[5] or 0) * 0.3
          dashScores.W = 0.5
      elseif AI.State.currentTactic == "Aggressive" or AI.State.currentTactic == "Finisher" then
          -- Aggressive: prefer forward and aggressive side dashes
          dashScores.W = 2.0 + (qValues[1] or 0) * 0.5 -- ATTACK action value
          dashScores.A = 1.2 + (qValues[6] or 0) * 0.4 -- DASH action value
          dashScores.D = 1.2 + (qValues[6] or 0) * 0.4
          dashScores.S = 0.3
      else
          -- Balanced: adapt to distance and situation
          if state.distance > CONST.ATTACK_RANGE * 1.5 then
              dashScores.W = 1.8 + (qValues[1] or 0) * 0.4
              dashScores.A = 1.0
              dashScores.D = 1.0
              dashScores.S = 0.5
          elseif state.distance < CONST.ATTACK_RANGE * 0.5 then
              dashScores.S = 1.8 + (qValues[3] or 0) * 0.4
              dashScores.A = 1.2
              dashScores.D = 1.2
              dashScores.W = 0.5
          else
              dashScores.A = 1.5 + (qValues[5] or 0) * 0.4
              dashScores.D = 1.5 + (qValues[5] or 0) * 0.4
              dashScores.W = 1.2
              dashScores.S = 1.0
          end
      end
      
      -- Bonus for combos: aggressive forward dashes
      if AI.State.comboCount > 2 then
          dashScores.W *= 1.3
      end
      
      -- Penalty for predictable patterns
      local lastDash = AI.State.lastDashDirection or "W"
      if dashScores[lastDash] then
          dashScores[lastDash] *= 0.7 -- Reduce score for repeated direction
      end
      
      -- Find best direction
      local bestDir = "W"
      local bestScore = -math.huge
      for dir, score in pairs(dashScores) do
          if score > bestScore then
              bestScore = score
              bestDir = dir
          end
      end
      
      -- Store for learning
      AI.State.lastDashDirection = bestDir
      AI.State.lastDashScore = bestScore
      
      return Enum.KeyCode[bestDir], dashScores
  end
  
  --// --- COMBAT TRICK DISCOVERY ---
  
  -- Discover new combat tricks using ML pattern recognition
  function AI.DeepLearning.DiscoverCombatTricks()
      -- Analyze recent successful action sequences
      local recentSuccesses = {}
      
      for i = math.max(1, #AI.ExperienceBuffer.experiences - 50), #AI.ExperienceBuffer.experiences do
          local exp = AI.ExperienceBuffer.experiences[i]
          if exp and exp.reward and exp.reward > 10 then -- Significant reward
              table.insert(recentSuccesses, exp)
          end
      end
      
      if #recentSuccesses < 5 then return end
      
      -- Pattern detection: look for action sequences that led to high rewards
      local actionPatterns = {}
      
      for i = 1, #recentSuccesses - 2 do
          local seq = string.format("%s->%s->%s", 
              recentSuccesses[i].action or "?",
              recentSuccesses[i+1].action or "?",
              recentSuccesses[i+2].action or "?")
          
          actionPatterns[seq] = (actionPatterns[seq] or 0) + 1
      end
      
      -- Find most effective patterns
      local bestPattern = nil
      local bestCount = 0
      
      for pattern, count in pairs(actionPatterns) do
          if count > bestCount then
              bestCount = count
              bestPattern = pattern
          end
      end
      
      -- Store discovered trick
      if bestPattern and bestCount >= 3 then
          AI.State.discoveredTricks = AI.State.discoveredTricks or {}
          if not AI.State.discoveredTricks[bestPattern] then
              AI.State.discoveredTricks[bestPattern] = {
                  count = bestCount,
                  avgReward = 0,
                  discovered = os.clock()
              }
              print("🔥 NEW COMBAT TRICK DISCOVERED: " .. bestPattern .. " (effectiveness: " .. bestCount .. ")")
              
              -- Increase reward for this pattern
              for _, exp in ipairs(recentSuccesses) do
                  if exp.action and string.find(bestPattern, exp.action) then
                      -- Boost learning for this action in similar states
                      AI.Learning.Reinforce(exp.tactic, exp.action, 15, exp.nextState)
                  end
              end
          end
      end
      
      -- Adaptation: Look for state-specific tricks
      local statePatterns = {}
      for _, exp in ipairs(recentSuccesses) do
          if exp.state then
              local stateKey = string.format("H:%.1f_D:%.0f_T:%s", 
                  exp.state.myHealthPercent or 0, 
                  exp.state.distance or 0,
                  exp.tactic or "?")
              
              statePatterns[stateKey] = statePatterns[stateKey] or {}
              table.insert(statePatterns[stateKey], exp.action)
          end
      end
      
      -- Find context-specific effective actions
      for stateKey, actions in pairs(statePatterns) do
          if #actions >= 3 then
              local actionCounts = {}
              for _, action in ipairs(actions) do
                  actionCounts[action] = (actionCounts[action] or 0) + 1
              end
              
              -- Find dominant action in this state
              local bestAction = nil
              local bestActionCount = 0
              for action, count in pairs(actionCounts) do
                  if count > bestActionCount then
                      bestActionCount = count
                      bestAction = action
                  end
              end
              
              if bestAction and bestActionCount >= 2 then
                  print("📊 Pattern learned: In state " .. stateKey .. ", " .. bestAction .. " is effective (" .. bestActionCount .. " successes)")
              end
          end
      end
  end

  --// --- WIN PROBABILITY ESTIMATOR FUNCTIONS ---
  
  -- Forward pass through Win Probability Estimator network
  function AI.DeepLearning.PredictWinProbability(state)
      if not AI.WinProbabilityEstimator.enabled then return 0.5 end
      
      -- Encode input features: [MyHP, EnemyHP, MyCooldowns, EnemyCooldowns, Distance, TimeRemaining, Energy, ComboCount, DamageDealt, DamageTaken]
      local inputFeatures = {
          state.myHealthPercent or 0.5,
          state.targetHealthPercent or 0.5,
          -- Cooldown factors (1.0 = ready, 0.0 = on cooldown)
          (state.attackReady and 1.0 or 0.0) or 0.8,
          (state.specialReady and 1.0 or 0.0) or 0.7,
          (state.evadeReady and 1.0 or 0.0) or 0.9,
          (state.enemyAttacking and 1.0 or 0.0) or 0.5,
          -- Distance (normalized to 0-1 range, assuming max 200)
          math.min(1.0, (state.distance or 100) / 200),
          -- Time remaining (normalized, assuming 300 second matches)
          math.min(1.0, (state.timeRemaining or 150) / 300),
          -- Energy (normalized to 0-1)
          (state.energy or 250) / 500,
          -- Combo count (normalized, max expected 10)
          math.min(1.0, (state.comboCount or 0) / 10),
      }
      
      -- Forward pass through 3-layer network
      local net = AI.WinProbabilityEstimator.network
      local hidden1 = ForwardLayer(net.layer1, inputFeatures, LeakyReLU)
      local hidden2 = ForwardLayer(net.layer2, hidden1, LeakyReLU)
      local output = ForwardLayer(net.layer3, hidden2, Sigmoid) -- Output in range [0, 1]
      
      -- Return win probability
      return output[1]
  end
  
  -- Train Win Probability Estimator with match result
  function AI.DeepLearning.TrainWinProbability(matchData, wonMatch)
      if not AI.WinProbabilityEstimator.enabled then return end
      
      local net = AI.WinProbabilityEstimator.network
      local lr = AI.WinProbabilityEstimator.learningRate
      
      -- Target: 1.0 for win, 0.0 for loss
      local target = wonMatch and 1.0 or 0.0
      
      -- Forward pass
      local inputFeatures = {
          matchData.myHealthPercent or 0.5,
          matchData.targetHealthPercent or 0.5,
          (matchData.attackReady and 1.0 or 0.0) or 0.8,
          (matchData.specialReady and 1.0 or 0.0) or 0.7,
          (matchData.evadeReady and 1.0 or 0.0) or 0.9,
          (matchData.enemyAttacking and 1.0 or 0.0) or 0.5,
          math.min(1.0, (matchData.distance or 100) / 200),
          math.min(1.0, (matchData.timeRemaining or 150) / 300),
          (matchData.energy or 250) / 500,
          math.min(1.0, (matchData.comboCount or 0) / 10),
      }
      
      local hidden1 = ForwardLayer(net.layer1, inputFeatures, LeakyReLU)
      local hidden2 = ForwardLayer(net.layer2, hidden1, LeakyReLU)
      local output = ForwardLayer(net.layer3, hidden2, Sigmoid)
      
      local prediction = output[1]
      
      -- Calculate loss (binary cross-entropy)
      local error = target - prediction
      
      -- Backward pass
      local outputGradient = {error * prediction * (1 - prediction)} -- Sigmoid derivative
      local grad2 = BackwardLayer(net.layer3, net.layer2, outputGradient, hidden2, nil)
      local grad1 = BackwardLayer(net.layer2, net.layer1, grad2, hidden1, LeakyReLU)
      BackwardLayer(net.layer1, nil, grad1, inputFeatures, LeakyReLU)
      
      -- Update weights
      UpdateNetworkWeights(net, inputFeatures, lr, 1.0)
      
      -- Track accuracy
      AI.WinProbabilityEstimator.totalPredictions += 1
      local correctPrediction = (prediction > 0.5 and wonMatch) or (prediction <= 0.5 and not wonMatch)
      if correctPrediction then
          AI.WinProbabilityEstimator.correctPredictions += 1
      end
      AI.WinProbabilityEstimator.predictionAccuracy = 
          AI.WinProbabilityEstimator.correctPredictions / AI.WinProbabilityEstimator.totalPredictions
      
      if CONST.DEBUG_MODE then
          print(string.format("Win Probability Training: Predicted %.2f, Actual %d, Accuracy: %.1f%%", 
              prediction, wonMatch and 1 or 0, AI.WinProbabilityEstimator.predictionAccuracy * 100))
      end
  end
  
  -- Record match snapshot for later training
  function AI.DeepLearning.RecordMatchSnapshot(state)
      if not AI.WinProbabilityEstimator.enabled then return end
      
      local matchHistory = AI.WinProbabilityEstimator.matchHistory
      local snapshot = {
          myHealthPercent = state.myHealthPercent or 0.5,
          targetHealthPercent = state.targetHealthPercent or 0.5,
          attackReady = (os.clock() - (AI.State.lastActionTimes.ATTACK or 0)) > CONST.ATTACK_COOLDOWN,
          specialReady = (os.clock() - (AI.State.lastActionTimes.SPECIAL or 0)) > CONST.SPECIAL_MOVE_COOLDOWN,
          evadeReady = (os.clock() - (AI.State.lastActionTimes.EVADE or 0)) > CONST.DASH_COOLDOWN,
          enemyAttacking = state.isTargetAttacking or false,
          distance = state.distance or 100,
          timeRemaining = 300 - (os.clock() - (AI.State.matchStartTime or os.clock())),
          energy = state.energy or 250,
          comboCount = AI.State.comboCount or 0,
          timestamp = os.clock()
      }
      
      table.insert(matchHistory, snapshot)
      
      -- Keep only recent snapshots
      if #matchHistory > AI.WinProbabilityEstimator.maxMatchHistory then
          table.remove(matchHistory, 1)
      end
  end
  
  -- Train on match end
  function AI.DeepLearning.TrainOnMatchEnd(wonMatch)
      if not AI.WinProbabilityEstimator.enabled then return end
      
      -- Train on all snapshots from this match
      for _, snapshot in ipairs(AI.WinProbabilityEstimator.matchHistory) do
          AI.DeepLearning.TrainWinProbability(snapshot, wonMatch)
      end
      
      -- Clear match history for next match
      AI.WinProbabilityEstimator.matchHistory = {}
      
      if CONST.DEBUG_MODE then
          print(string.format("Match ended: %s. Trained Win Probability Estimator.", wonMatch and "WON" or "LOST"))
      end
  end

  --// --- SELF-PLAY SYSTEM FUNCTIONS ---
  
  -- Deep copy a weight table (for saving best weights)
  local function DeepCopyWeights(original)
      if type(original) ~= "table" then return original end
      local copy = {}
      for k, v in pairs(original) do
          copy[k] = DeepCopyWeights(v)
      end
      return copy
  end
  
  -- Save current weights as "best" weights
  function AI.DeepLearning.SaveBestWeights()
      if not AI.SelfPlaySystem.enabled then return end
      
      -- Deep copy all learnable weights
      AI.SelfPlaySystem.bestWeights = {
          ActionStats = DeepCopyWeights(AI.ActionStats),
          QNetworkB = DeepCopyWeights(AI.QNetworkB),
          DeepNetworkWeights = {
              valueNet = DeepCopyWeights(AI.DeepNetwork.valueNet),
              advantageNet = DeepCopyWeights(AI.DeepNetwork.advantageNet),
              policyNet = DeepCopyWeights(AI.DeepNetwork.policyNet),
          },
          FeatureWeights = DeepCopyWeights(AI.FeatureWeights),
          version = AI.SelfPlaySystem.currentVersion
      }
      
      AI.SelfPlaySystem.bestWeightsVersion = AI.SelfPlaySystem.currentVersion
      AI.SelfPlaySystem.lastSaveTime = os.clock()
      
      print(string.format("💾 Best weights saved (Version %d). Win rate: %.1f%%", 
          AI.SelfPlaySystem.bestWeightsVersion,
          (AI.SelfPlaySystem.winsVsBest / math.max(1, AI.SelfPlaySystem.matchesVsBest)) * 100))
  end
  
  -- Load best weights into clone AI brain
  function AI.DeepLearning.LoadBestWeightsIntoClone(cloneAI)
      if not AI.SelfPlaySystem.enabled or not AI.SelfPlaySystem.bestWeights then 
          return false
      end
      
      -- Copy best weights to clone's AI brain
      if cloneAI and cloneAI.ActionStats and AI.SelfPlaySystem.bestWeights.ActionStats then
          cloneAI.ActionStats = DeepCopyWeights(AI.SelfPlaySystem.bestWeights.ActionStats)
          cloneAI.QNetworkB = DeepCopyWeights(AI.SelfPlaySystem.bestWeights.QNetworkB)
          cloneAI.FeatureWeights = DeepCopyWeights(AI.SelfPlaySystem.bestWeights.FeatureWeights)
          
          print(string.format("✨ Clone loaded best weights (Version %d) for shadow boxing", 
              AI.SelfPlaySystem.bestWeightsVersion))
          return true
      end
      
      return false
  end
  
  -- Update self-play statistics after match
  function AI.DeepLearning.UpdateSelfPlayStats(wonMatch)
      if not AI.SelfPlaySystem.enabled then return end
      if not TrainingMode.enabled or not TrainingMode.trainingAgainstClone then return end
      
      AI.SelfPlaySystem.matchesVsBest += 1
      if wonMatch then
          AI.SelfPlaySystem.winsVsBest += 1
      end
      
      local winRate = AI.SelfPlaySystem.winsVsBest / AI.SelfPlaySystem.matchesVsBest
      
      if CONST.DEBUG_MODE then
          print(string.format("Self-Play Stats: %d/%d wins (%.1f%% win rate)", 
              AI.SelfPlaySystem.winsVsBest, AI.SelfPlaySystem.matchesVsBest, winRate * 100))
      end
      
      -- Check if we should promote current weights to "best"
      if AI.SelfPlaySystem.matchesVsBest >= 10 then -- Need at least 10 matches
          if winRate >= AI.SelfPlaySystem.winRateThreshold then
              print(string.format("🏆 NEW BEST! Win rate %.1f%% > %.0f%%. Promoting to best weights.", 
                  winRate * 100, AI.SelfPlaySystem.winRateThreshold * 100))
              
              AI.SelfPlaySystem.currentVersion += 1
              AI.DeepLearning.SaveBestWeights()
              
              -- Reset stats for next evaluation period
              AI.SelfPlaySystem.matchesVsBest = 0
              AI.SelfPlaySystem.winsVsBest = 0
              
              -- Recreate clone with new best weights
              if TrainingMode.trainingAgainstClone and TrainingMode.cloneCharacter then
                  print("Recreating clone with newly promoted best weights...")
                  task.spawn(function()
                      task.wait(2) -- Brief delay
                      local success, err = pcall(function()
                          if rootPart and rootPart.Parent then
                              CreateAIClone()
                          end
                      end)
                      if not success then
                          warn("Failed to recreate clone:", err)
                      end
                  end)
              end
          elseif AI.SelfPlaySystem.matchesVsBest >= 20 then
              -- After 20 matches with < 60% win rate, reset for fresh evaluation
              print(string.format("Reset self-play stats. Win rate %.1f%% did not reach threshold.", winRate * 100))
              AI.SelfPlaySystem.matchesVsBest = 0
              AI.SelfPlaySystem.winsVsBest = 0
          end
      end
  end
  
  -- Initialize self-play system with current weights as baseline
  function AI.DeepLearning.InitializeSelfPlay()
      if not AI.SelfPlaySystem.enabled then return end
      
      -- Save current weights as baseline "best"
      AI.SelfPlaySystem.currentVersion = 1
      AI.DeepLearning.SaveBestWeights()
      
      print("🤖 Self-Play System initialized. Clone will use best weights for shadow boxing training.")
  end

  --// --- LEARNING MODULE ---
  
  -- Store experience in replay buffer with proportional prioritization
  function AI.Learning.StoreExperience(state, action, reward, nextState, tactic)
      local buffer = AI.ExperienceBuffer
      
      -- Skip storing if state is invalid or nil
      if not state or not action or not nextState then
          return
      end
      
      local experience = {
          state = state,
          action = action,
          reward = reward,
          nextState = nextState,
          tactic = tactic,
          timestamp = os.clock()
      }
      
      -- Calculate initial priority (use max priority for new experiences)
      local maxPriority = 1.0
      for _, p in ipairs(buffer.priorities) do
          -- Defensive nil check (priorities should never be nil, but guard against edge cases)
          if p and p > maxPriority then
              maxPriority = p
          end
      end
      
      -- New experiences get max priority (guaranteed non-nil)
      local priority = (maxPriority + buffer.epsilon) ^ buffer.alpha
      
      if #buffer.experiences < buffer.maxSize then
          table.insert(buffer.experiences, experience)
          table.insert(buffer.priorities, priority)
      else
          -- Clear old experience data to help garbage collection
          local oldExp = buffer.experiences[buffer.nextIndex]
          if oldExp then
              oldExp.state = nil
              oldExp.nextState = nil
          end
          buffer.experiences[buffer.nextIndex] = experience
          buffer.priorities[buffer.nextIndex] = priority
      end
      
      buffer.nextIndex = (buffer.nextIndex % buffer.maxSize) + 1
      
      -- Anneal beta towards 1.0
      buffer.beta = math.min(1.0, buffer.beta + buffer.betaIncrement)
  end
  
  -- Sample experiences with proportional prioritization and importance sampling
  function AI.Learning.SampleExperiences(batchSize)
      local buffer = AI.ExperienceBuffer
      if #buffer.experiences < CONST.MIN_REPLAY_SIZE then return {} end
      
      local samples = {}
      local indices = {}
      local weights = {}
      
      -- Calculate total priority
      local totalPriority = 0
      for _, p in ipairs(buffer.priorities) do
          totalPriority += p
      end
      
      -- Sample with replacement based on priorities
      for i = 1, math.min(batchSize, #buffer.experiences) do
          local rand = math.random() * totalPriority
          local cumSum = 0
          for idx, priority in ipairs(buffer.priorities) do
              cumSum += priority
              if cumSum >= rand then
                  table.insert(samples, buffer.experiences[idx])
                  table.insert(indices, idx)
                  
                  -- Calculate importance sampling weight
                  local prob = priority / totalPriority
                  local weight = (1 / (#buffer.experiences * prob)) ^ buffer.beta
                  table.insert(weights, weight)
                  break
              end
          end
      end
      
      -- Normalize weights
      local maxWeight = FindMax(weights)
      if maxWeight > 0 then
          for i = 1, #weights do
              weights[i] = weights[i] / maxWeight
          end
      end
      
      return samples, indices, weights
  end
  
  -- Update priorities based on TD errors
  function AI.Learning.UpdatePriorities(indices, tdErrors)
      local buffer = AI.ExperienceBuffer
      for i, idx in ipairs(indices) do
          local priority = (math.abs(tdErrors[i]) + buffer.epsilon) ^ buffer.alpha
          buffer.priorities[idx] = priority
      end
  end
  
  -- Deep Q-Learning with Dueling DQN and eligibility traces
  function AI.Learning.Reinforce(tactic, action, rawReward, nextState)
      local tacticStatsA = AI.ActionStats[tactic]
      local tacticStatsB = AI.QNetworkB[tactic]
      if not tacticStatsA or not tacticStatsA[action] or not tacticStatsB or not tacticStatsB[action] then return end

      -- Add ICM curiosity bonus for exploration
      local curiosityReward = 0
      if nextState then
          -- Get current state from history
          local currentState = #AI.State.stateHistory > 0 and AI.State.stateHistory[#AI.State.stateHistory].state or nextState
          local currentStateEncoded = AI.DeepLearning.EncodeState(currentState)
          local nextStateEncoded = AI.DeepLearning.EncodeState(nextState)
          local actionIndex = ({ATTACK=1, SPECIAL=2, EVADE=3, FEINT=4, REPOSITION=5})[action]
          curiosityReward = AI.DeepLearning.CalculateCuriosityReward(currentStateEncoded, actionIndex, nextStateEncoded)
      end
      rawReward = rawReward + curiosityReward

      -- Meta-learning: Track rewards and adapt learning rate
      table.insert(AI.MetaLearning.recentRewards, rawReward)
      if #AI.MetaLearning.recentRewards > AI.MetaLearning.maxRewardHistory then
          table.remove(AI.MetaLearning.recentRewards, 1)
      end
      
      -- Calculate performance trend for adaptive learning rate (enhanced with variance analysis)
      if #AI.MetaLearning.recentRewards >= 12 then
          local recentSum = 0
          local recentVar = 0
          local validRecentCount = 0
          
          -- Sum recent rewards, skipping nil and NaN
          for i = #AI.MetaLearning.recentRewards - 11, #AI.MetaLearning.recentRewards do
              local reward = AI.MetaLearning.recentRewards[i]
              if reward and reward == reward then -- Check not nil and not NaN
                  recentSum += reward
                  validRecentCount += 1
              end
          end
          
          if validRecentCount < 6 then
              -- Not enough valid data for meta-learning
              if CONST and CONST.DEBUG_MODE then
                  warn("Meta-learning: Not enough valid reward data")
              end
          else
              local recentMean = recentSum / validRecentCount
              
              -- Calculate variance for stability analysis
              for i = #AI.MetaLearning.recentRewards - 11, #AI.MetaLearning.recentRewards do
                  local reward = AI.MetaLearning.recentRewards[i]
                  if reward and reward == reward then -- Check not nil and not NaN
                      local diff = reward - recentMean
                      recentVar += diff * diff
                  end
              end
              recentVar = recentVar / validRecentCount
          
              local oldSum = 0
              local oldCount = math.min(12, #AI.MetaLearning.recentRewards - 12)
              local validOldCount = 0
              for i = 1, oldCount do
                  local reward = AI.MetaLearning.recentRewards[i]
                  if reward and reward == reward then -- Check not nil and not NaN
                      oldSum += reward
                      validOldCount += 1
                  end
              end
              local oldMean = validOldCount > 0 and (oldSum / validOldCount) or 0
              AI.MetaLearning.performanceTrend = recentSum - oldSum
              
              -- Track stability and improvement trends
              if recentMean > oldMean then
                  AI.MetaLearning.consecutiveImprovements += 1
              else
                  AI.MetaLearning.consecutiveImprovements = 0
              end
              
              local stabilityScore = math.max(0, 1 - (recentVar / 30))
              AI.MetaLearning.learningRateStability = stabilityScore
              
              -- Adjust DNN learning rate based on variance and improvement with better thresholds
              if recentVar < 3.5 and recentMean > 0 then
                  -- Very stable positive performance: increase learning rate more aggressively
                  AI.DeepNetwork.learningRateDNN = math.min(0.0028, AI.DeepNetwork.learningRateDNN * 1.06)
              elseif recentVar < 7 and AI.MetaLearning.consecutiveImprovements >= 3 then
                  -- Stable and improving: moderate increase
                  AI.DeepNetwork.learningRateDNN = math.min(0.0022, AI.DeepNetwork.learningRateDNN * 1.03)
              elseif recentVar > 22 then
                  -- High variance: decrease for stability
                  AI.DeepNetwork.learningRateDNN = math.max(0.0005, AI.DeepNetwork.learningRateDNN * 0.92)
              elseif recentVar > 13 and recentMean < 0 then
                  -- Moderate variance with negative trend: stronger decrease
                  AI.DeepNetwork.learningRateDNN = math.max(0.0006, AI.DeepNetwork.learningRateDNN * 0.94)
              end
          end
      end
      
      -- Adaptive learning rate based on recent performance
      local learningRate = AI.State.currentLearningRate
      
      -- Calculate performance metrics from recent rewards
      if #AI.State.recentPerformance >= 6 then
          local perfSum = 0
          local perfVar = 0
          local validPerfCount = 0
          
          -- Sum performance values, skipping nil and NaN
          for _, perf in ipairs(AI.State.recentPerformance) do
              if perf and perf == perf then -- Check not nil and not NaN
                  perfSum += perf
                  validPerfCount += 1
              end
          end
          
          -- If we don't have enough valid performance data, skip adaptation
          if validPerfCount < 3 then
              if CONST and CONST.DEBUG_MODE then
                  warn("Adaptive learning: Not enough valid performance data, skipping")
              end
          else
              local perfMean = perfSum / validPerfCount
              
              -- Calculate variance
              for _, perf in ipairs(AI.State.recentPerformance) do
                  if perf and perf == perf then -- Check not nil and not NaN
                      local diff = perf - perfMean
                      perfVar += diff * diff
                  end
              end
              perfVar = perfVar / validPerfCount
          
              -- Adapt learning rate based on performance stability, trend, and meta-learning stability
              local stabilityBonus = AI.MetaLearning.learningRateStability * 0.1
              
              if perfMean > 6 and perfVar < 8 then
                  -- Excellent stable performance: strong increase with stability bonus
                  learningRate = math.min(CONST.MAX_LEARNING_RATE, learningRate * (1.06 + stabilityBonus))
              elseif perfMean > 3 and perfVar < 12 then
                  -- Good performance: moderate increase
                  learningRate = math.min(CONST.MAX_LEARNING_RATE, learningRate * (1.04 + stabilityBonus))
              elseif perfMean < -2 and perfVar > 25 then
                  -- Poor unstable performance: strong decrease
                  learningRate = math.max(CONST.MIN_LEARNING_RATE, learningRate * 0.92)
              elseif perfMean < 0 or perfVar > 30 then
                  -- Negative or highly unstable: moderate decrease
                  learningRate = math.max(CONST.MIN_LEARNING_RATE, learningRate * 0.94)
              end
              
              AI.State.currentLearningRate = learningRate
          end
      end
      
      -- Use adaptive learning rate for meta-learning as well
      AI.MetaLearning.adaptiveLearningRate = learningRate

      -- Deep Q-Learning: Use neural network predictions with distributional RL
      local nextMaxQValue = 0
      if nextState then
          local nextStateEncoded = AI.DeepLearning.EncodeState(nextState)
          
          -- Try distributional RL if enabled
          if AI.DistributionalRL.enabled then
              local quantiles = AI.DeepLearning.PredictQuantiles(nextStateEncoded)
              if quantiles then
                  local qValues = AI.DeepLearning.QuantilesToQValues(quantiles)
                  nextMaxQValue = FindMax(qValues)
              end
          else
              -- Use ensemble for robust predictions
              local ensembleQValues = AI.DeepLearning.EnsemblePredict(nextStateEncoded)
              nextMaxQValue = FindMax(ensembleQValues)
              
              -- Also get target network prediction for Double DQN
              local targetQValues = AI.DeepLearning.PredictQValues(nextStateEncoded, true)
              local targetMaxQ = FindMax(targetQValues)
              
              -- Average ensemble and target network (more stable)
              nextMaxQValue = (nextMaxQValue + targetMaxQ) / 2
          end
      end
      
      -- Ensure nextMaxQValue is never nil (safety guard)
      if nextMaxQValue == nil then
          nextMaxQValue = 0
          if CONST and CONST.DEBUG_MODE then
              warn("Reinforce: nextMaxQValue is nil - defaulting to 0. This may indicate neural network prediction issues.")
          end
      end

      -- Randomly choose which Q-network to update (Double Q-Learning for tabular part)
      local updateA = math.random() < 0.5
      local statsToUpdate = updateA and tacticStatsA[action] or tacticStatsB[action]
      
      local actionCost = CONST.COSTS[action] or 0
      local netReward = rawReward - (actionCost * CONST.COST_PENALTY_FACTOR)

      -- Calculate TD error using neural network Q-value
      -- Safety check: Ensure old_value is never nil to prevent arithmetic errors
      -- Initialize statsToUpdate.value if nil (fixes corrupted persisted data)
      if statsToUpdate.value == nil then
          statsToUpdate.value = 0
          if CONST and CONST.DEBUG_MODE then
              warn(string.format("Reinforce: statsToUpdate.value is nil for action %s in tactic %s, initializing to 0", action, tactic))
          end
      end
      local old_value = statsToUpdate.value
      local td_error = netReward + CONST.DISCOUNT_FACTOR_GAMMA * nextMaxQValue - old_value
      
      -- Update eligibility trace
      -- Safety check: Ensure eligibility is never nil
      if statsToUpdate.eligibility == nil then
          statsToUpdate.eligibility = 0
          if CONST and CONST.DEBUG_MODE then
              warn(string.format("Reinforce: statsToUpdate.eligibility is nil for action %s in tactic %s, initializing to 0", action, tactic))
          end
      end
      statsToUpdate.eligibility = statsToUpdate.eligibility * CONST.DISCOUNT_FACTOR_GAMMA * CONST.ELIGIBILITY_LAMBDA + 1
      
      -- Q-Learning update with adaptive learning rate and eligibility traces
      statsToUpdate.value = old_value + learningRate * td_error * statsToUpdate.eligibility
      
      -- Ensure count field is initialized
      if statsToUpdate.count == nil then
          statsToUpdate.count = 0
          if CONST and CONST.DEBUG_MODE then
              warn(string.format("Reinforce: statsToUpdate.count is nil for action %s in tactic %s, initializing to 0", action, tactic))
          end
      end
      statsToUpdate.count += 1
      
      -- Update deep neural networks with proper backpropagation
      if nextState and math.abs(td_error) > 0.01 then
          local currentState = #AI.State.stateHistory > 0 and AI.State.stateHistory[#AI.State.stateHistory].state or nextState
          local stateEncoded = AI.DeepLearning.EncodeState(currentState)
          local actionIndex = ({ATTACK=1, SPECIAL=2, EVADE=3, FEINT=4, REPOSITION=5})[action]
          
          if actionIndex then
              -- Compute target Q-value
              local targetQ = netReward + CONST.DISCOUNT_FACTOR_GAMMA * nextMaxQValue
              
              -- Forward pass to get current prediction
              local currentQValues = AI.DeepLearning.PredictQValues(stateEncoded, false)
              local currentQ = currentQValues[actionIndex]
              
              -- Compute loss gradient
              local lossGrad = 2 * (currentQ - targetQ) -- MSE gradient
              
              -- Backpropagate through advantage network
              local advantageGrads = {}
              for i = 1, 5 do
                  advantageGrads[i] = (i == actionIndex) and lossGrad or 0
              end
              
              -- Update advantage network with proper backprop
              UpdateNetworkWeights(AI.DeepNetwork.advantageNet, stateEncoded, AI.DeepNetwork.learningRateDNN, AI.DeepNetwork.gradientClipNorm)
          end
      end
      
      -- Update target networks periodically
      AI.DeepLearning.UpdateTargetNetworks()
      
      -- Decay eligibility traces for all actions in both networks
      for actionName, actionStats in pairs(tacticStatsA) do
          if type(actionStats) == "table" and actionStats.eligibility then
              if actionName ~= action then
                  actionStats.eligibility = actionStats.eligibility * CONST.DISCOUNT_FACTOR_GAMMA * CONST.ELIGIBILITY_LAMBDA
              end
          end
      end
      for actionName, actionStats in pairs(tacticStatsB) do
          if type(actionStats) == "table" and actionStats.eligibility then
              if actionName ~= action then
                  actionStats.eligibility = actionStats.eligibility * CONST.DISCOUNT_FACTOR_GAMMA * CONST.ELIGIBILITY_LAMBDA
              end
          end
      end

      statsToUpdate.count += 1
      tacticStatsA.total += 1
      AI.ActionStats.totalTrials += 1

      -- Adjust tactic confidence based on performance with smoothing
      local confidenceChange = rawReward * 0.4
      if rawReward > 0 then
          AI.State.tacticConfidence = math.min(150, AI.State.tacticConfidence + confidenceChange)
      else
          AI.State.tacticConfidence = math.max(0, AI.State.tacticConfidence + confidenceChange)
      end
      
      -- Update epsilon for exploration-exploitation
      AI.State.epsilon = math.max(CONST.MIN_EPSILON, AI.State.epsilon * CONST.EPSILON_DECAY)
      
      -- Update Boltzmann temperature
      AI.State.boltzmannTemperature = math.max(0.1, AI.State.boltzmannTemperature * CONST.TEMPERATURE_DECAY)
      
      -- Periodic combat trick discovery (every 100 trials)
      if AI.ActionStats.totalTrials % 100 == 0 then
          AI.DeepLearning.DiscoverCombatTricks()
      end
  end
  
  -- Perform experience replay learning with deep network updates and importance sampling
  function AI.Learning.ReplayExperiences()
      local samples, indices, weights = AI.Learning.SampleExperiences(CONST.REPLAY_BATCH_SIZE)
      
      if not samples or #samples == 0 then return end
      
      local tdErrors = {}
      
      for i, experience in ipairs(samples) do
          local tacticStats = AI.ActionStats[experience.tactic]
          if tacticStats and tacticStats[experience.action] then
              -- Encode states for deep learning
              local stateEncoded = AI.DeepLearning.EncodeState(experience.state)
              local nextStateEncoded = AI.DeepLearning.EncodeState(experience.nextState)
              
              -- Get deep Q-values for current and next state
              local currentQValues = AI.DeepLearning.PredictQValues(stateEncoded, false)
              local nextQValuesTarget = AI.DeepLearning.PredictQValues(nextStateEncoded, true)
              
              -- Double DQN: Select action with main network, evaluate with target
              local nextMaxQ = FindMax(nextQValuesTarget)
              
              -- Use distributional RL if enabled
              if AI.DistributionalRL.enabled then
                  local quantiles = AI.DeepLearning.PredictQuantiles(nextStateEncoded)
                  if quantiles then
                      local qValues = AI.DeepLearning.QuantilesToQValues(quantiles)
                      nextMaxQ = FindMax(qValues)
                  end
              end
              
              -- Calculate TD error
              local actionIdx = ({ATTACK=1, SPECIAL=2, EVADE=3, FEINT=4, REPOSITION=5})[experience.action]
              local currentQ = currentQValues[actionIdx] or 0
              local td_error = experience.reward + CONST.DISCOUNT_FACTOR_GAMMA * nextMaxQ - currentQ
              
              -- Store TD error for priority update
              table.insert(tdErrors, td_error)
              
              -- Apply importance sampling weight
              local weight = weights and weights[i] or 1.0
              local weightedLR = CONST.LEARNING_RATE_ALPHA * CONST.REPLAY_LEARNING_RATE_MULTIPLIER * weight
              
              -- Update tabular Q-learning
              local stats = tacticStats[experience.action]
              local old_value = stats.value
              stats.value = old_value + weightedLR * td_error
              
              -- Update deep networks with proper backprop and importance sampling
              if math.abs(td_error) > 0.01 and actionIdx then
                  -- Compute weighted gradient
                  local weightedGrad = td_error * weight
                  
                  -- Update main network
                  UpdateNetworkWeights(AI.DeepNetwork.advantageNet, stateEncoded, AI.DeepNetwork.learningRateDNN * weight, AI.DeepNetwork.gradientClipNorm)
                  
                  -- Update ensemble networks
                  for j = 1, AI.DeepNetwork.ensembleSize do
                      UpdateNetworkWeights(AI.DeepNetwork.ensembleNetworks[j].advantageNet, stateEncoded, AI.DeepNetwork.learningRateDNN * 0.8 * weight, AI.DeepNetwork.gradientClipNorm)
                  end
                  
                  -- Update distributional network if enabled
                  if AI.DistributionalRL.enabled then
                      UpdateNetworkWeights(AI.DistributionalRL.quantileNet, stateEncoded, AI.DeepNetwork.learningRateDNN * 0.9 * weight, AI.DeepNetwork.gradientClipNorm)
                  end
              end
          else
              -- If stats not found, use zero TD error
              table.insert(tdErrors, 0)
          end
      end
      
      -- Update priorities in the replay buffer
      if indices and #indices > 0 then
          AI.Learning.UpdatePriorities(indices, tdErrors)
      end
  end

  function AI.Learning.GetBestNextQValue(tactic, possibleActions)
      local tacticStatsA = AI.ActionStats[tactic]
      local tacticStatsB = AI.QNetworkB[tactic]
      if not tacticStatsA or not tacticStatsB then return 0 end

      -- Double Q-Learning: Use average of both networks to reduce overestimation
      local maxQ = -math.huge
      local foundAction = false
      for action, available in pairs(possibleActions) do
          if available then
              local statsA = tacticStatsA[action]
              local statsB = tacticStatsB[action]
              if statsA and statsA.count and statsA.count > 0 and statsA.value and 
                 statsB and statsB.count and statsB.count > 0 and statsB.value then
                  local qValueA = statsA.value / statsA.count
                  local qValueB = statsB.value / statsB.count
                  -- Average both Q-networks (Double Q-Learning)
                  local qValue = (qValueA + qValueB) / 2
                  if qValue > maxQ then
                      maxQ = qValue
                      foundAction = true
                  end
              elseif statsA and statsA.count and statsA.count > 0 and statsA.value then
                  local qValue = statsA.value / statsA.count
                  if qValue > maxQ then
                      maxQ = qValue
                      foundAction = true
                  end
              end
          end
      end
      return foundAction and maxQ or 0
  end
  
  -- Enhanced deep feature extraction with more sophisticated state representation
  function AI.Learning.ExtractFeatures(state)
      -- Basic features
      local healthAdvantage = (state.myHealthPercent - state.targetHealthPercent) * AI.FeatureWeights.healthDiff
      local distanceNorm = (1 - math.min(state.distance, CONST.AGGRO_RANGE) / CONST.AGGRO_RANGE) * AI.FeatureWeights.distanceToTarget
      local energyNorm = (state.energy / CONST.MAX_ENERGY) * AI.FeatureWeights.energyLevel
      
      -- Advanced features
      local inRangeScore = (state.inRange and 1 or 0) * 1.5
      local threatLevel = (state.isTargetAttacking and 1 or 0) * AI.FeatureWeights.threatLevel
      
      -- Combo potential
      local now = os.clock()
      local comboActive = (now < AI.State.comboStateEndTime) and 1 or 0
      local comboDensity = comboActive * AI.FeatureWeights.comboDensity
      
      -- Opportunity windows
      local opportunityScore = 0
      if now < AI.State.punishWindowEndTime then
          opportunityScore += 2.0
      end
      if now < AI.State.glitchComboWindowEndTime then
          opportunityScore += 2.5
      end
      opportunityScore = opportunityScore * AI.FeatureWeights.opportunityWindow
      
      -- Opponent aggression modeling
      local opponentThreat = AI.OpponentModel.aggressionScore * AI.FeatureWeights.threatLevel
      
      local features = {
          healthAdvantage = healthAdvantage,
          distanceNorm = distanceNorm,
          energyNorm = energyNorm,
          inRangeScore = inRangeScore,
          threatLevel = threatLevel,
          comboDensity = comboDensity,
          opportunityScore = opportunityScore,
          opponentThreat = opponentThreat,
      }
      
      -- Compute weighted feature score
      local score = 0
      for _, value in pairs(features) do
          score += value
      end
      
      -- Normalize score
      score = score / 8
      
      return features, score
  end
  
  -- Update opponent model based on observed actions (with LSTM-style processing)
  function AI.Learning.UpdateOpponentModel(observedAction)
      if observedAction and observedAction ~= "UNKNOWN" then
          -- Update action frequency
          if AI.OpponentModel.actionFrequency[observedAction] then
              AI.OpponentModel.actionFrequency[observedAction] += 1
          end
          
          -- Add to history
          table.insert(AI.OpponentModel.lastActions, observedAction)
          if #AI.OpponentModel.lastActions > AI.OpponentModel.maxHistorySize then
              table.remove(AI.OpponentModel.lastActions, 1)
          end
          
          -- Encode action for LSTM processing
          local actionEncoding = ({ATTACK=1.0, SPECIAL=0.8, EVADE=-0.5, FEINT=-0.3, REPOSITION=0.0, DASH=0.3, BLOCK=-0.7})[observedAction] or 0
          AI.DeepLearning.UpdateLSTMOpponentModel(actionEncoding)
          
          -- Calculate aggression score based on action patterns
          local aggressiveActions = 0
          local defensiveActions = 0
          for _, act in ipairs(AI.OpponentModel.lastActions) do
              if act == "ATTACK" or act == "SPECIAL" then
                  aggressiveActions += 1
              elseif act == "EVADE" or act == "FEINT" then
                  defensiveActions += 1
              end
          end
          
          if #AI.OpponentModel.lastActions > 0 then
              AI.OpponentModel.aggressionScore = aggressiveActions / #AI.OpponentModel.lastActions
          end
          
          -- Advanced pattern prediction using LSTM hidden state
          if AI.LSTMOpponentModel.sequenceLength >= 5 then
              -- Use LSTM hidden state to predict next action
              local hiddenSum = 0
              for _, val in ipairs(AI.LSTMOpponentModel.hiddenState) do
                  hiddenSum += val
              end
              local hiddenAvg = hiddenSum / #AI.LSTMOpponentModel.hiddenState
              
              -- Map hidden state to action prediction
              if hiddenAvg > 0.3 then
                  AI.OpponentModel.predictedNextAction = "ATTACK"
              elseif hiddenAvg > 0 then
                  AI.OpponentModel.predictedNextAction = "SPECIAL"
              elseif hiddenAvg > -0.3 then
                  AI.OpponentModel.predictedNextAction = "REPOSITION"
              else
                  AI.OpponentModel.predictedNextAction = "EVADE"
              end
          end
          
          -- Learn action sequences (n-gram patterns with context)
          if #AI.OpponentModel.lastActions >= 3 then
              local pattern = table.concat(AI.OpponentModel.lastActions, ",", #AI.OpponentModel.lastActions - 2, #AI.OpponentModel.lastActions)
              if not AI.LSTMOpponentModel.patterns[pattern] then
                  AI.LSTMOpponentModel.patterns[pattern] = {}
                  AI.LSTMOpponentModel.patternConfidence[pattern] = 0
              end
              -- Store what action followed this pattern
              table.insert(AI.LSTMOpponentModel.patterns[pattern], observedAction)
              AI.LSTMOpponentModel.patternConfidence[pattern] += 1
              
              -- Enhanced prediction using learned patterns
              if AI.LSTMOpponentModel.patternConfidence[pattern] >= 3 then
                  -- Find most common action following this pattern
                  local actionCounts = {}
                  for _, act in ipairs(AI.LSTMOpponentModel.patterns[pattern]) do
                      actionCounts[act] = (actionCounts[act] or 0) + 1
                  end
                  
                  local maxCount = 0
                  local mostLikely = nil
                  for act, count in pairs(actionCounts) do
                      if count > maxCount then
                          maxCount = count
                          mostLikely = act
                      end
                  end
                  
                  if mostLikely and maxCount / AI.LSTMOpponentModel.patternConfidence[pattern] > 0.5 then
                      -- High confidence prediction based on pattern
                      AI.OpponentModel.predictedNextAction = mostLikely
                      print(`Pattern-based prediction: {mostLikely} (confidence: {maxCount}/{AI.LSTMOpponentModel.patternConfidence[pattern]})`)
                  end
              end
          end
      end
  end
  
  -- OPPONENT BEHAVIOR MODELING: Update Markov Chain with observed action
  function AI.Learning.UpdateOpponentBehaviorModel(observedAction)
      local model = AI.OpponentBehaviorModel
      
      -- Get current opponent name for per-opponent tracking
      local opponentName = model.currentOpponent or "Unknown"
      
      -- Initialize per-opponent data if needed
      if not model.perOpponentData[opponentName] then
          model.perOpponentData[opponentName] = {
              transitionTable = {},
              sequences = {},
              totalObservations = 0,
          }
      end
      
      local opponentData = model.perOpponentData[opponentName]
      
      -- Add to sequence history
      table.insert(opponentData.sequences, observedAction)
      if #opponentData.sequences > model.maxSequenceHistory then
          table.remove(opponentData.sequences, 1)
      end
      
      -- Update transition table (1-gram: single action -> next action)
      if #opponentData.sequences >= 2 then
          local prevAction = opponentData.sequences[#opponentData.sequences - 1]
          
          -- Initialize transition entry if needed
          if not opponentData.transitionTable[prevAction] then
              opponentData.transitionTable[prevAction] = {}
          end
          
          -- Increment count for this transition
          local transitions = opponentData.transitionTable[prevAction]
          transitions[observedAction] = (transitions[observedAction] or 0) + 1
          opponentData.totalObservations += 1
      end
      
      -- Update N-gram sequences (2-gram: two actions -> next action)
      if model.nGramOrder >= 2 and #opponentData.sequences >= 3 then
          local seq2 = opponentData.sequences[#opponentData.sequences - 2] .. "->" .. opponentData.sequences[#opponentData.sequences - 1]
          
          if not opponentData.transitionTable[seq2] then
              opponentData.transitionTable[seq2] = {}
          end
          
          local transitions = opponentData.transitionTable[seq2]
          transitions[observedAction] = (transitions[observedAction] or 0) + 1
      end
      
      -- Predict next action based on patterns
      if #opponentData.sequences >= 1 then
          local lastAction = opponentData.sequences[#opponentData.sequences]
          
          -- Try 2-gram first (more specific)
          if model.nGramOrder >= 2 and #opponentData.sequences >= 2 then
              local seq2 = opponentData.sequences[#opponentData.sequences - 1] .. "->" .. lastAction
              if opponentData.transitionTable[seq2] then
                  local prediction, confidence = model.GetMostLikelyAction(opponentData.transitionTable[seq2])
                  if prediction and confidence >= 0.4 then -- 40% confidence threshold for 2-gram
                      AI.OpponentModel.predictedNextAction = prediction
                      model.predictionConfidence = confidence
                      return
                  end
              end
          end
          
          -- Fall back to 1-gram
          if opponentData.transitionTable[lastAction] then
              local prediction, confidence = model.GetMostLikelyAction(opponentData.transitionTable[lastAction])
              if prediction and confidence >= 0.3 then -- 30% confidence threshold for 1-gram
                  AI.OpponentModel.predictedNextAction = prediction
                  model.predictionConfidence = confidence
              end
          end
      end
      
      -- Adjust reaction weights based on opponent patterns
      model.UpdateReactionWeights(opponentData)
  end
  
  -- Helper: Find most likely action from transition frequencies
  function AI.OpponentBehaviorModel.GetMostLikelyAction(transitions)
      local maxCount = 0
      local totalCount = 0
      local mostLikely = nil
      
      -- Count totals
      for action, count in pairs(transitions) do
          totalCount += count
          if count > maxCount then
              maxCount = count
              mostLikely = action
          end
      end
      
      -- Return action and confidence (frequency ratio)
      if totalCount >= AI.OpponentBehaviorModel.minObservationsForPrediction then
          return mostLikely, maxCount / totalCount
      end
      
      return nil, 0
  end
  
  -- Helper: Update reaction weights based on opponent patterns
  function AI.OpponentBehaviorModel.UpdateReactionWeights(opponentData)
      local model = AI.OpponentBehaviorModel
      
      -- Calculate action frequencies
      local actionFreqs = {}
      local total = 0
      for _, action in ipairs(opponentData.sequences) do
          actionFreqs[action] = (actionFreqs[action] or 0) + 1
          total += 1
      end
      
      -- Adjust weights: boost counters to frequently-used actions
      if total > model.minObservationsForPrediction then
          for action, count in pairs(actionFreqs) do
              local freq = count / total
              
              -- If opponent uses this action often, boost our counter
              if freq > 0.3 then -- Uses this action 30%+ of the time
                  -- Determine best counter
                  if action == "ATTACK" then
                      model.reactionWeights.EVADE = 1.5 -- Dodge attacks
                      model.reactionWeights.BLOCK = 1.3 -- Or block them
                  elseif action == "SPECIAL" then
                      model.reactionWeights.EVADE = 1.6 -- Dodge specials (higher priority)
                      model.reactionWeights.DASH = 1.2 -- Or dash away
                  elseif action == "EVADE" then
                      model.reactionWeights.ATTACK = 1.3 -- Punish their dodges
                      model.reactionWeights.FEINT = 1.2 -- Feint to bait more dodges
                  elseif action == "DASH" then
                      model.reactionWeights.SPECIAL = 1.3 -- Catch them with specials
                  elseif action == "BLOCK" then
                      model.reactionWeights.FEINT = 1.4 -- Feint to break their guard
                      model.reactionWeights.SPECIAL = 1.2 -- Break with specials
                  end
              end
          end
      end
  end
  
  -- Hybrid learning: Update transition model
  function AI.Learning.UpdateTransitionModel(state, action, nextState, reward)
      if not AI.HybridModel.useModelBased then return end
      
      -- Create state signature (simplified)
      local stateKey = string.format("H%.1f_D%.0f_E%.0f", 
          state.myHealthPercent or 0, 
          state.distance or 0, 
          state.energy or 0)
      local nextStateKey = string.format("H%.1f_D%.0f_E%.0f", 
          nextState.myHealthPercent or 0, 
          nextState.distance or 0, 
          nextState.energy or 0)
      
      -- Update transition counts
      local transitionKey = stateKey .. "_" .. action
      if not AI.HybridModel.transitionCounts[transitionKey] then
          AI.HybridModel.transitionCounts[transitionKey] = {}
      end
      AI.HybridModel.transitionCounts[transitionKey][nextStateKey] = 
          (AI.HybridModel.transitionCounts[transitionKey][nextStateKey] or 0) + 1
      
      -- Update reward model
      if not AI.HybridModel.rewardModel[transitionKey] then
          AI.HybridModel.rewardModel[transitionKey] = { sum = 0, count = 0 }
      end
      AI.HybridModel.rewardModel[transitionKey].sum += reward
      AI.HybridModel.rewardModel[transitionKey].count += 1
      
      -- Update model confidence based on data collected
      local totalTransitions = 0
      for _, nextStates in pairs(AI.HybridModel.transitionCounts) do
          for _, count in pairs(nextStates) do
              totalTransitions += count
          end
      end
      AI.HybridModel.modelConfidence = math.min(0.8, totalTransitions / 100)
  end
  
  -- Model-based planning: Simulate future outcomes
  function AI.Learning.SimulateFuture(state, action, tactic, depth)
      if depth <= 0 or not AI.HybridModel.useModelBased then return 0 end
      
      local stateKey = string.format("H%.1f_D%.0f_E%.0f", 
          state.myHealthPercent or 0, 
          state.distance or 0, 
          state.energy or 0)
      local transitionKey = stateKey .. "_" .. action
      
      -- Get expected reward from model
      local expectedReward = 0
      if AI.HybridModel.rewardModel[transitionKey] then
          local model = AI.HybridModel.rewardModel[transitionKey]
          if model.count and model.count > 0 and model.sum then
              expectedReward = model.sum / model.count
          end
      end
      
      -- Simple recursive planning (limited depth)
      if depth > 1 and AI.HybridModel.transitionCounts[transitionKey] then
          local futureValue = 0
          local totalCount = 0
          
          -- Average over possible next states
          for nextStateKey, count in pairs(AI.HybridModel.transitionCounts[transitionKey]) do
              totalCount += count
          end
          
          if totalCount > 0 then
              futureValue = AI.Learning.GetBestNextQValue(tactic, {
                  ATTACK = true, SPECIAL = true, EVADE = true, FEINT = true, REPOSITION = true
              })
          end
          
          return expectedReward + CONST.DISCOUNT_FACTOR_GAMMA * futureValue
      end
      
      return expectedReward
  end
  
  --// ================= ADAPTIVE LEARNING ENHANCEMENTS ================= //
  
  -- Get or create opponent-specific feature weights
  function AI.Learning.GetOpponentWeights(opponentName)
      local model = AI.OpponentModel
      
      if not model.perOpponentWeights[opponentName] then
          -- Initialize new opponent weights with defaults
          model.perOpponentWeights[opponentName] = {
              healthDiff = 1.0,
              distanceToTarget = 1.0,
              energyLevel = 1.0,
              velocityMatch = 1.0,
              tacticSuccess = 1.0,
              comboDensity = 1.0,
              threatLevel = 1.0,
              opportunityWindow = 1.0,
          }
          print(`🆕 Created feature weights for opponent: {opponentName}`)
      end
      
      return model.perOpponentWeights[opponentName]
  end
  
  -- Set active opponent and load their weights
  function AI.Learning.SetActiveOpponent(opponentName)
      if opponentName and opponentName ~= AI.OpponentModel.currentOpponentName then
          AI.OpponentModel.currentOpponentName = opponentName
          AI.OpponentModel.activeWeights = AI.Learning.GetOpponentWeights(opponentName)
          print(`🎯 Switched to opponent: {opponentName}`)
      end
  end
  
  -- Update volatility tracker for adaptive learning rates
  function AI.Learning.UpdateVolatility(behaviorChange)
      local meta = AI.MetaLearning
      
      -- Add behavior change to window
      table.insert(meta.volatilityWindow, behaviorChange)
      if #meta.volatilityWindow > meta.maxVolatilityHistory then
          table.remove(meta.volatilityWindow, 1)
      end
      
      -- Calculate average volatility (0-1)
      local totalChange = 0
      for _, change in ipairs(meta.volatilityWindow) do
          totalChange += change
      end
      meta.currentVolatility = totalChange / math.max(1, #meta.volatilityWindow)
      
      -- Adjust learning rate multipliers based on volatility
      if meta.currentVolatility > 0.6 then
          -- High volatility: increase learning rate to adapt faster
          meta.adaptiveSuccessMultiplier = 1.15 -- Was 1.08
          meta.adaptiveDecayMultiplier = 0.990 -- Was 0.995
      elseif meta.currentVolatility < 0.3 then
          -- Low volatility (predictable): lower learning rate to stabilize
          meta.adaptiveSuccessMultiplier = 1.04 -- Was 1.08
          meta.adaptiveDecayMultiplier = 0.998 -- Was 0.995
      else
          -- Normal volatility: use base rates
          meta.adaptiveSuccessMultiplier = meta.baseSuccessMultiplier
          meta.adaptiveDecayMultiplier = meta.baseDecayMultiplier
      end
  end
  
  -- Update momentum-based adaptation (hot state detection)
  function AI.Learning.UpdateMomentumState(consecutiveHits)
      local momentum = AI.MomentumAdaptation
      if not momentum.enabled then return end
      
      local now = os.clock()
      
      -- Enter hot state
      if consecutiveHits > momentum.hotStateThreshold and not momentum.isInHotState then
          momentum.isInHotState = true
          momentum.hotStateStartTime = now
          -- Freeze current feature weights
          momentum.frozenFeatureWeights = {}
          local activeWeights = AI.OpponentModel.activeWeights or AI.FeatureWeights
          for key, value in pairs(activeWeights) do
              momentum.frozenFeatureWeights[key] = value
          end
          print(`🔥 HOT STATE ACTIVATED! Freezing weights (${consecutiveHits} consecutive hits)`)
      end
      
      -- Exit hot state (combo dropped or timeout)
      if momentum.isInHotState then
          local shouldExit = consecutiveHits <= momentum.hotStateThreshold or 
                             (now - momentum.hotStateStartTime) > momentum.maxHotStateDuration
          if shouldExit then
              momentum.isInHotState = false
              momentum.frozenFeatureWeights = nil
              print(`❄️ HOT STATE ENDED. Resuming normal adaptation.`)
          end
      end
  end
  
  -- Update Dynamic Difficulty Adjustment
  function AI.Learning.UpdateDDA(wonMatch)
      local dda = AI.DynamicDifficulty
      if not dda.enabled then return end
      
      -- Record match result
      table.insert(dda.matchHistory, wonMatch and 1 or 0)
      if #dda.matchHistory > dda.maxMatchHistory then
          table.remove(dda.matchHistory, 1)
      end
      
      -- Calculate win rate
      local wins = 0
      for _, result in ipairs(dda.matchHistory) do
          wins += result
      end
      dda.currentWinRate = wins / #dda.matchHistory
      
      -- Adjust difficulty mode
      if dda.currentWinRate >= dda.dominatingThreshold then
          -- Dominating: reduce AI effectiveness for engagement
          dda.difficultyMode = "StylePoints"
          dda.reactionSpeedModifier = 0.85 -- 15% slower reactions
          dda.timingWindowModifier = 1.15 -- 15% looser timing
          dda.riskTolerance = 1.5 -- More risky combos
          print(`📉 DDA: Style Points Mode (Win Rate: {string.format("%.1f", dda.currentWinRate * 100)}%)`)
      elseif dda.currentWinRate <= dda.losingThreshold then
          -- Losing: tighten up and try harder
          dda.difficultyMode = "Tryhard"
          dda.reactionSpeedModifier = 1.15 -- 15% faster reactions
          dda.timingWindowModifier = 0.90 -- 10% tighter timing
          dda.riskTolerance = 0.7 -- Safer combos
          print(`📈 DDA: Tryhard Mode (Win Rate: {string.format("%.1f", dda.currentWinRate * 100)}%)`)
      else
          -- Balanced: normal difficulty
          dda.difficultyMode = "Normal"
          dda.reactionSpeedModifier = 1.0
          dda.timingWindowModifier = 1.0
          dda.riskTolerance = 1.0
      end
  end
  
  -- Update Bait & Punish learning
  function AI.Learning.UpdateBaitLearning(feintSuccess, opponentReacted)
      local bait = AI.BaitLearning
      
      bait.totalFeints += 1
      if feintSuccess then
          bait.successfulFeints += 1
      end
      
      if opponentReacted then
          bait.opponentReactedToFeint += 1
      else
          bait.opponentIgnoredFeint += 1
      end
      
      -- Update success rate
      bait.feintSuccessRate = bait.successfulFeints / math.max(1, bait.totalFeints)
      
      -- Decide if we should continue using baits
      if bait.totalFeints >= 10 then -- Need sample size
          bait.shouldUseBaits = bait.feintSuccessRate >= bait.confidenceThreshold
          
          if not bait.shouldUseBaits then
              print(`🚫 FEINT disabled (Success: {string.format("%.1f", bait.feintSuccessRate * 100)}% < {bait.confidenceThreshold * 100}%)`)
          end
      end
  end
  
  -- Track opponent resource usage
  function AI.Learning.TrackOpponentResource(resourceType)
      local res = AI.ResourceAwareness
      local now = os.clock()
      
      if resourceType == "DASH" then
          res.opponentLastDash = now
      elseif resourceType == "ESCAPE" then
          res.opponentLastEscape = now
      elseif resourceType == "SPECIAL" then
          res.opponentLastSpecial = now
      end
      
      -- Check if opponent is vulnerable (no escape available)
      local dashOnCooldown = (now - res.opponentLastDash) < res.estimatedDashCooldown
      local escapeOnCooldown = (now - res.opponentLastEscape) < res.estimatedEscapeCooldown
      res.isOpponentVulnerable = dashOnCooldown and escapeOnCooldown
      
      if res.isOpponentVulnerable then
          print(`⚡ OPPONENT VULNERABLE! No escape available.`)
      end
  end
  
  -- Update zone adaptation (track damage by distance)
  function AI.Learning.UpdateZoneAdaptation(distance, damageDealt, died)
      local zone = AI.ZoneAdaptation
      if not zone.enabled then return end
      
      -- Find distance bucket
      local bucket = nil
      for i = #zone.distanceBuckets, 1, -1 do
          if distance >= zone.distanceBuckets[i] then
              bucket = zone.distanceBuckets[i]
              break
          end
      end
      
      if not bucket then
          bucket = zone.distanceBuckets[1]
      end
      
      -- Track damage dealt at this distance
      if damageDealt > 0 then
          zone.damageByDistance[bucket] = (zone.damageByDistance[bucket] or 0) + damageDealt
      end
      
      -- Track deaths at this distance (negative value)
      if died then
          zone.deathByDistance[bucket] = (zone.deathByDistance[bucket] or 0) + 1
      end
      
      -- Find optimal zone (best damage, fewest deaths)
      local bestScore = -math.huge
      local bestZone = zone.optimalZone
      for _, dist in ipairs(zone.distanceBuckets) do
          local damage = zone.damageByDistance[dist] or 0
          local deaths = zone.deathByDistance[dist] or 0
          local score = damage - (deaths * 50) -- Each death = -50 score
          
          if score > bestScore then
              bestScore = score
              bestZone = dist
          end
      end
      
      if bestZone ~= zone.optimalZone then
          zone.optimalZone = bestZone
          print(`📍 Optimal zone updated: {bestZone} studs (Score: {string.format("%.0f", bestScore)})`)
      end
  end

  --// --- EVALUATION MODULE ---
  function AI.Evaluation.ChooseTactic(state)
      local now = os.clock()

      -- Highest priority: Glitch exploitation.
      if AI.GlitchScanner.isGlitchDetected and now - AI.GlitchScanner.detectionTime < 5.0 then
          if AI.State.currentTactic ~= "ExploitSeeker" then
              print(`GLITCH DETECTED (${AI.GlitchScanner.glitchType})! Forcing EXPLOITSEEKER tactic.`)
              -- Reinforce the action that *caused* the glitch.
              AI.Learning.Reinforce("ExploitSeeker", AI.State.lastAction, CONST.GLITCH_DETECTION_REWARD, 0) -- No future Q-value needed here.
          end
          return "ExploitSeeker"
      end

      -- Cooldown to prevent rapid tactic switching.
      if now - AI.State.lastTacticChangeTime < CONST.TACTIC_CHANGE_COOLDOWN then
          return AI.State.currentTactic
      end

      -- NEW: Win Probability Estimator - Dynamic tactic selection based on predicted win probability
      if AI.WinProbabilityEstimator.enabled then
          local winProb = AI.DeepLearning.PredictWinProbability(state)
          
          -- Store prediction for debugging
          AI.State.lastWinProbability = winProb
          
          -- Dynamic tactic switching based on win probability
          if winProb < AI.WinProbabilityEstimator.defensiveThreshold then
              -- Low win probability (<0.4) - Switch to Defensive/Turtle mode
              if AI.State.currentTactic ~= "Defensive" then
                  AI.State.lastTacticChangeTime = now
                  AI.State.tacticConfidence = 100
                  print(string.format("🛡️ Win Probability %.2f < 0.4 - Switching to DEFENSIVE mode", winProb))
              end
              return "Defensive"
          elseif winProb > AI.WinProbabilityEstimator.aggressiveThreshold then
              -- High win probability (>0.8) - Switch to Aggressive/Finisher to end fight
              local chosenTactic = state.targetHealthPercent < 0.3 and "Finisher" or "Aggressive"
              if AI.State.currentTactic ~= chosenTactic then
                  AI.State.lastTacticChangeTime = now
                  AI.State.tacticConfidence = 100
                  print(string.format("⚔️ Win Probability %.2f > 0.8 - Switching to %s mode", winProb, chosenTactic:upper()))
              end
              return chosenTactic
          end
          
          -- Record match snapshot for training
          AI.DeepLearning.RecordMatchSnapshot(state)
      end

      -- If confidence is critical, switch to experimental mode.
      if AI.State.tacticConfidence < CONST.EXPLOIT_SEEKER_CONFIDENCE_THRESHOLD and now - AI.State.lastExploitSeekerTriggerTime > CONST.EXPLOIT_SEEKER_COOLDOWN then
          AI.State.lastTacticChangeTime = now
          AI.State.lastExploitSeekerTriggerTime = now
          print("Confidence critical. Switching to EXPLOITSEEKER to find new strategies.")
          return "ExploitSeeker"
      end

      -- If confidence is high, stick with the current tactic for a bit longer.
      if AI.State.tacticConfidence > CONST.TACTIC_CONFIDENCE_THRESHOLD and os.clock() - AI.State.lastTacticChangeTime < CONST.TACTIC_CHANGE_COOLDOWN * 2 then
          return AI.State.currentTactic
      end

      -- Character-specific rule-based tactic selection with profile weighting
      local newTactic
      local baseScores = {
          Finisher = 0,
          Aggressive = 0,
          Defensive = 0,
          BaitAndPunish = 0,
          ExploitSeeker = 0,
      }
      
      -- Calculate base scores from game state
      if state.targetHealthPercent < 0.2 and state.distance < CONST.ATTACK_RANGE * 1.5 then 
          baseScores.Finisher = 100 
      end
      if state.myHealthPercent > 0.75 and state.energy > (CONST.MAX_ENERGY * 0.6) then 
          baseScores.Aggressive = 80 
      end
      if state.myHealthPercent < 0.35 or state.energy < (CONST.MAX_ENERGY * 0.25) then 
          baseScores.Defensive = 90 
      end
      -- BaitAndPunish is always a fallback option
      baseScores.BaitAndPunish = 50
      
      -- Apply character-specific weights if profile exists
      if characterInfo.TacticWeights then
          for tacticName, weight in pairs(characterInfo.TacticWeights) do
              if baseScores[tacticName] then
                  baseScores[tacticName] = baseScores[tacticName] * weight
              end
          end
      end
      
      -- Select tactic with highest weighted score
      local maxScore = -math.huge
      newTactic = "BaitAndPunish" -- Default fallback
      for tacticName, score in pairs(baseScores) do
          if score > maxScore then
              maxScore = score
              newTactic = tacticName
          end
      end

      if newTactic ~= AI.State.currentTactic then
          AI.State.lastTacticChangeTime = now
          AI.State.tacticConfidence = 100 -- Reset confidence on switch.
          print("Tactic changed to:", newTactic, "(Character:", AI.IdentifiedCharacter, "Playstyle:", characterInfo.Playstyle or "Unknown", ")")
      end
      return newTactic
  end

  function AI.Evaluation.FindBestActionByScore(state, tactic)
      local now = os.clock()

      -- Immediate capitalization windows (glitch or punish) - highest priority
      local function isCapitalizeWindow()
          return now < AI.State.glitchComboWindowEndTime or now < AI.State.punishWindowEndTime
      end

      if isCapitalizeWindow() and state.inRange then
          if CONST.DEBUG_MODE then
              if AI.State.glitchComboWindowEndTime > now then 
                  print("Executing Glitch Combo!") 
              elseif AI.State.punishWindowEndTime > now then
                  print("Executing Punish Window Combo!")
              end
          end
          if #AI.AvailableMoves > 0 and now - AI.State.lastActionTimes.SPECIAL > CONST.SPECIAL_MOVE_COOLDOWN and state.energy >= CONST.COSTS.SPECIAL then 
              if CONST.DEBUG_MODE then print("Using SPECIAL in capitalize window") end
              return "SPECIAL" 
          end
          if now - AI.State.lastActionTimes.ATTACK > CONST.ATTACK_COOLDOWN then 
              if CONST.DEBUG_MODE then print("Using ATTACK in capitalize window") end
              return "ATTACK" 
          end
      end

      -- ACTION MASKING (#3): Invalid Action Prevention Layer
      -- This prevents the AI from wasting time trying impossible actions
      local function isActionMasked(action)
          -- Mask attacking actions if stunned/ragdolled
          if humanoid then
              local humanoidState = humanoid:GetState()
              if humanoidState == Enum.HumanoidStateType.Ragdoll or 
                 humanoidState == Enum.HumanoidStateType.FallingDown or
                 humanoidState == Enum.HumanoidStateType.Flying then
                  if action == "ATTACK" or action == "SPECIAL" or action == "BLOCK" then
                      return true -- Cannot attack/block while stunned
                  end
              end
          end
          
          -- Mask actions on cooldown (hard constraint)
          if action == "ATTACK" and (now - AI.State.lastActionTimes.ATTACK <= CONST.ATTACK_COOLDOWN) then
              return true
          end
          if action == "SPECIAL" and (now - AI.State.lastActionTimes.SPECIAL <= CONST.SPECIAL_MOVE_COOLDOWN) then
              return true
          end
          if action == "EVADE" and (now - AI.State.lastActionTimes.EVADE <= CONST.DASH_COOLDOWN) then
              return true
          end
          if action == "DASH" and (now - AI.State.lastActionTimes.DASH <= CONST.DASH_COOLDOWN) then
              return true
          end
          if action == "FEINT" and (now - AI.State.lastActionTimes.FEINT <= CONST.FEINT_COOLDOWN) then
              return true
          end
          if action == "BLOCK" and (now - AI.State.lastActionTimes.BLOCK <= CONST.BLOCK_COOLDOWN) then
              return true
          end
          
          -- Mask actions without enough energy (hard constraint)
          local energyCost = CONST.COSTS[action] or 0
          if state.energy < energyCost then
              return true
          end
          
          -- Mask range-dependent actions
          if (action == "ATTACK" or action == "SPECIAL" or action == "FEINT") and not state.inRange then
              return true
          end
          
          -- Mask SPECIAL if no moves available
          if action == "SPECIAL" and #AI.AvailableMoves == 0 then
              return true
          end
          
          -- Mask BLOCK if already blocking
          if action == "BLOCK" and AI.State.isBlocking then
              return true
          end
          
          return false -- Action is valid
      end

      -- Cache possible actions check for ultra-fast performance with action masking
      local possibleActions = {}
      local inCombo = now < AI.State.comboStateEndTime
      
      -- Apply action masking to all actions
      possibleActions.ATTACK = not isActionMasked("ATTACK")
      possibleActions.SPECIAL = not isActionMasked("SPECIAL")
      possibleActions.EVADE = not isActionMasked("EVADE")
      possibleActions.FEINT = not isActionMasked("FEINT")
      possibleActions.DASH = not isActionMasked("DASH")
      possibleActions.BLOCK = not isActionMasked("BLOCK")
      possibleActions.REPOSITION = true -- REPOSITION is always available

      -- ExploitSeeker uses pure random exploration
      if tactic == "ExploitSeeker" then
          local actionPool = {}
          for action, available in pairs(possibleActions) do
              if available and action ~= "REPOSITION" then -- Exclude REPOSITION from random pool
                  table.insert(actionPool, action)
              end
          end
          return #actionPool > 0 and actionPool[math.random(#actionPool)] or "REPOSITION"
      end

      -- Advanced exploration strategies with deep learning
      local tacticStatsA = AI.ActionStats[tactic]
      local tacticStatsB = AI.QNetworkB[tactic]
      local actionScores = {}
      
      -- Extract deep features for better decision-making
      local features, featureScore = AI.Learning.ExtractFeatures(state)
      
      -- Get deep neural network predictions
      local stateEncoded = AI.DeepLearning.EncodeState(state)
      local dnnQValues = AI.DeepLearning.PredictQValues(stateEncoded, false)
      local ensembleQValues = AI.DeepLearning.EnsemblePredict(stateEncoded)
      local policyProbs = AI.DeepLearning.PredictPolicy(stateEncoded)
      
      -- Choose exploration strategy based on learning progress and opponent patterns
      local explorationMode = AI.State.explorationStrategy
      if AI.ActionStats.totalTrials < 100 then
          explorationMode = "epsilon-greedy" -- Early exploration
      elseif AI.ActionStats.totalTrials < 500 then
          explorationMode = "policy-gradient" -- Use policy network
      else
          -- Adaptive strategy selection based on opponent behavior
          if AI.OpponentModel.aggressionScore > 0.7 then
              explorationMode = "defensive-ensemble" -- Conservative ensemble for aggressive opponents
          elseif AI.OpponentModel.aggressionScore < 0.3 then
              explorationMode = "aggressive-policy" -- Aggressive policy for defensive opponents
          else
              explorationMode = "ensemble" -- Balanced ensemble for mixed opponents
          end
      end

      -- Build action scores with deep learning integration
      local actionMap = {ATTACK=1, SPECIAL=2, EVADE=3, FEINT=4, REPOSITION=5, DASH=6, BLOCK=7}
      for action, available in pairs(possibleActions) do
          if available then
              local statsA = tacticStatsA[action]
              local statsB = tacticStatsB[action]
              
              -- Safety check: Ensure stats exist
              if not statsA then
                  warn(`Missing statsA for action: {action}`)
                  statsA = { count = 0, value = 0, eligibility = 0 }
              end
              
              local actionIdx = actionMap[action]
              local score
              
              if not statsA.count or not statsA.value or statsA.count == 0 then
                  -- Use deep network prediction for untried actions
                  score = CONST.UNTRIED_ACTION_SCORE + (dnnQValues[actionIdx] or 0) * 10
              else
                  -- Hybrid approach: Combine tabular Q-learning with deep network
                  local qValueA = statsA.value / statsA.count
                  local qValueB = (statsB and statsB.count and statsB.value and statsB.count > 0) and (statsB.value / statsB.count) or qValueA
                  local tabularQ = (qValueA + qValueB) / 2
                  
                  -- Deep network Q-value (ensemble average with nil checks)
                  local dnnQ = dnnQValues[actionIdx] or 0
                  local ensembleQ = ensembleQValues[actionIdx] or 0
                  local deepQ = (dnnQ + ensembleQ) / 2
                  
                  -- Adaptive weighting: More weight on deep network as it learns
                  local deepWeight = math.min(0.7, AI.ActionStats.totalTrials / 1000)
                  local qValue = tabularQ * (1 - deepWeight) + deepQ * deepWeight
                  
                  -- Hybrid learning: Combine model-free and model-based
                  if AI.HybridModel.useModelBased and AI.HybridModel.modelConfidence > 0.2 then
                      local modelValue = AI.Learning.SimulateFuture(state, action, tactic, AI.State.modelBasedPlanDepth)
                      qValue = qValue * (1 - AI.HybridModel.modelConfidence) + modelValue * AI.HybridModel.modelConfidence
                  end
                  
                  -- Add policy network guidance (Actor-Critic)
                  local policyBonus = (policyProbs[actionIdx] or 0) * 15
                  
                  -- Add deep feature score
                  score = qValue + featureScore * 0.15 + policyBonus
              end

              -- Apply situational modifiers for tactical awareness
              local modifier = 1.0
              
              -- Apply opponent behavior model reaction weights (Counter-AI)
              local reactionWeight = AI.OpponentBehaviorModel.reactionWeights[action] or 1.0
              if AI.OpponentBehaviorModel.predictionConfidence > 0.3 then
                  -- Only apply reaction weights if we have good confidence in pattern
                  modifier *= reactionWeight
                  if CONST.DEBUG_MODE and reactionWeight > 1.1 then
                      print(`Counter-AI boost for {action}: {reactionWeight}x (confidence: {string.format("%.2f", AI.OpponentBehaviorModel.predictionConfidence)})`)
                  end
              end
              
              -- React to predicted opponent action (enhanced with LSTM confidence and aggression)
              if AI.OpponentModel.predictedNextAction == "ATTACK" and action == "EVADE" then
                  -- Better confidence scaling based on pattern learning
                  local baseConfidence = AI.LSTMOpponentModel.sequenceLength >= 15 and 2.3 or 
                                        (AI.LSTMOpponentModel.sequenceLength >= 10 and 2.0 or 1.6)
                  -- Extra bonus if opponent is highly aggressive
                  if AI.OpponentModel.aggressionScore > 0.7 then
                      baseConfidence *= 1.2
                  end
                  modifier *= baseConfidence
              end
              
              -- Counter-prediction: If opponent is likely to evade, use reposition or feint
              if AI.OpponentModel.predictedNextAction == "EVADE" then
                  if action == "FEINT" then
                      modifier *= 1.6 -- Stronger feint preference against defensive opponents
                  elseif action == "REPOSITION" then
                      modifier *= 1.3
                  end
              end
              
              -- Predict aggressive opponents and prepare counters
              if AI.OpponentModel.aggressionScore > 0.65 and AI.OpponentModel.predictedNextAction == "SPECIAL" then
                  if action == "EVADE" then
                      modifier *= 1.8 -- Strong evasion preference against aggressive specials
                  end
              end
              
              -- Enhanced adaptive threat response
              if action == "EVADE" and state.isTargetAttacking then 
                  modifier = 2.9 -- Even stronger preference for evasion when under direct attack
              end
              if (tactic == "BaitAndPunish" or tactic == "Defensive") and action == "EVADE" then 
                  modifier *= 1.7 -- Increased for defensive tactics
              end
              
              -- DASH action modifiers - aggressive repositioning and tech usage
              if action == "DASH" then
                  if tactic == "Aggressive" or tactic == "Finisher" then
                      modifier *= CONST.DASH_AGGRESSIVE_MULTIPLIER
                  end
                  if state.distance > CONST.ATTACK_RANGE * 1.2 then
                      modifier *= 1.5 -- Use dash to close distance
                  end
                  -- Encourage dash as a tech move
                  if AI.State.comboCount > 0 then
                      modifier *= 1.4 -- Use dash in combos for tech
                  end
              end
              
              -- FEINT action modifiers - tech usage
              if action == "FEINT" then
                  if AI.OpponentModel.aggressionScore > 0.6 then
                      modifier *= CONST.FEINT_AGGRESSIVE_MULTIPLIER
                  end
                  if state.distance < CONST.ATTACK_RANGE * 1.3 then
                      modifier *= 1.5 -- Feint when in close range
                  end
              end
              
              -- BLOCK action modifiers - defensive response
              if action == "BLOCK" then
                  if state.isTargetAttacking then
                      modifier *= 2.5 -- Strong preference for blocking when under attack
                  end
                  if tactic == "Defensive" then
                      modifier *= 1.8 -- Defensive tactics favor blocking
                  end
                  if state.myHealthPercent < 0.3 then
                      modifier *= 1.6 -- Block more when low health
                  end
                  if AI.OpponentModel.aggressionScore > 0.7 then
                      modifier *= 1.4 -- Block more against aggressive opponents
                  end
              end
              if action == "ATTACK" and inCombo then
                  -- Enhanced combo encouragement with improved exponential scaling
                  local linearBonus = AI.State.comboCount * 0.25
                  local exponentialBonus = (AI.State.comboCount ^ 1.18) * 0.09
                  local comboBonus = 2.0 + linearBonus + exponentialBonus
                  modifier *= math.min(comboBonus, CONST.COMBO_MAX_MULTIPLIER)
              end
              if action == "SPECIAL" and inCombo then
                  if AI.State.comboCount >= 2 then
                      -- Much stronger special usage in combos for maximum damage
                      modifier *= CONST.SPECIAL_COMBO_MULTIPLIER
                  elseif AI.State.comboCount >= 1 then
                      -- Use special moves in combos
                      modifier *= CONST.SPECIAL_COMBO_MULTIPLIER_MID
                  end
              end
              if action == "SPECIAL" and now < AI.State.punishWindowEndTime then
                  modifier *= 2.2 -- Strongly capitalize on punish windows with specials
              end
              -- Encourage special move usage when energy is available
              if action == "SPECIAL" and state.energy > CONST.MAX_ENERGY * 0.5 then
                  modifier *= 1.6 -- Bonus for using specials when we have energy
              end
              
              -- Health-based adaptivity (improved with gradient scaling)
              if state.myHealthPercent < 0.25 then
                  if action == "EVADE" then
                      -- Very defensive when very low health
                      modifier *= (state.myHealthPercent < 0.15) and 1.8 or 1.6
                  end
                  if action == "REPOSITION" then
                      -- Strong repositioning when critically low
                      modifier *= (state.myHealthPercent < 0.15) and 1.5 or 1.3
                  end
                  -- Reduce aggression when low on health
                  if action == "ATTACK" or action == "SPECIAL" then
                      modifier *= (state.myHealthPercent < 0.15) and 0.7 or 0.85
                  end
              elseif state.myHealthPercent < 0.4 and action == "EVADE" then
                  modifier *= 1.3 -- Moderately defensive
              end
              
              -- Finisher mode - capitalize on low enemy health
              if state.targetHealthPercent < 0.2 then
                  if action == "ATTACK" or action == "SPECIAL" then
                      -- Strong aggression for the kill with gradient scaling
                      local killBonus = state.targetHealthPercent < 0.1 and 1.9 or 1.7
                      modifier *= killBonus
                  end
                  if action == "SPECIAL" and state.targetHealthPercent < 0.1 then
                      modifier *= 1.5 -- Extra bonus for special finishers
                  end
              elseif state.targetHealthPercent < 0.3 and (action == "ATTACK" or action == "SPECIAL") then
                  modifier *= 1.4 -- Moderate aggression advantage
              end
              
              -- Health advantage/disadvantage considerations
              local healthDiff = state.myHealthPercent - state.targetHealthPercent
              if healthDiff > 0.3 then
                  -- Significant health advantage: can be more aggressive
                  if action == "ATTACK" or action == "SPECIAL" then
                      modifier *= 1.2
                  end
              elseif healthDiff < -0.3 then
                  -- Significant disadvantage: more defensive
                  if action == "EVADE" or action == "REPOSITION" then
                      modifier *= 1.25
                  end
              end
              
              -- Enhanced energy management with improved 5-tier system and smarter thresholds
              local energyPercent = state.energy / CONST.MAX_ENERGY
              if energyPercent < 0.10 then
                  -- Critical energy: very strong preference for free actions, but allow essential defense
                  if action == "ATTACK" or action == "REPOSITION" then
                      modifier *= 1.45 -- Stronger bonus for free actions
                  elseif action == "EVADE" and state.isTargetAttacking then
                      modifier *= 0.85 -- Still allow defensive evade when under attack
                  else
                      modifier *= 0.35 -- Very strong penalty for energy-consuming actions
                  end
              elseif energyPercent < 0.22 then
                  -- Low energy: strong conservation
                  if action == "ATTACK" or action == "REPOSITION" then
                      modifier *= 1.3
                  elseif action == "EVADE" then
                      modifier *= 0.9 -- Slight penalty but still viable
                  else
                      modifier *= 0.6
                  end
              elseif energyPercent < 0.38 then
                  -- Mid-low energy: moderate conservation
                  if action == "SPECIAL" or action == "FEINT" then
                      modifier *= 0.8
                  end
              elseif energyPercent > 0.78 then
                  -- High energy: encourage special moves and aggressive plays
                  if action == "SPECIAL" then
                      modifier *= 1.4 -- Stronger bonus
                  elseif action == "FEINT" then
                      modifier *= 1.2 -- Also encourage feints
                  end
              elseif energyPercent > 0.88 then
                  -- Very high energy: strong encouragement to spend
                  if action == "SPECIAL" then
                      modifier *= 1.55
                  elseif action == "DASH" or action == "FEINT" then
                      modifier *= 1.3
                  end
              end
              
              -- NEW: Resource-Aware Aggression (Opponent cooldown tracking)
              if AI.ResourceAwareness.isOpponentVulnerable and (action == "ATTACK" or action == "SPECIAL") then
                  -- Opponent has no escape: massively boost aggression
                  modifier *= AI.ResourceAwareness.aggressionBoostMultiplier
                  if CONST.DEBUG_MODE then
                      print(`🔥 Resource-Aware Boost: {action} x{AI.ResourceAwareness.aggressionBoostMultiplier} (Opponent vulnerable)`)
                  end
              end
              
              -- NEW: Bait & Punish Learning (Feint effectiveness)
              if action == "FEINT" and not AI.BaitLearning.shouldUseBaits then
                  -- Feints not working: reduce priority
                  modifier *= 0.3
              elseif action == "FEINT" and AI.BaitLearning.feintSuccessRate > 0.7 then
                  -- Feints very effective: boost priority
                  modifier *= 1.8
              end
              
              -- NEW: Zone Adaptation (Distance-based strategy)
              if AI.ZoneAdaptation.enabled then
                  local currentDist = state.distance or 0
                  local optimalDist = AI.ZoneAdaptation.optimalZone
                  local distDiff = math.abs(currentDist - optimalDist)
                  
                  if distDiff > 20 then
                      -- Too far from optimal zone: boost repositioning
                      if action == "REPOSITION" or action == "DASH" then
                          modifier *= 1.6
                      end
                  elseif distDiff < 10 then
                      -- At optimal zone: boost attacks
                      if action == "ATTACK" or action == "SPECIAL" then
                          modifier *= 1.3
                      end
                  end
              end
              
              -- NEW: Dynamic Difficulty Adjustment (DDA modifiers)
              if AI.DynamicDifficulty.enabled then
                  local dda = AI.DynamicDifficulty
                  
                  -- Apply reaction speed modifier to cooldown-dependent actions
                  if dda.difficultyMode == "Tryhard" then
                      -- Tryhard mode: tighter timing, safer choices
                      if action == "EVADE" or action == "BLOCK" then
                          modifier *= 1.2 -- More defensive
                      end
                  elseif dda.difficultyMode == "StylePoints" then
                      -- Style mode: riskier, flashier combos
                      if action == "FEINT" or (action == "SPECIAL" and inCombo) then
                          modifier *= dda.riskTolerance -- Encourage risky plays
                      end
                      if action == "BLOCK" or action == "EVADE" then
                          modifier *= 0.8 -- Less defensive
                      end
                  end
              end
              
              -- Character-specific action modifiers (apply profile bonuses)
              if characterInfo then
                  -- Special move priority adjustment based on character
                  if action == "SPECIAL" and characterInfo.SpecialPriority then
                      modifier *= characterInfo.SpecialPriority
                  end
                  
                  -- Dash usage adjustment based on character playstyle
                  if action == "DASH" and characterInfo.DashAggressiveness then
                      modifier *= characterInfo.DashAggressiveness
                  end
                  
                  -- Counter-attack focus (BLOCK and EVADE)
                  if (action == "BLOCK" or action == "EVADE") and characterInfo.CounterFocus then
                      modifier *= characterInfo.CounterFocus
                  end
                  
                  -- Apply combo preference if we have one
                  if characterInfo.ComboPreference and AI.State.comboCount > 0 then
                      local comboIndex = (AI.State.comboCount % #characterInfo.ComboPreference) + 1
                      local preferredAction = characterInfo.ComboPreference[comboIndex]
                      if action == preferredAction then
                          modifier *= 1.4 -- Bonus for following character's combo pattern
                      end
                  end
              end

              table.insert(actionScores, { 
                  action = action, 
                  score = score * modifier,
                  count = statsA.count,
                  rawQ = (statsA.count and statsA.count > 0 and statsA.value) and (statsA.value / statsA.count) or 0
              })
          end
      end

      if #actionScores == 0 then return "REPOSITION" end

      -- Apply exploration strategy
      if explorationMode == "epsilon-greedy" and math.random() < AI.State.epsilon then
          -- Epsilon-greedy: Random action
          return actionScores[math.random(#actionScores)].action
      elseif explorationMode == "policy-gradient" or explorationMode == "aggressive-policy" then
          -- Policy gradient: Sample from policy network distribution
          local rand = math.random()
          local cumProb = 0
          for i, actionData in ipairs(actionScores) do
              local actionIdx = actionMap[actionData.action]
              cumProb += policyProbs[actionIdx] or 0
              if cumProb >= rand then
                  return actionData.action
              end
          end
      elseif explorationMode == "ensemble" or explorationMode == "defensive-ensemble" then
          -- Ensemble voting: Use ensemble consensus with confidence weighting
          for _, actionData in ipairs(actionScores) do
              local actionIdx = actionMap[actionData.action]
              -- Weight by ensemble agreement (lower variance = higher confidence) with nil checks
              local dnnQ = dnnQValues[actionIdx] or 0
              local ensembleQ = ensembleQValues[actionIdx] or 0
              local variance = math.abs(dnnQ - ensembleQ)
              local confidenceBonus = math.max(0, 5 - variance)
              actionData.score += confidenceBonus
              
              -- Defensive bonus for defensive-ensemble mode
              if explorationMode == "defensive-ensemble" and (actionData.action == "EVADE" or actionData.action == "FEINT") then
                  actionData.score *= 1.2
              end
          end
      elseif explorationMode == "ucb" then
          -- Upper Confidence Bound: Balance exploration and exploitation
          for _, actionData in ipairs(actionScores) do
              if actionData.count > 0 then
                  local exploration = CONST.UCB_EXPLORATION_CONSTANT * math.sqrt(math.log(AI.ActionStats.totalTrials) / actionData.count)
                  actionData.score += exploration
              end
          end
      elseif explorationMode == "boltzmann" then
          -- Boltzmann exploration: Probabilistic selection based on Q-values
          local expScores = {}
          local sumExp = 0
          for _, actionData in ipairs(actionScores) do
              local expScore = math.exp(actionData.score / AI.State.boltzmannTemperature)
              table.insert(expScores, expScore)
              sumExp += expScore
          end
          
          -- Probabilistic selection
          local rand = math.random() * sumExp
          local cumSum = 0
          for i, expScore in ipairs(expScores) do
              cumSum += expScore
              if cumSum >= rand then
                  return actionScores[i].action
              end
          end
      end

      -- Sort by score (highest first) and return best
      table.sort(actionScores, function(a, b) return a.score > b.score end)
      return actionScores[1].action
  end

  --// --- ACTION MODULE ---
  function AI.Actions.Execute(action, state)
      local now = os.clock()
      AI.State.lastAction = action

      if not AI.State.targetTorso then return end -- Safety check
      local targetPos = AI.State.targetTorso.Position

      local cost = CONST.COSTS[action:upper()] or 0
      AI.State.currentEnergy -= cost
      
      -- Store current state for experience replay
      AI.State.actionsSinceReplay += 1

      if action == "FEINT" then
          communicateEvent:FireServer({["Goal"]="Feint"})
          AI.State.lastActionTimes.FEINT = now
          AI.State.isFeinting, AI.State.feintStartTime, AI.State.distanceAtFeintStart = true, now, (rootPart.Position - targetPos).Magnitude
      elseif action == "ATTACK" then
          communicateEvent:FireServer({["Mobile"]=true, ["Goal"]="LeftClick"})
          AI.State.lastActionTimes.ATTACK = now
          AI.State.punishWindowEndTime = 0
          
          -- Try to use dash tech to cancel attack animation
          task.delay(0.15, function() -- Small delay to let attack register
              CombatTech.dashTech("ATTACK")
          end)
      elseif action == "SPECIAL" then
          if #AI.AvailableMoves > 0 then
              local moveName = AI.AvailableMoves[math.random(#AI.AvailableMoves)]
              local tool = player.Backpack:FindFirstChild(moveName) or character:FindFirstChild(moveName)
              if tool then
                  communicateEvent:FireServer({["Tool"] = tool, ["Goal"] = "Console Move"})
                  AI.State.lastActionTimes.SPECIAL = now
                  AI.State.punishWindowEndTime = 0
                  
                  -- Try to use dash tech to cancel special animation
                  task.delay(0.2, function() -- Slightly longer delay for special moves
                      CombatTech.dashTech("SPECIAL")
                  end)
              end
          end
      elseif action == "EVADE" then
          -- Smarter evade direction based on target velocity
          local targetVelocity = AI.State.targetTorso.AssemblyLinearVelocity
          
          -- Safety check for velocity
          if not targetVelocity then
              targetVelocity = Vector3.new(0, 0, 0)
          end
          
          local perpendicular = rootPart.CFrame.RightVector * (math.random() > 0.5 and 1 or -1)
          if targetVelocity.Magnitude > 10 then
              -- Dodge perpendicular to target's movement (+90 degree rotation in horizontal plane)
              local targetDir = targetVelocity.Unit
              perpendicular = Vector3.new(-targetDir.Z, 0, targetDir.X)
          end
          communicateEvent:FireServer({["Dash"]=perpendicular.Unit, ["Key"]="Q", ["Goal"]="KeyPress"})
          AI.State.lastActionTimes.EVADE = now
          AI.State.isPerfectDodging, AI.State.dodgeStartTime = true, now
      elseif action == "DASH" then
          -- ML-based smart dash direction selection with wall awareness (#7)
          local dashDirection, dashScores
          
          -- Use ML prediction if we have enough learning data
          if AI.ActionStats.totalTrials > 100 then
              dashDirection, dashScores = AI.DeepLearning.PredictBestDashDirection(state, targetPos, rootPart)
              
              -- WALL AWARENESS (#7): Override ML decision if it would dash into a wall
              if state.wallRaycasts and #state.wallRaycasts > 0 then
                  local directionToCheck = nil
                  if dashDirection == Enum.KeyCode.W then
                      directionToCheck = 3 -- Forward
                  elseif dashDirection == Enum.KeyCode.S then
                      directionToCheck = 4 -- Backward
                  elseif dashDirection == Enum.KeyCode.A then
                      directionToCheck = 2 -- Left
                  elseif dashDirection == Enum.KeyCode.D then
                      directionToCheck = 1 -- Right
                  end
                  
                  -- Check if there's a wall in that direction
                  if directionToCheck and state.wallRaycasts[directionToCheck] and 
                     state.wallRaycasts[directionToCheck].hit and 
                     state.wallRaycasts[directionToCheck].distance < 10 then
                      -- Wall too close, choose sideways dash instead
                      dashDirection = math.random() > 0.5 and Enum.KeyCode.A or Enum.KeyCode.D
                      if CONST.DEBUG_MODE then
                          print("⚠️ Wall detected! Overriding dash to sideways")
                      end
                  end
              end
              
              if CONST.DEBUG_MODE then
                  print("ML Dash: Direction=" .. tostring(dashDirection) .. " Scores: W=" .. 
                      string.format("%.2f", dashScores.W) .. " S=" .. string.format("%.2f", dashScores.S) .. 
                      " A=" .. string.format("%.2f", dashScores.A) .. " D=" .. string.format("%.2f", dashScores.D))
              end
          else
              -- Fallback to rule-based system during early learning with wall awareness (#7)
              local currentDist = (rootPart.Position - targetPos).Magnitude
              
              -- Choose dash direction based on tactic and distance
              if AI.State.currentTactic == "Defensive" or state.myHealthPercent < 0.3 then
                  -- WALL AWARENESS (#7): Don't backdash if cornered, use side dash instead
                  if state.isCornered or (state.wallRaycasts and state.wallRaycasts[4] and 
                     state.wallRaycasts[4].hit and state.wallRaycasts[4].distance < 10) then
                      -- Cornered or wall behind: dash sideways instead
                      dashDirection = math.random() > 0.5 and Enum.KeyCode.A or Enum.KeyCode.D
                      if CONST.DEBUG_MODE then
                          print("⚠️ Cornered! Using side dash instead of backdash")
                      end
                  else
                      -- Backdash when defensive or low health (and not cornered)
                      dashDirection = Enum.KeyCode.S
                  end
              elseif AI.State.currentTactic == "Aggressive" or AI.State.currentTactic == "Finisher" then
                  -- Forward dash when aggressive
                  dashDirection = Enum.KeyCode.W
              elseif currentDist > CONST.ATTACK_RANGE * 1.5 then
                  -- Forward dash to close distance
                  dashDirection = Enum.KeyCode.W
              elseif currentDist < CONST.ATTACK_RANGE * 0.5 then
                  -- WALL AWARENESS (#7): Check for wall behind before backdashing
                  if state.wallRaycasts and state.wallRaycasts[4] and 
                     state.wallRaycasts[4].hit and state.wallRaycasts[4].distance < 10 then
                      -- Wall behind: dash sideways instead
                      dashDirection = math.random() > 0.5 and Enum.KeyCode.A or Enum.KeyCode.D
                  else
                      -- Backdash to create space when too close (and no wall behind)
                      dashDirection = Enum.KeyCode.S
                  end
              else
                  -- Side dash for repositioning (randomly left or right)
                  dashDirection = math.random() > 0.5 and Enum.KeyCode.A or Enum.KeyCode.D
              end
          end
          
          communicateEvent:FireServer({["Dash"]=dashDirection, ["Key"]=Enum.KeyCode.Q, ["Goal"]="KeyPress"})
          AI.State.lastActionTimes.DASH = now
      elseif action == "BLOCK" then
          -- Block with F key
          communicateEvent:FireServer({["Goal"]="KeyPress", ["Key"]=Enum.KeyCode.F})
          AI.State.lastActionTimes.BLOCK = now
          AI.State.isBlocking = true
          AI.State.blockStartTime = now
      elseif action == "BLOCK_RELEASE" then
          -- Release block
          communicateEvent:FireServer({["Goal"]="KeyRelease", ["Key"]=Enum.KeyCode.F})
          AI.State.isBlocking = false
      elseif action == "REPOSITION" then
          if now - AI.State.lastStrafeChange > (0.8 + math.random() * 0.4) then -- Faster strafe changes
              AI.State.strafeDirection *= -1
              AI.State.lastStrafeChange = now
          end

          local currentDist = (rootPart.Position - targetPos).Magnitude
          local desiredRange
          if AI.State.currentTactic == "Defensive" then desiredRange = CONST.KITE_RANGE
          elseif AI.State.currentTactic == "Finisher" or AI.State.currentTactic == "Aggressive" then desiredRange = CONST.ATTACK_RANGE * 0.7
          else desiredRange = CONST.ATTACK_RANGE * 0.9 end

          local moveDirection = (targetPos - ((targetPos - rootPart.Position).Unit * desiredRange) + (rootPart.CFrame.RightVector * 10 * AI.State.strafeDirection))
          humanoid:MoveTo(moveDirection)

          -- Immediate feedback for repositioning
          local distanceError = math.abs(currentDist - desiredRange)
          local reward = math.max(0, 1 - (distanceError / desiredRange)) * 2
          AI.Learning.Reinforce(AI.State.currentTactic, "REPOSITION", reward, state)
      end
      
      -- Store current state in history for n-step returns (reward will be updated later)
      table.insert(AI.State.stateHistory, {state = state, action = action, reward = nil, tactic = AI.State.currentTactic, timestamp = os.clock()})
      if #AI.State.stateHistory > CONST.N_STEP_RETURN + 2 then
          table.remove(AI.State.stateHistory, 1)
      end
      
      -- Store experience for replay learning and hybrid model
      if state then
          AI.Learning.StoreExperience(state, action, 0, state, AI.State.currentTactic)
          
          -- Update hybrid transition model
          if AI.ActionStats.totalTrials % CONST.MODEL_UPDATE_THRESHOLD == 0 then
              AI.Learning.UpdateTransitionModel(state, action, state, 0)
          end
      end
      
      -- Perform experience replay periodically
      if AI.State.actionsSinceReplay >= CONST.REPLAY_FREQUENCY then
          AI.Learning.ReplayExperiences()
          AI.State.actionsSinceReplay = 0
      end
  end

  --// ================= HELPER & UPDATE FUNCTIONS ================= //

  local function Cleanup()
      if targetDiedConnection then targetDiedConnection:Disconnect(); targetDiedConnection = nil end
      for _, c in ipairs(connections) do c:Disconnect() end
      connections = {}
      AI.State.combatState = "IDLE"
      AI.State.currentTarget = nil
      print("Project Apex has been shut down for this character.")
  end

  local function GetTargetScore(targetCharacter)
      -- Fast validity checks with early returns
      if not targetCharacter or not targetCharacter.Parent then return 0 end
      
      -- Check whitelist before scoring
      local targetPlayer = Players:GetPlayerFromCharacter(targetCharacter)
      if targetPlayer and IsPlayerWhitelisted(targetPlayer) then
          return 0 -- Skip whitelisted players
      end
      
      local root = targetCharacter:FindFirstChild("HumanoidRootPart")
      if not root then return 0 end
      
      local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
      if not targetHumanoid or targetHumanoid.Health <= 0 then return 0 end

      -- Pre-calculate distance once
      local distance = (rootPart.Position - root.Position).Magnitude
      if distance > CONST.AGGRO_RANGE then return 0 end

      -- Optimized scoring with weighted factors
      local healthRatio = targetHumanoid.Health / targetHumanoid.MaxHealth
      local healthScore = (1 - healthRatio) * 2.0 -- Increased weight for low-health targets
      local distanceScore = (1 - (distance / CONST.AGGRO_RANGE)) * 1.5 -- Closer is better
      
      -- Improved velocity penalty with gradual scaling (with nil safety)
      local velocity = root.AssemblyLinearVelocity
      local velocityMag = velocity and velocity.Magnitude or 0
      local velocityScore = velocityMag > 25 and -(velocityMag / 50) or 0.2 -- Bonus for stationary targets

      return healthScore + distanceScore + velocityScore
  end
  
  local function CreateAIClone()
      -- Safety check: ensure character still exists
      if not rootPart or not rootPart.Parent then
          warn("Cannot create AI clone: character rootPart is invalid")
          return nil
      end
      
      -- Cleanup existing clone
      if TrainingMode.cloneCharacter then
          TrainingMode.cloneCharacter:Destroy()
      end
      -- Disconnect clone AI connections
      for _, conn in ipairs(TrainingMode.cloneConnections) do
          conn:Disconnect()
      end
      TrainingMode.cloneConnections = {}
      
      -- Create clone character
      local clone = Instance.new("Model")
      clone.Name = "AI_Clone_Dummy"
      
      local hrp = Instance.new("Part")
      hrp.Name = "HumanoidRootPart"
      hrp.Size = Vector3.new(2, 2, 1)
      hrp.Position = rootPart.Position + Vector3.new(10, 0, 10)
      hrp.Anchored = false
      hrp.CanCollide = true
      hrp.Parent = clone
      
      local head = Instance.new("Part")
      head.Name = "Head"
      head.Size = Vector3.new(2, 1, 1)
      head.Position = hrp.Position + Vector3.new(0, 1.5, 0)
      head.Anchored = false
      head.CanCollide = true
      head.Parent = clone
      
      local humanoid = Instance.new("Humanoid")
      humanoid.MaxHealth = 100
      humanoid.Health = 100
      humanoid.Parent = clone
      
      -- Weld parts together
      local weld = Instance.new("WeldConstraint")
      weld.Part0 = hrp
      weld.Part1 = head
      weld.Parent = hrp
      
      clone.Parent = Workspace
      TrainingMode.cloneCharacter = clone
      
      -- Initialize Clone AI (mimics player's AI)
      InitializeCloneAI(clone, hrp, humanoid)
      
      print("AI Clone created with AI brain for training")
      return clone
  end
  
  -- Initialize the clone's AI to mimic the player's AI behavior
  local function InitializeCloneAI(clone, cloneRootPart, cloneHumanoid)
      -- Create a separate AI brain for the clone
      TrainingMode.cloneAI = {
          State = {
              currentTarget = nil,
              targetHumanoid = nil,
              targetTorso = nil,
              combatState = "IDLE",
              currentTactic = "Aggressive",
              lastActionTimes = { ATTACK = 0, SPECIAL = 0, EVADE = 0, FEINT = 0, DASH = 0, BLOCK = 0 },
              strafeDirection = 1,
              lastStrafeChange = 0,
              lastAction = "IDLE",
              currentEnergy = CONST.MAX_ENERGY,
              lastTargetHealth = 0,
              myHealth = cloneHumanoid.Health,
              isPerfectDodging = false,
              dodgeStartTime = 0,
              isFeinting = false,
              feintStartTime = 0,
              distanceAtFeintStart = 0,
              isBlocking = false,
              blockStartTime = 0,
              punishWindowEndTime = 0,
              comboStateEndTime = 0,
              comboCount = 0,
              consecutiveHits = 0,
              lastComboTime = 0,
              lastDamageDealtTime = 0,
              isTargetAttacking = false,
              lastPlayerAttackTime = 0,
              cachedPredictedPos = nil,
              lastPredictionTime = 0,
              lastTargetVelocity = nil,
          },
          -- Add learning structures for self-play
          ActionStats = nil, -- Will be loaded from best weights
          QNetworkB = nil,
          FeatureWeights = nil,
      }
      
      -- Load best weights into clone for shadow boxing (AlphaGo-style self-play)
      if AI.SelfPlaySystem.enabled then
          AI.DeepLearning.LoadBestWeightsIntoClone(TrainingMode.cloneAI)
      end
      
      local cloneState = TrainingMode.cloneAI.State
      
      -- Clone's target selection (targets the player)
      local function CloneSetTarget()
          if character and humanoid and humanoid.Health > 0 then
              cloneState.currentTarget = character
              cloneState.targetHumanoid = humanoid
              cloneState.targetTorso = rootPart
              cloneState.lastTargetHealth = humanoid.Health
              cloneState.combatState = "ENGAGING"
          else
              cloneState.combatState = "IDLE"
              cloneState.currentTarget = nil
          end
      end
      
      -- Clone's action execution (simulated - deals damage directly)
      local function CloneExecuteAction(action, state)
          local now = os.clock()
          cloneState.lastAction = action
          
          if not cloneState.targetTorso then return end
          
          local targetPos = cloneState.targetTorso.Position
          local cost = CONST.COSTS[action:upper()] or 0
          cloneState.currentEnergy -= cost
          
          if action == "ATTACK" then
              -- Simulate attack with damage
              if state.inRange and humanoid and humanoid.Health > 0 then
                  local damage = math.random(CONST.CLONE_ATTACK_DAMAGE_MIN, CONST.CLONE_ATTACK_DAMAGE_MAX)
                  humanoid:TakeDamage(damage)
                  cloneState.punishWindowEndTime = 0
              end
              cloneState.lastActionTimes.ATTACK = now
          elseif action == "SPECIAL" then
              -- Simulate special move with higher damage
              if state.inRange and humanoid and humanoid.Health > 0 then
                  local damage = math.random(CONST.CLONE_SPECIAL_DAMAGE_MIN, CONST.CLONE_SPECIAL_DAMAGE_MAX)
                  humanoid:TakeDamage(damage)
                  cloneState.punishWindowEndTime = 0
              end
              cloneState.lastActionTimes.SPECIAL = now
          elseif action == "EVADE" then
              -- Simulate dodge by moving perpendicular
              local perpendicular = cloneRootPart.CFrame.RightVector * (math.random() > 0.5 and 1 or -1)
              local evadePos = cloneRootPart.Position + (perpendicular.Unit * 15)
              cloneRootPart.CFrame = CFrame.new(evadePos)
              cloneState.lastActionTimes.EVADE = now
              cloneState.isPerfectDodging = true
              cloneState.dodgeStartTime = now
          elseif action == "DASH" then
              -- Simulate dash
              local dashDir
              local currentDist = (cloneRootPart.Position - targetPos).Magnitude
              if cloneState.currentTactic == "Defensive" or state.myHealthPercent < 0.3 then
                  dashDir = (cloneRootPart.Position - targetPos).Unit
              elseif currentDist > CONST.ATTACK_RANGE * 1.5 then
                  dashDir = (targetPos - cloneRootPart.Position).Unit
              else
                  dashDir = cloneRootPart.CFrame.RightVector * (math.random() > 0.5 and 1 or -1)
              end
              cloneRootPart.CFrame = CFrame.new(cloneRootPart.Position + dashDir * 10)
              cloneState.lastActionTimes.DASH = now
          elseif action == "FEINT" then
              cloneState.lastActionTimes.FEINT = now
              cloneState.isFeinting = true
              cloneState.feintStartTime = now
              cloneState.distanceAtFeintStart = (cloneRootPart.Position - targetPos).Magnitude
          elseif action == "BLOCK" then
              cloneState.lastActionTimes.BLOCK = now
              cloneState.isBlocking = true
              cloneState.blockStartTime = now
          elseif action == "REPOSITION" then
              -- Strafe and maintain distance
              if now - cloneState.lastStrafeChange > 1.0 then
                  cloneState.strafeDirection *= -1
                  cloneState.lastStrafeChange = now
              end
              local currentDist = (cloneRootPart.Position - targetPos).Magnitude
              local desiredRange = CONST.ATTACK_RANGE * 0.9
              local moveDirection = targetPos - ((targetPos - cloneRootPart.Position).Unit * desiredRange) + 
                                  (cloneRootPart.CFrame.RightVector * 10 * cloneState.strafeDirection)
              cloneHumanoid:MoveTo(moveDirection)
          end
      end
      
      -- Simplified action selection for clone
      local function ChooseCloneAction(state, tactic, now)
          local possibleActions = {}
          
          -- Check cooldowns
          if (now - cloneState.lastActionTimes.ATTACK > CONST.ATTACK_COOLDOWN) and state.inRange then
              table.insert(possibleActions, "ATTACK")
          end
          if (now - cloneState.lastActionTimes.SPECIAL > CONST.SPECIAL_MOVE_COOLDOWN) and 
             (state.energy >= CONST.COSTS.SPECIAL) and state.inRange then
              table.insert(possibleActions, "SPECIAL")
          end
          if (now - cloneState.lastActionTimes.EVADE > CONST.DASH_COOLDOWN) and 
             (state.energy >= CONST.COSTS.DASH) then
              table.insert(possibleActions, "EVADE")
          end
          if (now - cloneState.lastActionTimes.DASH > CONST.DASH_COOLDOWN) and 
             (state.energy >= CONST.COSTS.DASH) then
              table.insert(possibleActions, "DASH")
          end
          if (now - cloneState.lastActionTimes.FEINT > CONST.FEINT_COOLDOWN) and 
             (state.energy >= CONST.COSTS.FEINT) and state.inRange then
              table.insert(possibleActions, "FEINT")
          end
          if (now - cloneState.lastActionTimes.BLOCK > CONST.BLOCK_COOLDOWN) and 
             (state.energy >= CONST.COSTS.BLOCK) and not cloneState.isBlocking then
              table.insert(possibleActions, "BLOCK")
          end
          table.insert(possibleActions, "REPOSITION")
          
          -- Simple tactical decision
          if #possibleActions == 0 then return "REPOSITION" end
          
          -- Prefer attacks when in range and have energy (fixed probability logic)
          if state.inRange and state.energy > 50 then
              -- Check for ATTACK action availability
              for _, action in ipairs(possibleActions) do
                  if action == "ATTACK" then
                      if math.random() < CONST.CLONE_ATTACK_PROBABILITY then
                          return "ATTACK"
                      end
                      break -- Only check once
                  end
              end
              -- Check for SPECIAL action availability
              for _, action in ipairs(possibleActions) do
                  if action == "SPECIAL" then
                      if math.random() < CONST.CLONE_SPECIAL_PROBABILITY then
                          return "SPECIAL"
                      end
                      break -- Only check once
                  end
              end
          end
          
          -- Defensive when low health
          if state.myHealthPercent < 0.3 then
              for _, action in ipairs(possibleActions) do
                  if action == "EVADE" and state.isTargetAttacking then
                      return "EVADE"
                  end
                  if action == "BLOCK" and state.isTargetAttacking then
                      return "BLOCK"
                  end
              end
          end
          
          -- Close distance if too far
          if state.distance > CONST.ATTACK_RANGE * 1.5 then
              for _, action in ipairs(possibleActions) do
                  if action == "DASH" then
                      return "DASH"
                  end
              end
          end
          
          -- Random action
          return possibleActions[math.random(#possibleActions)]
      end
      
      -- Clone's combat logic loop
      local function CloneExecuteCombat(now)
          if cloneState.combatState ~= "ENGAGING" or cloneState.isFeinting then return end
          if not (cloneState.targetTorso and cloneState.targetTorso.Parent and cloneState.targetHumanoid) then return end
          
          -- Aim at target
          local targetPos = cloneState.targetTorso.Position
          cloneRootPart.CFrame = CFrame.lookAt(cloneRootPart.Position, Vector3.new(targetPos.X, cloneRootPart.Position.Y, targetPos.Z))
          
          -- Build state
          local distance = (cloneRootPart.Position - cloneState.targetTorso.Position).Magnitude
          local myHealthPercent = cloneHumanoid.Health / cloneHumanoid.MaxHealth
          local targetHealthPercent = cloneState.targetHumanoid.Health / cloneState.targetHumanoid.MaxHealth
          
          local state = {
              myHealthPercent = myHealthPercent,
              targetHealthPercent = targetHealthPercent,
              distance = distance,
              energy = cloneState.currentEnergy,
              inRange = distance <= CONST.ATTACK_RANGE,
              isTargetAttacking = cloneState.isTargetAttacking,
          }
          
          -- Choose tactic (simplified)
          if myHealthPercent < 0.3 then
              cloneState.currentTactic = "Defensive"
          elseif targetHealthPercent < 0.2 then
              cloneState.currentTactic = "Finisher"
          else
              cloneState.currentTactic = "Aggressive"
          end
          
          -- Choose action (simplified decision making)
          local bestAction = ChooseCloneAction(state, cloneState.currentTactic, now)
          CloneExecuteAction(bestAction, state)
      end
      
      -- Clone AI update loop
      local function CloneUpdateAI(deltaTime)
          local now = os.clock()
          
          -- Regenerate energy
          cloneState.currentEnergy = math.min(CONST.MAX_ENERGY, cloneState.currentEnergy + CONST.ENERGY_REGEN_RATE * deltaTime)
          
          -- Update target
          CloneSetTarget()
          
          -- Detect if player is attacking (improved detection)
          local activeTool = character and character:FindFirstChildOfClass("Tool")
          local wasAttacking = cloneState.isTargetAttacking
          cloneState.isTargetAttacking = activeTool and activeTool.Enabled
          -- If tool just became active, mark as attacking with timeout
          if cloneState.isTargetAttacking and not wasAttacking then
              cloneState.lastPlayerAttackTime = now
          elseif not cloneState.isTargetAttacking and wasAttacking then
              -- Keep attack flag for a brief moment after tool is disabled (attack window)
              if now - (cloneState.lastPlayerAttackTime or 0) < CONST.CLONE_ATTACK_WINDOW then
                  cloneState.isTargetAttacking = true
              end
          end
          
          -- Handle perfect dodge timeout
          if cloneState.isPerfectDodging and now > cloneState.dodgeStartTime + CONST.PERFECT_DODGE_WINDOW then
              cloneState.isPerfectDodging = false
          end
          
          -- Handle feint
          if cloneState.isFeinting and now > cloneState.feintStartTime + CONST.FEINT_DURATION then
              cloneState.isFeinting = false
          end
          
          -- Handle block release
          if cloneState.isBlocking then
              local blockTime = now - cloneState.blockStartTime
              if blockTime > CONST.BLOCK_DURATION or not cloneState.isTargetAttacking then
                  cloneState.isBlocking = false
              end
          end
          
          -- Track damage dealt
          if cloneState.targetHumanoid then
              local currentTargetHealth = cloneState.targetHumanoid.Health
              -- Safety check: Ensure lastTargetHealth is initialized for clone
              if cloneState.lastTargetHealth == nil then
                  cloneState.lastTargetHealth = currentTargetHealth
              end
              local damageDealt = cloneState.lastTargetHealth - currentTargetHealth
              if damageDealt > 0 then
                  cloneState.lastDamageDealtTime = now
                  -- Track combo
                  if now < cloneState.comboStateEndTime then
                      cloneState.comboCount += 1
                      cloneState.consecutiveHits += 1
                  else
                      cloneState.comboCount = 1
                      cloneState.consecutiveHits = 1
                  end
                  cloneState.comboStateEndTime = now + CONST.COMBO_WINDOW_DURATION
              end
              cloneState.lastTargetHealth = currentTargetHealth
          end
      end
      
      -- Connect clone AI to heartbeat with improved error handling
      table.insert(TrainingMode.cloneConnections, RunService.Heartbeat:Connect(function(deltaTime)
          local success, err = pcall(function()
              -- Validate clone still exists
              if not (clone and clone.Parent and cloneHumanoid and cloneHumanoid.Health > 0) then
                  return
              end
              local now = os.clock()
              -- Guard against invalid deltaTime
              if isValidDeltaTime(deltaTime) then
                  CloneUpdateAI(deltaTime)
              end
              CloneExecuteCombat(now)
          end)
          if not success then
              warn("Clone AI encountered an error:", err)
              -- Reset clone state on error
              if cloneState then
                  cloneState.combatState = "IDLE"
                  cloneState.isFeinting = false
                  cloneState.isPerfectDodging = false
                  cloneState.isBlocking = false
              end
          end
      end))
      
      -- Handle clone death with safer cleanup
      table.insert(TrainingMode.cloneConnections, cloneHumanoid.Died:Connect(function()
          print("Clone AI has been defeated!")
          -- Disconnect clone AI connections safely
          local connectionsToDisconnect = TrainingMode.cloneConnections
          TrainingMode.cloneConnections = {}
          for _, conn in ipairs(connectionsToDisconnect) do
              pcall(function() conn:Disconnect() end)
          end
      end))
      
      print("Clone AI initialized - ready to fight!")
  end

  local function EvaluateAndSetTarget()
      -- If training against clone, prioritize clone as target
      if TrainingMode.enabled and TrainingMode.trainingAgainstClone and TrainingMode.cloneCharacter then
          local cloneHumanoid = TrainingMode.cloneCharacter:FindFirstChildOfClass("Humanoid")
          if cloneHumanoid and cloneHumanoid.Health > 0 then
              if TrainingMode.cloneCharacter ~= AI.State.currentTarget then
                  if targetDiedConnection then targetDiedConnection:Disconnect() end
                  
                  AI.State.currentTarget = TrainingMode.cloneCharacter
                  AI.State.targetHumanoid = cloneHumanoid
                  AI.State.targetTorso = TrainingMode.cloneCharacter:FindFirstChild("Torso") or TrainingMode.cloneCharacter:FindFirstChild("HumanoidRootPart")
                  AI.State.lastTargetHealth = cloneHumanoid.Health
                  
                  targetDiedConnection = cloneHumanoid.Died:Connect(function()
                      AI.Score += 10
                      print(`Clone eliminated. New Score: {AI.Score}`)
                      AI.State.currentTarget = nil
                      -- Respawn clone after brief delay (in separate thread)
                      task.spawn(function()
                          task.wait(2)
                          if TrainingMode.enabled and TrainingMode.trainingAgainstClone then
                              CreateAIClone()
                          end
                      end)
                  end)
              end
              AI.State.combatState = "ENGAGING"
              return
          end
      end
      
      -- Normal target selection for players
      local bestTarget, highestScore = nil, -math.huge
      for _, p in ipairs(Players:GetPlayers()) do
          if p ~= player and p.Character then
              local score = GetTargetScore(p.Character)
              if score > highestScore then
                  highestScore, bestTarget = score, p.Character
              end
          end
      end

      if bestTarget and bestTarget ~= AI.State.currentTarget then
          if targetDiedConnection then targetDiedConnection:Disconnect() end

          local targetHumanoid = bestTarget:FindFirstChildOfClass("Humanoid")
          AI.State.currentTarget, AI.State.targetHumanoid, AI.State.targetTorso = bestTarget, targetHumanoid, bestTarget:FindFirstChild("Torso") or bestTarget:FindFirstChild("HumanoidRootPart")
          AI.State.lastTargetHealth = targetHumanoid and targetHumanoid.Health or 0
          
          -- Set current opponent for behavior tracking and feature weights
          local targetPlayer = Players:GetPlayerFromCharacter(bestTarget)
          if targetPlayer then
              AI.OpponentBehaviorModel.currentOpponent = targetPlayer.Name
              -- Load opponent-specific feature weights
              AI.Learning.SetActiveOpponent(targetPlayer.Name)
              if CONST.DEBUG_MODE then
                  print(`Tracking opponent behavior: {targetPlayer.Name}`)
              end
          end

          targetDiedConnection = targetHumanoid.Died:Connect(function()
              AI.Score += 10
              print(`Target eliminated. New Score: {AI.Score}`)
              AI.State.currentTarget = nil
              -- Update DDA on match end
              AI.Learning.UpdateDDA(true) -- We won
              -- Train Win Probability Estimator on match victory
              if AI.WinProbabilityEstimator.enabled then
                  AI.DeepLearning.TrainOnMatchEnd(true) -- We won
                  -- Update self-play statistics if training against clone
                  AI.DeepLearning.UpdateSelfPlayStats(true)
              end
              -- Save character model on successful elimination
              AI.Learning.SaveCharacterModel()
          end)
      end

      if not AI.State.currentTarget or not AI.State.targetHumanoid or AI.State.targetHumanoid.Health <= 0 then
          AI.State.combatState = "IDLE"
          AI.State.currentTarget = nil
      else
          AI.State.combatState = "ENGAGING"
      end
  end

  -- Helper function to detect NaN values (IEEE 754: NaN is the only value that doesn't equal itself)
  local function isNaN(value)
      return value ~= value
  end

  local function RunGlitchScanner()
      local now = os.clock()
      
      -- Quick exit if glitch is already active
      if AI.GlitchScanner.isGlitchDetected then
          if now - AI.GlitchScanner.detectionTime > 2.0 then
              AI.GlitchScanner.isGlitchDetected = false
          end
          return
      end

      local function triggerGlitch(glitchType)
          AI.GlitchScanner.isGlitchDetected = true
          AI.GlitchScanner.glitchType = glitchType
          AI.GlitchScanner.detectionTime = now
          AI.State.glitchComboWindowEndTime = now + CONST.GLITCH_COMBO_WINDOW_DURATION
          print(`GLITCH DETECTED: {glitchType}`)
      end

      -- 1. Fast velocity spike detection (optimized with nil safety)
      local currentVelocity = rootPart.AssemblyLinearVelocity
      local currentVelocityMag = currentVelocity and currentVelocity.Magnitude or 0
      if currentVelocityMag > CONST.GLITCH_VELOCITY_THRESHOLD and AI.GlitchScanner.lastVelocityMagnitude < CONST.GLITCH_VELOCITY_THRESHOLD then
          triggerGlitch("Velocity Spike")
          AI.GlitchScanner.lastVelocityMagnitude = currentVelocityMag
          return
      end
      AI.GlitchScanner.lastVelocityMagnitude = currentVelocityMag

      -- 2. Humanoid state anomaly detection (optimized with early return)
      local currentState = humanoid:GetState()
      if currentState ~= AI.GlitchScanner.lastHumanoidState then
          if currentState == Enum.HumanoidStateType.StrafingNoPhysics or currentState == Enum.HumanoidStateType.None then
              triggerGlitch("Humanoid State Anomaly")
              AI.GlitchScanner.lastHumanoidState = currentState
              return
          end
          AI.GlitchScanner.lastHumanoidState = currentState
      end

      -- 3. NaN position check (fast)
      local pos = rootPart.Position
      if isNaN(pos.X) or isNaN(pos.Y) or isNaN(pos.Z) then
          triggerGlitch("NaN Position")
      end
  end

  -- RAYCAST/MAP AWARENESS (#7): Wall detection and corner awareness
  local function UpdateRaycasts()
      local now = os.clock()
      
      -- Throttle raycast updates for performance
      if now - AI.State.lastRaycastUpdate < CONST.RAYCAST_UPDATE_INTERVAL then
          return
      end
      AI.State.lastRaycastUpdate = now
      
      -- Cast rays in 8 directions around the character
      local raycastParams = RaycastParams.new()
      raycastParams.FilterDescendantsInstances = {character}
      raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
      
      local directions = {
          Vector3.new(1, 0, 0),     -- Right
          Vector3.new(-1, 0, 0),    -- Left
          Vector3.new(0, 0, 1),     -- Forward
          Vector3.new(0, 0, -1),    -- Backward
          Vector3.new(0.707, 0, 0.707),   -- Forward-Right
          Vector3.new(-0.707, 0, 0.707),  -- Forward-Left
          Vector3.new(0.707, 0, -0.707),  -- Backward-Right
          Vector3.new(-0.707, 0, -0.707), -- Backward-Left
      }
      
      AI.State.wallRaycasts = {}
      local wallHitCount = 0
      
      for i, direction in ipairs(directions) do
          local rayOrigin = rootPart.Position
          local rayDirection = direction * CONST.RAYCAST_DISTANCE
          
          local rayResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
          
          local hitWall = rayResult ~= nil
          AI.State.wallRaycasts[i] = {
              direction = direction,
              hit = hitWall,
              distance = hitWall and rayResult.Distance or CONST.RAYCAST_DISTANCE,
              position = hitWall and rayResult.Position or (rayOrigin + rayDirection),
          }
          
          if hitWall then
              wallHitCount = wallHitCount + 1
          end
      end
      
      -- Determine if we're cornered (many walls around us)
      AI.State.isCornered = wallHitCount >= CONST.CORNERED_WALL_THRESHOLD
      
      if CONST.DEBUG_MODE and AI.State.isCornered then
          print(`⚠️ CORNERED! {wallHitCount} walls detected`)
      end
  end
  
  -- PING/LATENCY ADAPTIVE INPUT (#8): Network latency compensation
  local function UpdatePing()
      local now = os.clock()
      
      -- Throttle ping updates
      if now - AI.State.lastPingUpdate < CONST.PING_UPDATE_INTERVAL then
          return
      end
      AI.State.lastPingUpdate = now
      
      -- Get current network ping (in seconds)
      AI.State.currentPing = player:GetNetworkPing()
      
      if CONST.DEBUG_MODE and AI.State.currentPing > 0.2 then
          print(`⚠️ High ping detected: {string.format("%.0f", AI.State.currentPing * 1000)}ms`)
      end
  end

  local function UpdateAIState(deltaTime)
      local now = os.clock()
      AI.State.currentEnergy = math.min(CONST.MAX_ENERGY, AI.State.currentEnergy + CONST.ENERGY_REGEN_RATE * deltaTime)

      if now - AI.State.lastTargetScanTime > CONST.TARGET_SCAN_INTERVAL then
          EvaluateAndSetTarget()
          AI.State.lastTargetScanTime = now
      end

      if AI.State.currentTarget and AI.State.currentTarget.Parent then
          local activeTool = AI.State.currentTarget:FindFirstChildOfClass("Tool")
          local wasAttacking = AI.State.isTargetAttacking
          AI.State.isTargetAttacking = activeTool and activeTool.Enabled
          
          -- Detect opponent actions for modeling
          if AI.State.isTargetAttacking and not wasAttacking then
              AI.Learning.UpdateOpponentModel("ATTACK")
              AI.Learning.UpdateOpponentBehaviorModel("ATTACK") -- New: Markov Chain tracking
              AI.Learning.TrackOpponentResource("ATTACK") -- Track for resource awareness
              AI.State.lastOpponentAction = "ATTACK"
              AI.State.opponentActionTime = now
              -- Track behavior change for volatility
              AI.Learning.UpdateVolatility(0.3) -- Attack = moderate change
          elseif AI.State.targetTorso then
              local velocity = AI.State.targetTorso.AssemblyLinearVelocity
              local targetVelocity = velocity and velocity.Magnitude or 0
              if targetVelocity > 50 and now - AI.State.opponentActionTime > 0.5 then
                  AI.Learning.UpdateOpponentModel("EVADE")
                  AI.Learning.UpdateOpponentBehaviorModel("EVADE") -- New: Markov Chain tracking
                  AI.Learning.TrackOpponentResource("DASH") -- Evade likely used dash
                  AI.State.lastOpponentAction = "EVADE"
                  AI.State.opponentActionTime = now
                  -- Track behavior change for volatility
                  AI.Learning.UpdateVolatility(0.6) -- Evade = high change
              end
          end
      else
          AI.State.isTargetAttacking = false
      end

      RunGlitchScanner() -- Run the scanner every state update.
      
      -- Update raycast/map awareness (#7)
      UpdateRaycasts()
      
      -- Update ping/latency (#8)
      UpdatePing()
      
      -- Periodically save character model (every 100 trials)
      if AI.ActionStats.totalTrials > 0 and AI.ActionStats.totalTrials % 100 == 0 then
          if not AI.State.lastModelSaveTrials or AI.State.lastModelSaveTrials ~= AI.ActionStats.totalTrials then
              AI.Learning.SaveCharacterModel()
              AI.State.lastModelSaveTrials = AI.ActionStats.totalTrials
          end
      end
      
      -- Utility Features Update
      -- Anti-AFK check
      if UtilityConfig.antiAFKEnabled and (now - UtilityConfig.lastAFKAction) > UtilityConfig.afkActionInterval then
          PerformAntiAFKAction()
      end
      
      -- Server Hopping checks
      if UtilityConfig.serverHoppingEnabled then
          local shouldHop = false
          local hopReason = ""
          
          -- Check 1: Too few players
          local playerCount = #Players:GetPlayers()
          if playerCount < UtilityConfig.minPlayersBeforeHop then
              shouldHop = true
              hopReason = "Too few players (" .. playerCount .. ")"
          end
          
          -- Check 2: Negative score threshold
          if UtilityConfig.hopOnNegativeScore and AI.Score < UtilityConfig.scoreThresholdForHop then
              shouldHop = true
              hopReason = "Score too low (" .. AI.Score .. ")"
          end
          
          if shouldHop then
              print("Server hop triggered:", hopReason)
              ServerHop()
          end
      end
  end

  local function UpdateLearningAndRewards(now)
      -- Fast exit if no valid target
      if not AI.State.currentTarget or not AI.State.targetHumanoid or not AI.State.targetTorso then return end

      local tactic = AI.State.currentTactic

      -- Block management and reward handling
      if AI.State.isBlocking then
          local blockTime = now - AI.State.blockStartTime
          
          -- Auto-release block after duration or when target stops attacking
          if blockTime > CONST.BLOCK_DURATION or not AI.State.isTargetAttacking then
              -- Release block
              if communicateEvent then
                  communicateEvent:FireServer({["Goal"]="KeyRelease", ["Key"]=Enum.KeyCode.F})
              end
              
              -- If we successfully blocked (held block for minimum duration)
              -- Success means: we blocked for long enough to be considered defensive positioning
              if blockTime >= CONST.MIN_SUCCESSFUL_BLOCK_TIME then
                  -- Build current state (calculate distance once)
                  local currentDist = (rootPart.Position - AI.State.targetTorso.Position).Magnitude
                  local currentState = {
                      myHealthPercent = humanoid.Health / humanoid.MaxHealth,
                      targetHealthPercent = AI.State.targetHumanoid.Health / AI.State.targetHumanoid.MaxHealth,
                      distance = currentDist,
                      energy = AI.State.currentEnergy,
                      inRange = currentDist <= CONST.ATTACK_RANGE,
                      isTargetAttacking = AI.State.isTargetAttacking,
                  }
                  -- Reward for successfully blocking (held block position)
                  AI.Learning.Reinforce(tactic, "BLOCK", CONST.REWARD_SUCCESSFUL_BLOCK, currentState)
                  print("Successful block!")
                  -- Open punish window after block release
                  AI.State.punishWindowEndTime = now + CONST.PUNISH_WINDOW_DURATION
              end
              
              AI.State.isBlocking = false
              print("Block released")
          end
      end

      -- Feint evaluation (optimized timing check)
      if AI.State.isFeinting and now > AI.State.feintStartTime + CONST.FEINT_DURATION then
          AI.State.isFeinting = false
          local currentDistance = (rootPart.Position - AI.State.targetTorso.Position).Magnitude
          local feintSucceeded = currentDistance > AI.State.distanceAtFeintStart + CONST.FEINT_SUCCESS_DISTANCE
          local reward = feintSucceeded and CONST.REWARD_FEINT_SUCCESS or CONST.PENALTY_FAILED_ACTION
          
          -- Check if opponent reacted to feint
          local opponentReacted = AI.State.isTargetAttacking or 
                                  (AI.State.lastOpponentAction and 
                                   (AI.State.lastOpponentAction == "EVADE" or AI.State.lastOpponentAction == "BLOCK") and
                                   now - AI.State.opponentActionTime < 0.5)
          
          -- Update bait learning
          AI.Learning.UpdateBaitLearning(feintSucceeded, opponentReacted)
          
          -- Build current state for reinforcement
          local currentState = {
              myHealthPercent = humanoid.Health / humanoid.MaxHealth,
              targetHealthPercent = AI.State.targetHumanoid.Health / AI.State.targetHumanoid.MaxHealth,
              distance = currentDistance,
              energy = AI.State.currentEnergy,
              inRange = currentDistance <= CONST.ATTACK_RANGE,
              isTargetAttacking = AI.State.isTargetAttacking,
          }
          AI.Learning.Reinforce(tactic, "FEINT", reward, currentState)
          if feintSucceeded then
              AI.State.punishWindowEndTime = now + CONST.PUNISH_WINDOW_DURATION
              print("Feint successful! Punish window opened.")
          end
      end

      -- Perfect dodge window timeout
      if AI.State.isPerfectDodging and now > AI.State.dodgeStartTime + CONST.PERFECT_DODGE_WINDOW then
          AI.State.isPerfectDodging = false
      end

      -- Damage dealt evaluation with hybrid learning and feature weight adaptation
      local currentTargetHealth = AI.State.targetHumanoid.Health
      -- Safety check: Ensure lastTargetHealth is initialized
      if AI.State.lastTargetHealth == nil then
          AI.State.lastTargetHealth = currentTargetHealth
          if CONST and CONST.DEBUG_MODE then
              warn("UpdateLearningAndRewards: lastTargetHealth was nil, initialized to current target health")
          end
      end
      local damageDealt = AI.State.lastTargetHealth - currentTargetHealth
      if damageDealt > 0 then
          -- Track when damage was dealt
          AI.State.lastDamageDealtTime = now
          
          local action = AI.State.lastAction
          local reward
          
          -- Anomaly detection for unexpected damage sources
          if action ~= "ATTACK" and action ~= "SPECIAL" then
              print(`ANOMALY: Damage (${damageDealt}) dealt via ${action}. High reward!`)
              reward = CONST.REWARD_ANOMALOUS_DAMAGE
          else
              reward = damageDealt * CONST.REWARD_DAMAGE_DEALT_MULTIPLIER
              
              -- Enhanced combo tracking and rewards with improved exponential scaling
              local comboActive = now < AI.State.comboStateEndTime
              if comboActive then
                  AI.State.comboCount += 1
                  AI.State.consecutiveHits += 1
                  AI.State.lastComboTime = now
                  -- Improved progressive combo multiplier with stronger exponential growth
                  -- Formula: 1.0 + (count * 0.19) + (count^1.20 * 0.05)
                  local linearBonus = AI.State.comboCount * 0.19
                  local exponentialBonus = (AI.State.comboCount ^ 1.20) * 0.05
                  local comboMultiplier = 1.0 + linearBonus + exponentialBonus
                  reward *= math.min(comboMultiplier, 3.0) -- Higher cap at 3.0x for better high-combo rewards
                  
                  -- Try side dash tech during combos for better positioning
                  if AI.State.comboCount >= 2 then
                      task.delay(0.1, function()
                          CombatTech.sideDashTech()
                      end)
                  end
                  
                  if CONST.DEBUG_COMBOS then
                      print(`Combo x${AI.State.comboCount}! Damage: ${damageDealt}, Multiplier: ${string.format("%.2f", comboMultiplier)}x`)
                  end
              else
                  -- Start new combo if window expired
                  if CONST.DEBUG_COMBOS and AI.State.comboCount > 0 then
                      print(`Combo ended at x${AI.State.comboCount}`)
                  end
                  AI.State.comboCount = 1 -- Start at 1 to reward combo initiation
                  AI.State.consecutiveHits = 1
                  AI.State.lastComboTime = now
                  if CONST.DEBUG_COMBOS then
                      print(`New combo started! Damage: ${damageDealt}`)
                  end
              end
              
              -- Bonus for exploiting opportunity windows with better scaling
              if now < AI.State.punishWindowEndTime then
                  reward *= 1.4 -- Increased from 1.35
              end
              if now < AI.State.glitchComboWindowEndTime then
                  reward *= 1.45 -- Increased bonus for glitch exploitation
              end
              -- Bonus for efficient damage (high damage with low energy cost) with better thresholds
              local efficiency = damageDealt / (1 + (CONST.COSTS[action] or 0))
              if efficiency > 14 then
                  reward *= 1.35 -- Even better efficiency bonus
              elseif efficiency > 10 then
                  reward *= 1.25 -- Better efficiency bonus
              elseif efficiency > 7 then
                  reward *= 1.15
              end
              -- Bonus for momentum (consecutive successful hits with improved scaling)
              if AI.State.consecutiveHits >= 5 then
                  reward *= (1 + AI.State.consecutiveHits * 0.16) -- Better momentum scaling
              elseif AI.State.consecutiveHits >= 3 then
                  reward *= (1 + AI.State.consecutiveHits * 0.12)
              end
              
              -- Update current state history entry with actual reward
              if #AI.State.stateHistory > 0 then
                  AI.State.stateHistory[#AI.State.stateHistory].reward = reward
              end
              
              -- Track performance for adaptive learning rate
              table.insert(AI.State.recentPerformance, reward)
              if #AI.State.recentPerformance > CONST.PERFORMANCE_WINDOW then
                  table.remove(AI.State.recentPerformance, 1)
              end
          end

          -- Build next state for deep learning
          local nextState = {
              myHealthPercent = humanoid.Health / humanoid.MaxHealth,
              targetHealthPercent = AI.State.targetHumanoid.Health / AI.State.targetHumanoid.MaxHealth,
              distance = (rootPart.Position - AI.State.targetTorso.Position).Magnitude,
              energy = AI.State.currentEnergy,
              inRange = (rootPart.Position - AI.State.targetTorso.Position).Magnitude <= CONST.ATTACK_RANGE,
              isTargetAttacking = AI.State.isTargetAttacking,
          }
          
          -- Reinforce with next state for deep learning
          AI.Learning.Reinforce(tactic, action, reward, nextState)

          -- Extend combo window
          AI.State.comboStateEndTime = now + CONST.COMBO_WINDOW_DURATION
          
          -- Update momentum-based adaptation (hot state tracking)
          AI.Learning.UpdateMomentumState(AI.State.consecutiveHits)
          
          -- Get active weights (opponent-specific or frozen if in hot state)
          local activeWeights = AI.FeatureWeights
          if AI.MomentumAdaptation.isInHotState and AI.MomentumAdaptation.frozenFeatureWeights then
              -- In hot state: don't update weights (use frozen)
              activeWeights = AI.MomentumAdaptation.frozenFeatureWeights
          elseif AI.OpponentModel.activeWeights then
              -- Use opponent-specific weights
              activeWeights = AI.OpponentModel.activeWeights
          end
          
          -- Only update weights if not in hot state
          if not AI.MomentumAdaptation.isInHotState then
              -- Get adaptive multipliers based on volatility
              local successMult = AI.MetaLearning.adaptiveSuccessMultiplier
              local decayMult = AI.MetaLearning.adaptiveDecayMultiplier
              
              -- Adaptive feature weight tuning based on success
              activeWeights.tacticSuccess = math.min(2.5, activeWeights.tacticSuccess * successMult)
              activeWeights.comboDensity = math.min(2.0, activeWeights.comboDensity * (successMult * 0.97))
              activeWeights.opportunityWindow = math.min(2.2, activeWeights.opportunityWindow * (successMult * 0.98))
              
              -- Adjust feature weights based on context
              if now < AI.State.punishWindowEndTime then
                  activeWeights.opportunityWindow = math.min(2.5, activeWeights.opportunityWindow * 1.1)
              end
          end
          
          -- Track zone adaptation (damage at this distance)
          local currentDist = nextState.distance or 0
          AI.Learning.UpdateZoneAdaptation(currentDist, damageDealt, false)
      else
          -- Get active weights
          local activeWeights = AI.FeatureWeights
          if AI.OpponentModel.activeWeights then
              activeWeights = AI.OpponentModel.activeWeights
          end
          
          -- Only decay if not in hot state
          if not AI.MomentumAdaptation.isInHotState then
              -- Get adaptive decay multiplier
              local decayMult = AI.MetaLearning.adaptiveDecayMultiplier
              
              -- Decay feature weights if no damage (adaptive forgetting)
              activeWeights.tacticSuccess = math.max(0.4, activeWeights.tacticSuccess * decayMult)
              activeWeights.comboDensity = math.max(0.5, activeWeights.comboDensity * (decayMult + 0.002))
          end
          
          -- Reset combo if too much time has passed without damage (improved timing)
          if AI.State.comboCount > 0 and now - AI.State.lastComboTime > CONST.COMBO_WINDOW_DURATION then
              if CONST.DEBUG_COMBOS then
                  print(`Combo timeout! Lost x${AI.State.comboCount} combo (${string.format("%.2f", now - AI.State.lastComboTime)}s since last hit)`)
              end
              AI.State.comboCount = 0
              AI.State.consecutiveHits = 0
              AI.State.comboStateEndTime = 0
              
              -- Exit hot state if combo ended
              if AI.MomentumAdaptation.isInHotState then
                  AI.MomentumAdaptation.isInHotState = false
                  AI.MomentumAdaptation.frozenFeatureWeights = nil
                  print(`❄️ HOT STATE ENDED (Combo timeout)`)
              end
          end
      end
      
      AI.State.lastTargetHealth = currentTargetHealth
  end

  local function ExecuteCombatLogic(now)
      if AI.State.combatState ~= "ENGAGING" or AI.State.isFeinting then return end
      if not (AI.State.targetTorso and AI.State.targetTorso.Parent and AI.State.targetHumanoid) then return end

      -- Ultra-optimized prediction with aggressive caching and better velocity prediction
      -- Only recalculate if: no cache exists, enough time has passed, OR target moved significantly
      local targetMoved = AI.State.lastTargetPosition and AI.State.targetTorso and
          (AI.State.targetTorso.Position - AI.State.lastTargetPosition).Magnitude > 3
      local shouldRecalcPrediction = not AI.State.cachedPredictedPos or 
          (now - AI.State.lastPredictionTime) > 0.055 or 
          targetMoved
      if shouldRecalcPrediction then
          -- PING/LATENCY ADAPTIVE INPUT (#8): Use tracked ping for adaptive prediction
          local ping = AI.State.currentPing or player:GetNetworkPing()
          local velocity = AI.State.targetTorso.AssemblyLinearVelocity
          
          -- Safety check for velocity
          if not velocity then
              velocity = Vector3.new(0, 0, 0)
          end
          
          local velocityMag = velocity.Magnitude
          
          -- Adaptive prediction time based on velocity and ping (#8)
          -- High ping (200ms) needs more lead time than low ping (50ms)
          local basePrediction = CONST.BASE_PREDICTION_TIME + ping * CONST.PING_PREDICTION_MULTIPLIER
          
          -- Improved velocity-based prediction with smoother gradient scaling
          local velocityFactor = 1.0
          if velocityMag > 60 then
              velocityFactor = 1.42 -- Ultra-fast targets need even more lead
          elseif velocityMag > 50 then
              velocityFactor = 1.35 -- Much faster targets need more lead
          elseif velocityMag > 35 then
              velocityFactor = 1.25
          elseif velocityMag > 20 then
              velocityFactor = 1.15
          elseif velocityMag > 10 then
              velocityFactor = 1.08 -- Slight lead for moderate speeds
          end
          
          local predictionTime = basePrediction * velocityFactor
          
          -- Enhanced acceleration estimation with better weighting for prediction accuracy
          if AI.State.lastTargetVelocity then
              local accel = velocity - AI.State.lastTargetVelocity
              local accelMag = accel.Magnitude
              if accelMag > 8 then -- Target is heavily accelerating
                  AI.State.cachedPredictedPos = AI.State.targetTorso.Position + 
                      velocity * predictionTime + 
                      accel * (predictionTime * 0.6) -- Stronger acceleration term
              elseif accelMag > 5 then -- Target is accelerating
                  AI.State.cachedPredictedPos = AI.State.targetTorso.Position + 
                      velocity * predictionTime + 
                      accel * (predictionTime * 0.5) -- Acceleration term
              else
                  AI.State.cachedPredictedPos = AI.State.targetTorso.Position + velocity * predictionTime
              end
          else
              AI.State.cachedPredictedPos = AI.State.targetTorso.Position + velocity * predictionTime
          end
          
          AI.State.lastTargetVelocity = velocity
          AI.State.lastTargetPosition = AI.State.targetTorso.Position
          AI.State.lastPredictionTime = now
      end
      
      -- Ultra-fast aim update (single operation)
      local targetPos = AI.State.cachedPredictedPos
      rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(targetPos.X, rootPart.Position.Y, targetPos.Z))

      -- Pre-calculate values once for entire decision cycle
      local distance = (rootPart.Position - AI.State.targetTorso.Position).Magnitude
      local myHealthPercent = humanoid.Health / humanoid.MaxHealth
      local targetHealthPercent = AI.State.targetHumanoid.Health / AI.State.targetHumanoid.MaxHealth
      
      -- Build current state object for decision making (ultra-optimized)
      local state = {
          myHealthPercent = myHealthPercent,
          targetHealthPercent = targetHealthPercent,
          distance = distance,
          energy = AI.State.currentEnergy,
          inRange = distance <= CONST.ATTACK_RANGE,
          isTargetAttacking = AI.State.isTargetAttacking,
          -- Raycast/Map Awareness (#7)
          isCornered = AI.State.isCornered,
          wallRaycasts = AI.State.wallRaycasts,
          -- Ping/Latency (#8)
          currentPing = AI.State.currentPing,
      }
      
      -- Check target ragdoll/stunned state (for ultimate timing)
      if AI.State.targetHumanoid then
          local targetState = AI.State.targetHumanoid:GetState()
          AI.State.targetIsRagdolled = targetState == Enum.HumanoidStateType.Ragdoll or 
                                       targetState == Enum.HumanoidStateType.FallingDown or
                                       targetState == Enum.HumanoidStateType.Flying
          AI.State.targetIsStunned = AI.State.targetIsRagdolled or 
                                     (AI.State.targetTorso.AssemblyLinearVelocity and 
                                      AI.State.targetTorso.AssemblyLinearVelocity.Magnitude < 5 and
                                      not AI.State.isTargetAttacking)
      end
      
      -- Priority: Auto-Awakening Logic (if not already awakened)
      if not AI.State.isAwakened and not AI.State.awakenAttempted then
          local shouldAwaken = false
          local awakenReason = ""
          
          -- Condition 1: Critical HP (< 30%)
          if myHealthPercent < CONST.AUTO_AWAKEN_HP_THRESHOLD then
              shouldAwaken = true
              awakenReason = "Critical HP"
          end
          
          -- Condition 2: Awakening bar full AND opponent stunned/ragdolled
          -- Note: We can't directly check awakening bar, so we assume it's available after taking some damage
          -- In a real implementation, you'd check for a GUI element or character value
          if myHealthPercent < 0.7 and AI.State.targetIsStunned then
              shouldAwaken = true
              awakenReason = "Opponent Stunned + Bar Ready"
          end
          
          -- Execute awakening if conditions met and cooldown passed
          if shouldAwaken and (now - AI.State.lastActionTimes.AWAKEN) > CONST.AWAKEN_COOLDOWN then
              if communicateEvent then
                  communicateEvent:FireServer({["Goal"]="KeyPress", ["Key"]=CONST.AWAKEN_KEY})
                  task.wait(0.1) -- Brief wait for activation
                  communicateEvent:FireServer({["Goal"]="KeyRelease", ["Key"]=CONST.AWAKEN_KEY})
              end
              AI.State.lastActionTimes.AWAKEN = now
              AI.State.awakenAttempted = true
              AI.State.isAwakened = true -- Assume success (can be refined with actual checks)
              print("🔥 AUTO-AWAKENED! Reason:", awakenReason)
          end
      end
      
      -- Priority: Ultimate Finisher Logic (only when target is vulnerable)
      if AI.State.isAwakened and (now - AI.State.lastUltimateTime) > CONST.ULTIMATE_COOLDOWN then
          local shouldUseUltimate = false
          local ultimateReason = ""
          
          -- Condition 1: Target is ragdolled (guaranteed hit)
          if AI.State.targetIsRagdolled and distance < CONST.ATTACK_RANGE * 1.5 then
              shouldUseUltimate = true
              ultimateReason = "Target Ragdolled"
          end
          
          -- Condition 2: Target is stunned/low mobility
          if AI.State.targetIsStunned and distance < CONST.ATTACK_RANGE and state.energy >= CONST.ULTIMATE_ENERGY_COST then
              shouldUseUltimate = true
              ultimateReason = "Target Stunned"
          end
          
          -- Condition 3: Target very low HP and in range (finisher)
          if targetHealthPercent < 0.15 and distance < CONST.ATTACK_RANGE * 1.2 then
              shouldUseUltimate = true
              ultimateReason = "Finisher (Low HP)"
          end
          
          -- Execute ultimate if conditions met
          if shouldUseUltimate and state.energy >= CONST.ULTIMATE_ENERGY_COST then
              if communicateEvent then
                  communicateEvent:FireServer({["Goal"]="KeyPress", ["Key"]=CONST.ULTIMATE_KEY})
                  task.wait(0.1) -- Brief wait for activation
                  communicateEvent:FireServer({["Goal"]="KeyRelease", ["Key"]=CONST.ULTIMATE_KEY})
              end
              AI.State.lastUltimateTime = now
              AI.State.currentEnergy -= CONST.ULTIMATE_ENERGY_COST
              print("💥 ULTIMATE USED! Reason:", ultimateReason)
              return -- Skip normal action this frame
          end
      end

      -- Single-pass decision pipeline (normal actions)
      AI.State.currentTactic = AI.Evaluation.ChooseTactic(state)
      local bestAction = AI.Evaluation.FindBestActionByScore(state, AI.State.currentTactic)
      AI.Actions.Execute(bestAction, state)
  end

  --// ================= EVENT CONNECTIONS ================= //
  table.insert(connections, humanoid.HealthChanged:Connect(function(newHealth)
      -- Safety check: Ensure myHealth is initialized
      if AI.State.myHealth == nil then
          AI.State.myHealth = humanoid.Health or newHealth
          if CONST and CONST.DEBUG_MODE then
              warn("HealthChanged: AI.State.myHealth was nil, initialized to current health")
          end
      end
      
      local damageTaken = AI.State.myHealth - newHealth
      
      -- Build current state
      local currentState = nil
      if AI.State.targetHumanoid and AI.State.targetTorso then
          currentState = {
              myHealthPercent = newHealth / humanoid.MaxHealth,
              targetHealthPercent = AI.State.targetHumanoid.Health / AI.State.targetHumanoid.MaxHealth,
              distance = (rootPart.Position - AI.State.targetTorso.Position).Magnitude,
              energy = AI.State.currentEnergy,
              inRange = (rootPart.Position - AI.State.targetTorso.Position).Magnitude <= CONST.ATTACK_RANGE,
              isTargetAttacking = AI.State.isTargetAttacking,
          }
      end
      
      if damageTaken > 0 then
          local penalty = damageTaken * CONST.PENALTY_DAMAGE_TAKEN_MULTIPLIER
          local failedAction = AI.State.lastAction
          
          -- Break combo on damage taken
          if AI.State.comboCount > 0 then
              -- Extra penalty for losing a good combo (calculate before reset)
              local comboPenalty = AI.State.comboCount * 0.1
              penalty *= (1 + comboPenalty)
              if CONST.DEBUG_MODE then
                  print(`Combo broken by damage! Lost x${AI.State.comboCount} combo`)
              end
              AI.State.comboCount = 0
              AI.State.consecutiveHits = 0
          end
          
          if AI.State.isPerfectDodging and os.clock() > AI.State.dodgeStartTime then -- Check if dodge was active
              failedAction = "EVADE"
              -- Stronger penalty for failed dodges
              AI.Learning.Reinforce(AI.State.currentTactic, "EVADE", CONST.PENALTY_FAILED_ACTION * 1.5, currentState)
          elseif AI.State.isBlocking then
              -- Failed block - took damage while blocking
              failedAction = "BLOCK"
              AI.Learning.Reinforce(AI.State.currentTactic, "BLOCK", CONST.PENALTY_FAILED_ACTION * 1.3, currentState)
              -- Release block since it failed
              if communicateEvent then
                  communicateEvent:FireServer({["Goal"]="KeyRelease", ["Key"]=Enum.KeyCode.F})
              end
              AI.State.isBlocking = false
              print("Block failed - took damage")
          else
              AI.Learning.Reinforce(AI.State.currentTactic, failedAction, penalty, currentState)
          end
          AI.State.isPerfectDodging = false
          
          -- Track negative performance
          table.insert(AI.State.recentPerformance, penalty)
          if #AI.State.recentPerformance > CONST.PERFORMANCE_WINDOW then
              table.remove(AI.State.recentPerformance, 1)
          end
      elseif AI.State.isPerfectDodging and AI.State.isTargetAttacking then
          -- Perfect dodge reward with bonus based on how aggressive opponent was
          local dodgeReward = CONST.REWARD_PERFECT_DODGE
          if AI.OpponentModel.aggressionScore > 0.7 then
              dodgeReward *= 1.3 -- Extra reward for dodging aggressive opponents
          end
          AI.Learning.Reinforce(AI.State.currentTactic, "EVADE", dodgeReward, currentState)
          AI.State.punishWindowEndTime = os.clock() + CONST.PUNISH_WINDOW_DURATION
          print("Perfect Dodge! Opening Punish Window.")
          AI.State.isPerfectDodging = false
          
          -- Track positive performance
          table.insert(AI.State.recentPerformance, dodgeReward)
          if #AI.State.recentPerformance > CONST.PERFORMANCE_WINDOW then
              table.remove(AI.State.recentPerformance, 1)
          end
      end
      AI.State.myHealth = newHealth
  end))

  table.insert(connections, LogService.MessageOut:Connect(function(message, messageType)
      if messageType == Enum.MessageType.MessageError and not AI.GlitchScanner.isGlitchDetected then
          local now = os.clock()
          AI.GlitchScanner.isGlitchDetected = true
          AI.GlitchScanner.glitchType = "Game Script Error"
          AI.GlitchScanner.detectionTime = now
          AI.State.glitchComboWindowEndTime = now + CONST.GLITCH_COMBO_WINDOW_DURATION
      end
  end))

  table.insert(connections, humanoid.Died:Connect(function()
      AI.Score -= 10
      print(`Project Apex defeated. New Score: {AI.Score}.`)
      -- Update DDA on death
      AI.Learning.UpdateDDA(false) -- We lost
      -- Track zone where we died
      if AI.State.targetTorso and rootPart then
          local deathDistance = (rootPart.Position - AI.State.targetTorso.Position).Magnitude
          AI.Learning.UpdateZoneAdaptation(deathDistance, 0, true)
      end
      -- Train Win Probability Estimator on match defeat
      if AI.WinProbabilityEstimator.enabled then
          AI.DeepLearning.TrainOnMatchEnd(false) -- We lost
      end
      -- Update self-play statistics if training against clone
      AI.DeepLearning.UpdateSelfPlayStats(false)
      -- Save AI data on death with error handling
      local saveSuccess, saveErr = LocalPersistence:SaveData(AI)
      if not saveSuccess and saveErr ~= "Save on cooldown" and saveErr ~= "File system not supported" then
          warn("⚠️ Failed to save AI data on death:", saveErr)
      end
      Cleanup()
  end))
  table.insert(connections, character.AncestryChanged:Connect(function(_, parent)
      if not parent then Cleanup() end
  end))

  -- The main heartbeat loop that drives the AI.
  table.insert(connections, RunService.Heartbeat:Connect(function(deltaTime)
      local success, err = pcall(function()
          local now = os.clock()
          -- Guard against invalid deltaTime
          if isValidDeltaTime(deltaTime) then
              UpdateAIState(deltaTime)
          end
          UpdateLearningAndRewards(now)
          ExecuteCombatLogic(now)
      end)
      if not success then
          warn("Project Apex encountered an error in its main loop:", err)
          -- Attempt to recover by resetting volatile state
          if humanoid and humanoid.Health > 0 then
              AI.State.combatState = "IDLE"
              AI.State.isFeinting = false
              AI.State.isPerfectDodging = false
              AI.State.isBlocking = false
          end
      end
  end))
  
  -- Create Training GUI
  CreateTrainingGUI(character, rootPart)
  
  -- Create ESP & Debug HUD
  local espHUD = CreateESPAndDebugHUD()
  
  -- Add HUD and ESP update to heartbeat loop
  table.insert(connections, RunService.Heartbeat:Connect(function()
      -- Update HUD every frame
      pcall(function()
          espHUD.UpdateHUD()
      end)
  end))
  
  -- Add ESP update on a slower interval (for performance)
  local lastESPUpdate = 0
  table.insert(connections, RunService.Heartbeat:Connect(function()
      local now = os.clock()
      if now - lastESPUpdate > 0.1 then -- Update ESP 10 times per second
          pcall(function()
              espHUD.UpdateESP()
          end)
          lastESPUpdate = now
      end
  end))
end

--// ================= SCRIPT ENTRY POINT ================= //
-- Connect the initialization function to the CharacterAdded event.
player.CharacterAdded:Connect(initializeCombatSystem)
-- If the character already exists when the script runs, initialize immediately.
if player.Character then
  initializeCombatSystem(player.Character)
end
