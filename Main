  -- CHARACTER-SPECIFIC MODELS: Save current weights for character
  function AI.Learning.SaveCharacterModel()
      local models = AI.CharacterModels
      if models.currentCharacter ~= "Unknown" and models.activeModel then
          -- Weights are already in sync (we're pointing to the same table)
          -- Just log for confirmation
          print(`Character model saved for: {models.currentCharacter} (Trials: {AI.ActionStats.totalTrials})`)
          
          -- Trigger local file save with error handling
          local success, err = LocalPersistence:SaveData(AI)
          if not success and err ~= "Save on cooldown" and err ~= "File system not supported" then
              warn("⚠️ Character model file save failed:", err)
          end
      end
  end

