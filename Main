      patterns = {}, -- Learned action sequences
      patternConfidence = {},
      -- Attention mechanism for recent actions
      attentionWeights = {},
  },
  --// CURIOSITY MODULE: Intrinsic motivation for exploration with ICM
  CuriosityModule = {
      -- State visitation counts for novelty detection
      stateVisits = {},
      -- Prediction error for curiosity reward
      predictionErrors = {},
      curiosityWeight = 0.15,
      -- ICM Forward Model (predicts next state from current state and action)
      forwardModel = {
          layer1 = { weights = {}, biases = {}, size = 16, activations = {}, gradients = {} },
          layer2 = { weights = {}, biases = {}, size = 16, activations = {}, gradients = {} },
      },
      -- ICM Inverse Model (predicts action from state transition)
      inverseModel = {
          layer1 = { weights = {}, biases = {}, size = 16, activations = {}, gradients = {} },
          layer2 = { weights = {}, biases = {}, size = 7, activations = {}, gradients = {} }, -- Output: action logits
      },
      -- State encoder for novelty detection
      stateEncoder = {
          layer1 = { weights = {}, biases = {}, size = 12, activations = {}, gradients = {} },
          layer2 = { weights = {}, biases = {}, size = 8, activations = {}, gradients = {} },
      },
      -- ICM loss weights
      forwardLossWeight = 0.2,
      inverseLossWeight = 0.8,
  },
  --// DISTRIBUTIONAL RL: Quantile regression for value distribution
  DistributionalRL = {
      enabled = true,
      numQuantiles = 5, -- Number of quantile values to estimate
      quantileNet = {
          layer1 = { weights = {}, biases = {}, size = 32, activations = {}, gradients = {} },
          layer2 = { weights = {}, biases = {}, size = 24, activations = {}, gradients = {} },
          layer3 = { weights = {}, biases = {}, size = 35, activations = {}, gradients = {} }, -- 7 actions * 5 quantiles
      },
      quantiles = {}, -- Cached quantile predictions
      kappa = 1.0, -- Huber loss threshold
  },
  --// HINDSIGHT EXPERIENCE REPLAY: Learn from failures
  HindsightER = {
      enabled = true,
      strategy = "future", -- Can be "future", "final", "episode"
      k = 4, -- Number of HER goals to generate per experience
  },
  --// STATE NORMALIZATION: Running statistics for better convergence
  StateNormalization = {
      enabled = true,
      mean = {},
      variance = {},
      count = 0,
      epsilon = 1e-8,
  },
  --// ATTENTION MECHANISM: Multi-head attention for opponent modeling
  AttentionModule = {
      enabled = true,
      numHeads = 2,
      headDim = 8,
      queryWeights = {},
      keyWeights = {},
      valueWeights = {},
      outputWeights = {},
      -- Cached attention scores
      attentionScores = {},
  },
  Evaluation = {},
  Actions = {},
  Learning = {},
  DeepLearning = {} -- New module for deep learning functions
}

--// ================= DEEP LEARNING UTILITIES ================= //

-- Initialize neural network weights using He initialization
local function InitializeNetwork(network, inputSize)
    for layerName, layer in pairs(network) do
        if type(layer) == "table" and layer.weights then
            layer.weights = {}
            layer.biases = {}
            layer.activations = {}
            layer.gradients = {}
            local prevSize = (layerName == "layer1") and inputSize or network[layerName:sub(1, -2) .. (tonumber(layerName:sub(-1)) - 1)].size
            
            -- He initialization for better gradient flow
            local stddev = math.sqrt(2.0 / prevSize)
            for i = 1, layer.size do
                layer.weights[i] = {}
                for j = 1, prevSize do
                    layer.weights[i][j] = (math.random() * 2 - 1) * stddev
                end
                layer.biases[i] = 0
                layer.activations[i] = 0
                layer.gradients[i] = 0
            end
            
            -- Initialize layer normalization parameters
            if layer.layerNormGain then
                layer.layerNormGain = {}
                layer.layerNormBias = {}
                for i = 1, layer.size do
                    layer.layerNormGain[i] = 1
                    layer.layerNormBias[i] = 0
                end
            end
        end
    end
end

-- Backpropagation through a single layer
local function BackwardLayer(layer, nextLayer, outputGradients, inputs, activation)
    local inputGradients = {}
    
    -- Initialize input gradients
    for j = 1, #inputs do
        inputGradients[j] = 0
    end
    
    -- Compute gradients with respect to weights, biases, and inputs
    for i = 1, layer.size do
        local outputGrad = outputGradients[i]
        
        -- Apply activation derivative
        if activation then
            local a = layer.activations[i]
            if activation == ReLU or activation == LeakyReLU then
                outputGrad = a > 0 and outputGrad or (outputGrad * 0.01)
            elseif activation == Tanh then
                outputGrad = outputGrad * (1 - a * a)
            elseif activation == Sigmoid then
                outputGrad = outputGrad * a * (1 - a)
            end
        end
        
        -- Store gradient for this neuron
        layer.gradients[i] = outputGrad
        
        -- Accumulate gradients for inputs (backprop to previous layer)
        for j = 1, #inputs do
            inputGradients[j] += outputGrad * layer.weights[i][j]
        end
    end
    
    return inputGradients
end

-- Update network weights using Adam optimizer
local function UpdateNetworkWeights(network, inputs, learningRate, clipNorm)
    learningRate = learningRate or AI.DeepNetwork.learningRateDNN
    clipNorm = clipNorm or AI.DeepNetwork.gradientClipNorm
    
    for layerName, layer in pairs(network) do
        if type(layer) == "table" and layer.weights and layer.gradients then
            -- Get previous layer outputs (inputs to this layer)
            local layerInputs = inputs
            if layerName ~= "layer1" then
                local prevLayerName = layerName:sub(1, -2) .. (tonumber(layerName:sub(-1)) - 1)
                layerInputs = network[prevLayerName].activations
            end
            
            -- Initialize velocity if not exists (for Adam)
            if not AI.DeepNetwork.velocities[layerName] then
                AI.DeepNetwork.velocities[layerName] = {
                    weights = {},
                    biases = {},
                    m_weights = {}, -- First moment
                    v_weights = {}, -- Second moment
                    m_biases = {},
                    v_biases = {},
                    t = 0, -- Time step
                }
                for i = 1, layer.size do
                    AI.DeepNetwork.velocities[layerName].weights[i] = {}
                    AI.DeepNetwork.velocities[layerName].m_weights[i] = {}
                    AI.DeepNetwork.velocities[layerName].v_weights[i] = {}
                    for j = 1, #layer.weights[i] do
                        AI.DeepNetwork.velocities[layerName].weights[i][j] = 0
                        AI.DeepNetwork.velocities[layerName].m_weights[i][j] = 0
                        AI.DeepNetwork.velocities[layerName].v_weights[i][j] = 0
                    end
                    AI.DeepNetwork.velocities[layerName].biases[i] = 0
                    AI.DeepNetwork.velocities[layerName].m_biases[i] = 0
                    AI.DeepNetwork.velocities[layerName].v_biases[i] = 0
                end
            end
            
            local vel = AI.DeepNetwork.velocities[layerName]
            vel.t += 1
            
            -- Update weights and biases using Adam
            for i = 1, layer.size do
                local grad = layer.gradients[i]
                
                -- Clip gradient
                if math.abs(grad) > clipNorm then
                    grad = grad > 0 and clipNorm or -clipNorm
                end
                
                -- Update bias with Adam
                vel.m_biases[i] = AI.DeepNetwork.adamBeta1 * vel.m_biases[i] + (1 - AI.DeepNetwork.adamBeta1) * grad
                vel.v_biases[i] = AI.DeepNetwork.adamBeta2 * vel.v_biases[i] + (1 - AI.DeepNetwork.adamBeta2) * grad * grad
                
                local m_hat = vel.m_biases[i] / (1 - AI.DeepNetwork.adamBeta1 ^ vel.t)
                local v_hat = vel.v_biases[i] / (1 - AI.DeepNetwork.adamBeta2 ^ vel.t)
                
                layer.biases[i] = layer.biases[i] - learningRate * m_hat / (math.sqrt(v_hat) + AI.DeepNetwork.adamEpsilon)
                
                -- Update weights with Adam
                for j = 1, #layer.weights[i] do
                    local weightGrad = grad * layerInputs[j]
                    
                    vel.m_weights[i][j] = AI.DeepNetwork.adamBeta1 * vel.m_weights[i][j] + (1 - AI.DeepNetwork.adamBeta1) * weightGrad
                    vel.v_weights[i][j] = AI.DeepNetwork.adamBeta2 * vel.v_weights[i][j] + (1 - AI.DeepNetwork.adamBeta2) * weightGrad * weightGrad
                    
                    local m_hat_w = vel.m_weights[i][j] / (1 - AI.DeepNetwork.adamBeta1 ^ vel.t)
                    local v_hat_w = vel.v_weights[i][j] / (1 - AI.DeepNetwork.adamBeta2 ^ vel.t)
                    
                    layer.weights[i][j] = layer.weights[i][j] - learningRate * m_hat_w / (math.sqrt(v_hat_w) + AI.DeepNetwork.adamEpsilon)
                end
            end
        end
    end
end

-- ReLU activation function
local function ReLU(x)
    return math.max(0, x)
end

-- Leaky ReLU for better gradient flow
local function LeakyReLU(x, alpha)
    alpha = alpha or 0.01
    return x > 0 and x or alpha * x
end

-- Tanh activation for bounded outputs
local function Tanh(x)
    local exp2x = math.exp(2 * x)
    return (exp2x - 1) / (exp2x + 1)
end

-- Helper function to find max value in array (safer than table.unpack for large arrays)
local function FindMax(arr)
    if #arr == 0 then return 0 end
    local maxVal = arr[1]
    for i = 2, #arr do
        if arr[i] > maxVal then
            maxVal = arr[i]
        end
    end
    return maxVal
end

-- Softmax for probability distributions
local function Softmax(outputs)
    if #outputs == 0 then return {} end
    
    local maxVal = FindMax(outputs)
    local expSum = 0
    local result = {}
    
    for i, val in ipairs(outputs) do
        result[i] = math.exp(val - maxVal)
        expSum += result[i]
    end
    
    -- Prevent division by zero (this can happen if all values are extremely negative)
    if expSum == 0 then
        -- Return uniform distribution
        local n = #outputs
        for i = 1, n do
            result[i] = 1 / n
        end
    else
        for i = 1, #result do
            result[i] = result[i] / expSum
        end
    end
    
    return result
end

-- Sigmoid activation
local function Sigmoid(x)
    return 1 / (1 + math.exp(-math.max(-50, math.min(50, x))))
end

-- Layer Normalization (better than batch norm for RL)
local function LayerNorm(inputs, gain, bias, epsilon)
    epsilon = epsilon or 1e-5
    local n = #inputs
    
    -- Calculate mean
    local mean = 0
    for i = 1, n do
        mean += inputs[i]
    end
    mean = mean / n
    
    -- Calculate variance
    local variance = 0
    for i = 1, n do
        local diff = inputs[i] - mean
        variance += diff * diff
    end
    variance = variance / n
    
    -- Normalize
    local normalized = {}
    local stddev = math.sqrt(variance + epsilon)
    for i = 1, n do
        local norm = (inputs[i] - mean) / stddev
        normalized[i] = norm * (gain and gain[i] or 1) + (bias and bias[i] or 0)
    end
    
    return normalized
end

-- Gradient clipping by norm
local function ClipGradientNorm(gradients, maxNorm)
    local norm = 0
    for _, grad in ipairs(gradients) do
        norm += grad * grad
    end
    norm = math.sqrt(norm)
    
    if norm > maxNorm then
        local scale = maxNorm / norm
        local clipped = {}
        for i, grad in ipairs(gradients) do
            clipped[i] = grad * scale
        end
        return clipped
    end
    
    return gradients
end

-- Huber loss (used in quantile regression)
local function HuberLoss(error, kappa)
    local absError = math.abs(error)
    if absError <= kappa then
        return 0.5 * error * error
    else
        return kappa * (absError - 0.5 * kappa)
    end
end

-- Forward pass through a network layer with enhanced features
local function ForwardLayer(layer, inputs, activation, useLayerNorm, useNoise, saveActivations)
    activation = activation or ReLU
    useLayerNorm = useLayerNorm == nil and true or useLayerNorm
    saveActivations = saveActivations == nil and true or saveActivations
    local outputs = {}
    
    for i = 1, layer.size do
        local sum = layer.biases[i]
        for j = 1, #inputs do
            local weight = layer.weights[i][j]
            
            -- Add parametric noise (Noisy Networks) if enabled
            if useNoise and AI.DeepNetwork.noisyNets.enabled then
                local noise = (math.random() * 2 - 1) * AI.DeepNetwork.noisyNets.sigma0
                weight = weight + noise * math.abs(weight)
            end
            
            sum += weight * inputs[j]
        end
        outputs[i] = sum
    end
    
    -- Apply layer normalization before activation
    if useLayerNorm and layer.layerNormGain then
        outputs = LayerNorm(outputs, layer.layerNormGain, layer.layerNormBias, AI.DeepNetwork.layerNorm.epsilon)
    end
    
    -- Apply activation and save pre-activation values
    for i = 1, #outputs do
        local preActivation = outputs[i]
        outputs[i] = activation(preActivation)
        
        -- Save activations for backpropagation
        if saveActivations and layer.activations then
            layer.activations[i] = outputs[i]
        end
    end
    
    return outputs
end

-- Initialize Deep Neural Networks
local function InitializeDeepNetworks()
    InitializeNetwork(AI.DeepNetwork.valueNet, AI.DeepNetwork.inputSize)
    InitializeNetwork(AI.DeepNetwork.advantageNet, AI.DeepNetwork.inputSize)
    InitializeNetwork(AI.DeepNetwork.targetValueNet, AI.DeepNetwork.inputSize)
    InitializeNetwork(AI.DeepNetwork.targetAdvantageNet, AI.DeepNetwork.inputSize)
    InitializeNetwork(AI.DeepNetwork.policyNet, AI.DeepNetwork.inputSize)
    InitializeNetwork(AI.CuriosityModule.stateEncoder, AI.DeepNetwork.inputSize)
    
    -- Initialize ICM networks
    InitializeNetwork(AI.CuriosityModule.forwardModel, AI.DeepNetwork.inputSize + 5) -- state + action
    InitializeNetwork(AI.CuriosityModule.inverseModel, AI.DeepNetwork.inputSize * 2) -- current + next state
    
    -- Initialize distributional RL network
    if AI.DistributionalRL.enabled then
        InitializeNetwork(AI.DistributionalRL.quantileNet, AI.DeepNetwork.inputSize)
    end
    
    -- Initialize attention mechanism
    if AI.AttentionModule.enabled then
        local totalDim = AI.AttentionModule.numHeads * AI.AttentionModule.headDim
        AI.AttentionModule.queryWeights = {}
        AI.AttentionModule.keyWeights = {}
        AI.AttentionModule.valueWeights = {}
        AI.AttentionModule.outputWeights = {}
        
        for i = 1, totalDim do
            AI.AttentionModule.queryWeights[i] = {}
            AI.AttentionModule.keyWeights[i] = {}
            AI.AttentionModule.valueWeights[i] = {}
            AI.AttentionModule.outputWeights[i] = {}
            for j = 1, AI.LSTMOpponentModel.hiddenSize do
                AI.AttentionModule.queryWeights[i][j] = (math.random() * 2 - 1) * 0.1
                AI.AttentionModule.keyWeights[i][j] = (math.random() * 2 - 1) * 0.1
                AI.AttentionModule.valueWeights[i][j] = (math.random() * 2 - 1) * 0.1
            end
            for j = 1, totalDim do
                AI.AttentionModule.outputWeights[i][j] = (math.random() * 2 - 1) * 0.1
            end
        end
    end
    
    -- Initialize ensemble networks
    for i = 1, AI.DeepNetwork.ensembleSize do
        AI.DeepNetwork.ensembleNetworks[i] = {
            valueNet = { layer1 = { weights = {}, biases = {}, size = 24, activations = {}, gradients = {} }, layer2 = { weights = {}, biases = {}, size = 16, activations = {}, gradients = {} }, layer3 = { weights = {}, biases = {}, size = 1, activations = {}, gradients = {} } },
            advantageNet = { layer1 = { weights = {}, biases = {}, size = 24, activations = {}, gradients = {} }, layer2 = { weights = {}, biases = {}, size = 16, activations = {}, gradients = {} }, layer3 = { weights = {}, biases = {}, size = 7, activations = {}, gradients = {} } },
        }
        InitializeNetwork(AI.DeepNetwork.ensembleNetworks[i].valueNet, AI.DeepNetwork.inputSize)
        InitializeNetwork(AI.DeepNetwork.ensembleNetworks[i].advantageNet, AI.DeepNetwork.inputSize)
    end
    
    -- Initialize LSTM-like states
    for i = 1, AI.LSTMOpponentModel.hiddenSize do
        AI.LSTMOpponentModel.cellState[i] = 0
        AI.LSTMOpponentModel.hiddenState[i] = 0
    end
    
    -- Initialize state normalization
    if AI.StateNormalization.enabled then
        for i = 1, AI.DeepNetwork.inputSize do
            AI.StateNormalization.mean[i] = 0
            AI.StateNormalization.variance[i] = 1
        end
    end
    
    print("Deep Neural Networks initialized with Dueling DQN + Actor-Critic + ICM + Distributional RL + Attention architecture")
end

-- Copy network weights (for target network updates)
local function CopyNetwork(source, target)
    for layerName, layer in pairs(source) do
        if type(layer) == "table" and layer.weights then
            for i = 1, layer.size do
                for j = 1, #layer.weights[i] do
                    target[layerName].weights[i][j] = layer.weights[i][j]
                end
                target[layerName].biases[i] = layer.biases[i]
            end
        end
    end
end

