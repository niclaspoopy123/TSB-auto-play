--// ================= SERVICES ================= //
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LogService = game:GetService("LogService")
local HttpService = game:GetService("HttpService")

--// ================= LOCAL PLAYER ================= //
local player = Players.LocalPlayer

--// ================= LOCAL FILE PERSISTENCE ================= //
-- This module provides local file-based persistence using exploit file system functions
-- Replaces DataStore functionality for client-side exploit scripts
local LocalPersistence = {
    filename = "TSB_AutoPlay_Data_" .. tostring(math.floor(tonumber(player.UserId) or Players.LocalPlayer.UserId or 0)) .. ".json",
    lastSaveTime = 0,
    saveCooldown = 10, -- Minimum 10 seconds between saves to avoid spam
    fileSystemSupported = nil, -- Cached value
    
    -- Check if exploit supports file system functions (cached)
    isSupported = function(self)
        if self.fileSystemSupported ~= nil then
            return self.fileSystemSupported
        end
        -- Check if all required file system functions exist and are callable
        local hasWriteFile = writefile and typeof(writefile) == "function"
        local hasReadFile = readfile and typeof(readfile) == "function"
        local hasIsFile = isfile and typeof(isfile) == "function"
        self.fileSystemSupported = hasWriteFile and hasReadFile and hasIsFile
        return self.fileSystemSupported
    end,
    
    -- Save AI learning data to local file
    SaveData = function(self, aiTable)
        local now = os.time() -- Use os.time() for real elapsed time
        if now - self.lastSaveTime < self.saveCooldown then
            return false, "Save on cooldown"
        end
        
        if not self:isSupported() then
            return false, "File system not supported"
        end
        
        local success, result = pcall(function()
            -- Serialize data to save
            local dataToSave = {
                version = "1.0",
                timestamp = os.time(),
                totalTrials = aiTable.ActionStats.totalTrials,
                score = aiTable.Score,
                identifiedCharacter = aiTable.IdentifiedCharacter,
                
                -- Core learning data
                ActionStats = aiTable.ActionStats,
                QNetworkB = aiTable.QNetworkB,
                FeatureWeights = aiTable.FeatureWeights,
                
                -- Opponent modeling
                OpponentBehaviorModel = {
                    transitionTable = aiTable.OpponentBehaviorModel.transitionTable,
                    perOpponentData = aiTable.OpponentBehaviorModel.perOpponentData,
                },
                
                -- Character-specific models
                CharacterModels = {
                    characterWeights = aiTable.CharacterModels.characterWeights,
                    currentCharacter = aiTable.CharacterModels.currentCharacter,
                },
                
                -- Zone adaptation
                ZoneAdaptation = {
                    damageByDistance = aiTable.ZoneAdaptation.damageByDistance,
                    deathByDistance = aiTable.ZoneAdaptation.deathByDistance,
                    optimalZone = aiTable.ZoneAdaptation.optimalZone,
                },
                
                -- Meta-learning
                MetaLearning = {
                    adaptiveLearningRate = aiTable.MetaLearning.adaptiveLearningRate,
                    performanceTrend = aiTable.MetaLearning.performanceTrend,
                },
                
                -- Self-play statistics
                SelfPlayStats = aiTable.SelfPlaySystem.stats,
            }
            
            -- Encode to JSON with error handling
            local encodeSuccess, jsonData = pcall(function()
                return HttpService:JSONEncode(dataToSave)
            end)
            
            if not encodeSuccess then
                error("Failed to encode data to JSON: " .. tostring(jsonData))
            end
            
            -- Write to file
            writefile(self.filename, jsonData)
            
            self.lastSaveTime = now
            return true
        end)
        
        if success and result then
            print("💾 AI data saved to local file:", self.filename)
            return true, "Success"
        else
            warn("❌ Failed to save AI data:", tostring(result))
            return false, result
        end
    end,
    
    -- Load AI learning data from local file
    LoadData = function(self, aiTable)
        if not self:isSupported() then
            print("⚠️ File system not supported - AI will start fresh")
            return false, "File system not supported"
        end
        
        local success, result = pcall(function()
            -- Check if file exists
            if not isfile(self.filename) then
                print("ℹ️ No previous data found - AI will start fresh")
                return false
            end
            
            -- Read file
            local jsonData = readfile(self.filename)
            
            if not jsonData or jsonData == "" then
                warn("⚠️ Data file is empty - AI will start fresh")
                return false
            end
            
            -- Decode JSON with error handling
            local decodeSuccess, data = pcall(function()
                return HttpService:JSONDecode(jsonData)
            end)
            
            if not decodeSuccess then
                warn("❌ Failed to decode JSON (file may be corrupted):", tostring(data))
                warn("⚠️ AI will start fresh. You can delete the file to clear the error.")
                return false
            end
            
            -- Helper function to validate and fix action stats structure
            local function validateActionStats(stats, statType)
                if not stats then return false end
                local tactics = {"Aggressive", "Defensive", "BaitAndPunish", "Finisher", "ExploitSeeker"}
                local actions = {"ATTACK", "SPECIAL", "EVADE", "FEINT", "REPOSITION", "DASH", "BLOCK"}
                
                for _, tactic in ipairs(tactics) do
                    if not stats[tactic] then
                        warn(string.format("⚠️ Missing tactic %s in %s - creating default", tactic, statType))
                        stats[tactic] = {total = 0}
                        -- Actions will be added in the loop below
                    end
                    
                    -- Ensure total field exists
                    if stats[tactic].total == nil then
                        stats[tactic].total = 0
                    end
                    
                    for _, action in ipairs(actions) do
                        if not stats[tactic][action] then
                            stats[tactic][action] = {count = 0, value = 0, eligibility = 0}
                        else
                            -- Ensure all required fields exist
                            if stats[tactic][action].count == nil then
                                stats[tactic][action].count = 0
                            end
                            if stats[tactic][action].value == nil then
                                stats[tactic][action].value = 0
                                warn(string.format("⚠️ Fixed nil value for %s.%s.%s", statType, tactic, action))
                            end
                            if stats[tactic][action].eligibility == nil then
                                stats[tactic][action].eligibility = 0
                            end
                        end
                    end
                end
                return true
            end
            
            -- Restore data with validation
            if data.ActionStats then
                aiTable.ActionStats = data.ActionStats
                validateActionStats(aiTable.ActionStats, "ActionStats")
            end
            if data.QNetworkB then
                aiTable.QNetworkB = data.QNetworkB
                validateActionStats(aiTable.QNetworkB, "QNetworkB")
            end
            if data.FeatureWeights then
                aiTable.FeatureWeights = data.FeatureWeights
            end
            if data.OpponentBehaviorModel then
                aiTable.OpponentBehaviorModel.transitionTable = data.OpponentBehaviorModel.transitionTable or {}
                aiTable.OpponentBehaviorModel.perOpponentData = data.OpponentBehaviorModel.perOpponentData or {}
            end
            if data.CharacterModels then
                aiTable.CharacterModels.characterWeights = data.CharacterModels.characterWeights or {}
                aiTable.CharacterModels.currentCharacter = data.CharacterModels.currentCharacter or "Unknown"
            end
            if data.ZoneAdaptation then
                aiTable.ZoneAdaptation.damageByDistance = data.ZoneAdaptation.damageByDistance or {}
                aiTable.ZoneAdaptation.deathByDistance = data.ZoneAdaptation.deathByDistance or {}
                aiTable.ZoneAdaptation.optimalZone = data.ZoneAdaptation.optimalZone or 30
            end
            if data.MetaLearning then
                aiTable.MetaLearning.adaptiveLearningRate = data.MetaLearning.adaptiveLearningRate or 0.45
                aiTable.MetaLearning.performanceTrend = data.MetaLearning.performanceTrend or 0
            end
            if data.SelfPlayStats then
                aiTable.SelfPlaySystem.stats = data.SelfPlayStats
            end
            if data.score then
                aiTable.Score = data.score
            end
            if data.identifiedCharacter then
                aiTable.IdentifiedCharacter = data.identifiedCharacter
            end
            
            print("✅ AI data loaded from local file")
            print("📊 Restored " .. (data.totalTrials or 0) .. " training trials")
            print("🎯 Character: " .. (data.identifiedCharacter or "Unknown"))
            print("⚡ Score: " .. (data.score or 0))
            
            return true
        end)
        
        if success and result then
            return true, "Success"
        elseif success then
            return false, "No data file"
        else
            warn("Failed to load AI data:", result)
            return false, result
        end
    end,
}

--// ================= TRAINING MODE STATE ================= //
local TrainingMode = {
    enabled = false,
    trainingAgainstClone = false,
    cloneCharacter = nil,
    cloneAI = nil, -- AI brain for the clone
    cloneConnections = {}, -- Event connections for clone AI
}

--// ================= UTILITY FEATURES ================= //
local UtilityConfig = {
    -- Player Whitelist/Team Mode
    whitelistEnabled = false,
    whitelistedPlayers = {}, -- List of UserIds to never target
    friendsWhitelisted = true, -- Automatically whitelist friends
    
    -- Server Hopping
    serverHoppingEnabled = false,
    minPlayersBeforeHop = 2, -- Hop if server has less than this many players
    hopOnNegativeScore = true, -- Hop if score drops below threshold
    scoreThresholdForHop = -50, -- Hop if score is below this
    lastHopTime = 0,
    hopCooldown = 300, -- 5 minutes between hops
    
    -- Anti-AFK
    antiAFKEnabled = true,
    afkActionInterval = 60, -- Send input every 60 seconds
    lastAFKAction = 0,
}

-- Function to check if a player is whitelisted
local function IsPlayerWhitelisted(targetPlayer)
    if not UtilityConfig.whitelistEnabled then return false end
    
    -- Check explicit whitelist
    for _, userId in ipairs(UtilityConfig.whitelistedPlayers) do
        if targetPlayer.UserId == userId then
            return true
        end
    end
    
    -- Check if player is a friend
    if UtilityConfig.friendsWhitelisted and targetPlayer:IsFriendsWith(player.UserId) then
        return true
    end
    
    return false
end

-- Function to perform server hop
local function ServerHop()
    local now = os.clock()
    if now - UtilityConfig.lastHopTime < UtilityConfig.hopCooldown then
        print("Server hop on cooldown. Wait", math.ceil(UtilityConfig.hopCooldown - (now - UtilityConfig.lastHopTime)), "seconds")
        return
    end
    
    print("🔄 Attempting to hop to a new server...")
    UtilityConfig.lastHopTime = now
    
    -- Use TeleportService to find and join a different server
    local TeleportService = game:GetService("TeleportService")
    local success, errorMsg = pcall(function()
        -- Get current place ID
        local placeId = game.PlaceId
        -- Teleport to the same place (different server)
        TeleportService:Teleport(placeId, player)
    end)
    
    if not success then
        warn("Server hop failed:", errorMsg)
    end
end

-- Anti-AFK action
local function PerformAntiAFKAction()
    -- Send random movement input to prevent AFK kick
    local randomActions = {
        function() -- Jump
            if character and character:FindFirstChild("Humanoid") then
                character.Humanoid.Jump = true
            end
        end,
        function() -- Small movement
            if character and character:FindFirstChild("HumanoidRootPart") then
                local hrp = character.HumanoidRootPart
                local randomOffset = Vector3.new(
                    math.random(-5, 5),
                    0,
                    math.random(-5, 5)
                )
                character.Humanoid:MoveTo(hrp.Position + randomOffset)
            end
        end,
        function() -- Crouch (if available)
            -- Some games use C for crouch, this is a generic action
            if character then
                task.wait(0.1)
            end
        end
    }
    
    -- Execute a random anti-AFK action
    local action = randomActions[math.random(#randomActions)]
    pcall(action)
    
    UtilityConfig.lastAFKAction = os.clock()
    if CONST and CONST.DEBUG_MODE then
        print("Anti-AFK action performed")
    end
end

--// ================= ADVANCED COMBAT TECH MACROS ================= //
local CombatTech = {
    -- Configuration
    enabled = true,
    dashTechEnabled = true, -- Animation cancel with dash
    sideDashTechEnabled = true, -- Side dash for quick repositioning
    
    -- Dash Tech: Cancel end-lag of attacks with a dash
    -- Common in TSB for faster combo execution
    dashTech = function(currentAction)
        -- Safety check: CombatTech might be nil if called after character reset
        if not CombatTech or not CombatTech.dashTechEnabled then return false end
        
        -- Dash tech is useful after ATTACK or SPECIAL to cancel recovery frames
        if currentAction == "ATTACK" or currentAction == "SPECIAL" then
            if communicateEvent and math.random() < 0.3 then -- 30% chance to use tech
                -- Perform quick dash to cancel animation
                local techDir = math.random() > 0.5 and Enum.KeyCode.W or Enum.KeyCode.S
                communicateEvent:FireServer({["Dash"]=techDir, ["Key"]=Enum.KeyCode.Q, ["Goal"]="KeyPress"})
                
                if CONST and CONST.DEBUG_MODE then
                    print("🔧 DASH TECH used to cancel", currentAction)
                end
                return true
            end
        end
        return false
    end,
    
    -- Side Dash Tech: Quick lateral movement during combos
    sideDashTech = function()
        -- Safety check: CombatTech might be nil if called after character reset
        if not CombatTech or not CombatTech.sideDashTechEnabled then return false end
        
        -- Use side dash during active combat for unpredictability
        if AI.State and AI.State.comboCount > 1 and math.random() < 0.2 then -- 20% chance
            local sideDir = math.random() > 0.5 and Enum.KeyCode.A or Enum.KeyCode.D
            if communicateEvent then
                communicateEvent:FireServer({["Dash"]=sideDir, ["Key"]=Enum.KeyCode.Q, ["Goal"]="KeyPress"})
                
                if CONST and CONST.DEBUG_MODE then
                    print("🔧 SIDE DASH TECH used for repositioning")
                end
                return true
            end
        end
        return false
    end,
    
    -- Combo Extension: String together attacks with optimal timing
    -- This is called after successful hits to continue pressure
    comboExtension = function(lastAction, comboCount)
        -- Safety check: CombatTech might be nil if called after character reset
        if not CombatTech or not CombatTech.enabled then return nil end
        
        -- Suggest next action based on combo state
        if comboCount == 1 then
            return "ATTACK" -- Start with basic attack
        elseif comboCount == 2 then
            return math.random() > 0.5 and "DASH" or "ATTACK" -- Mix in dash
        elseif comboCount >= 3 then
            return "SPECIAL" -- Finish with special move
        end
        
        return nil
    end
}

